set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Biscuit File"
        echo "============"
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build biscuit-file packages (lib,cli)
build *args="":
    @echo ""
    @echo "Build {{BOLD}}biscuit-file{{RESET}} Packages"
    @echo "------------------------"
    @echo ""
    @cargo build -p biscuit-file -p biscuit-file-cli {{args}}

# run tests for biscuit-file packages
test *args="":
    @echo ""
    @echo "Testing {{BOLD}}biscuit-file{{RESET}} Packages"
    @echo "--------------------------"
    @echo ""
    @cargo test -p biscuit-file -p biscuit-file-cli {{args}}

# run clippy on biscuit-file packages
lint:
    @echo ""
    @echo "Linting {{BOLD}}biscuit-file{{RESET}} Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p biscuit-file -- -D warnings
    @cargo clippy -p biscuit-file-cli -- -D warnings

# install the biscuit-file CLI
install:
    @echo ""
    @echo "Installing biscuit-file CLI"
    @echo "--------------------------"
    @echo ""
    @echo "{{BOLD}}Building biscuit-file Library{{RESET}}"
    @cargo build -p biscuit-file --release
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing biscuit-file CLI{{RESET}}"
    @cargo install --path ./cli
    @echo ""

# check biscuit-file lib and CLI
check:
    @echo ""
    @echo "Checking {{BOLD}}biscuit-file{{RESET}}"
    @echo ""
    @cargo check -p biscuit-file -p biscuit-file-cli

# Open Claude Code in yolo mode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && echo "Loading {{BOLD}}Opencode{{RESET}}" && opencode {{args}}

# Open Opencode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})" && claude --dangerously-skip-permissions {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @cd .. && opencode run commit "-f" --model "openai/gpt-5.2"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}biscuit-file{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- biscuit-file {{DOCS}} {{args}}
    @_speak "the drift recipe for the biscuit-file package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."
