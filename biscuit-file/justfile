set dotenv-load
set positional-arguments

# set allow-duplicate-recipes

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/spec.just"
import "../just/devops.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""
PACKAGE := "Biscuit File"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "{{ PACKAGE }}"
        echo "============"
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{ args }}" --background >/dev/null 2>&1 || exit 0

# Build the library and CLI
build *args="":
    @just _build biscuit-file "biscuit-file Library" {{ args }}
    @just _build biscuit-file-cli "biscuit-file CLI" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "biscuit-file biscuit-file-cli"

# run tests for biscuit-file packages
test *args="":
    @just _test_all "biscuit-file biscuit-file-cli" {{args}}
    @just test-minimal {{args}}

# Proves the path→text boundary is genuinely unfeatured.
#
# `to_portable_string` / `try_portable_string` are documented as available
# without `file-reference` and its gix/cargo_metadata/walkdir/dirs/url stack, so
# a consumer can render a path without paying for a resolver. Nothing about the
# default-feature suite would notice that guarantee lapsing — the module would
# still compile and its tests would still pass — which is why this runs its own
# feature resolution rather than a filter over the run above. Plain `cargo test`
# on purpose: this invocation is fixed and must not inherit `test`'s nextest
# partitioning arguments.
#
# Skipped in archive mode. `--archive-file` means prebuilt binaries are being
# executed in the WSL2 guest, which deliberately installs neither Cargo nor
# rustc; a second feature resolution has to compile, so there is nothing for it
# to run there. The archive's own contents are the same either way — this gate
# is owned by the three native runners. The signal is `--archive-file` rather
# than "Cargo is missing" on purpose: the latter would also swallow a native
# runner whose toolchain failed to provision.
test-minimal *args="":
    #!/usr/bin/env bash
    set -euo pipefail

    # Matched as one quoted string rather than split into an array: a nextest
    # filterset reaches here with its parentheses already unquoted by `just`,
    # and word-splitting it would be a bash syntax error before the flag is
    # ever inspected.
    case " {{ args }} " in
        *" --archive-file "* | *" --archive-file="*)
            echo ""
            echo -e "Skipping the {{ ITALIC }}--no-default-features{{ RESET }} gate: archive mode has no Rust toolchain."
            exit 0
            ;;
    esac

    echo ""
    echo -e "Testing {{ BOLD }}biscuit-file{{ RESET }} with {{ ITALIC }}--no-default-features{{ RESET }}"
    echo "--------------------------"
    cargo test -p biscuit-file --no-default-features --lib path_text

# not applicable: biscuit-file has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for biscuit-file"

# not applicable: biscuit-file has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-file"

# not applicable: biscuit-file emits files, not HTML
test-browser:
    @echo "test-browser: not applicable for biscuit-file"

# not applicable: biscuit-file has no real-resource tier
test-real:
    @echo "test-real: not applicable for biscuit-file"

# run clippy on biscuit-file packages
lint:
    @echo ""
    @echo "Linting {{ BOLD }}biscuit-file{{ RESET }} Packages"
    @echo "--------------------------"
    @echo ""
    @just _lint biscuit-file
    @just _lint biscuit-file-cli

# Criterion benches for biscuit-file format parsers.
bench *args="":
    @just _bench biscuit-file {{ args }}

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage biscuit-file {{ args }}
    @just _coverage biscuit-file-cli {{ args }}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest biscuit-file {{ args }}
    @just _doctest biscuit-file-cli {{ args }}

# Fuzz targets for biscuit-file parsers and round-tripping.
fuzz *args="":
    @just _fuzz lib pdf_extract {{ args }}
    @just _fuzz lib toml_roundtrip {{ args }}
    @just _fuzz lib yaml_roundtrip {{ args }}
    @just _fuzz lib json5_roundtrip {{ args }}

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# install the biscuit-file CLI
install:
    @echo ""
    @echo "Installing biscuit-file CLI"
    @echo "--------------------------"
    @echo ""
    @echo "{{ BOLD }}Building biscuit-file Library{{ RESET }}"
    @cargo build -p biscuit-file --release
    @echo ""
    @echo "{{ BOLD }}{{ YELLOW }}Installing biscuit-file CLI{{ RESET }}"
    @cargo install --path ./cli
    @echo ""

# check biscuit-file lib and CLI
check:
    @echo ""
    @echo "Checking {{ BOLD }}biscuit-file{{ RESET }}"
    @echo ""
    @cargo check -p biscuit-file -p biscuit-file-cli

# Open Opencode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{ args }}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{ args }}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{ args }}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{ args }}
    @claudine codex {{ args }}

# commits all the staged changes using model from MODEL or COMMIT_MODEL in OpenCode
commit:
    @echo ""
    @echo -e "Committing staged changes in the {{ BOLD }}Rusty Biscuit{{ RESET }} monorepo to git"
    @echo -e "{{ DIM }}{{ ITALIC }}- using the {{ RESET }}{{ ITALIC }}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M3}} {{ DIM }}model{{ RESET }}"
    @echo ""
    @echo -e "{{ BOLD }}{{ BLUE }}Staged Files:{{ RESET }}"
    @sniff repo staged-files || ( echo "No Staged Files! Nothing to do ..." && exit 1 )
    @claudine compose --opencode "@prompts/commit.md" --op "commit" --quiet --model "${COMMIT_MODEL:-${MODEL:-minimax/MiniMax-M3}}"
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff repo git-status 2>/dev/null || exit 0
    @echo

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{ BOLD }}biscuit-file{{ RESET }} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- biscuit-file {{ DOCS }} {{ args }}
    @_speak "the drift recipe for the biscuit-file package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."

# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
