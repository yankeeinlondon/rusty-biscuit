+    /// A workspace with `dep` and, at `cli/`, a package named `name` whose
+    /// locked `dep` is `dep_version`.
+    fn renamed_cli_workspace(
+        name: &str,
+        dep_version: &str,
+    ) -> (crate::fs_utils::Utf8TempDir, Metadata) {
+        let directory = crate::fs_utils::Utf8TempDir::new().unwrap();
+        let manifest = directory.path().join("Cargo.toml");
+        fs_err::write(
+            &manifest,
+            "[workspace]\nmembers = [\"cli\", \"dep\"]\nresolver = \"2\"\n",
+        )
+        .unwrap();
+        write_package(&directory.path().join("cli"), name, "0.1.0", "");
+        write_package(&directory.path().join("dep"), "dep", dep_version, "");
+        fs_err::write(
+            directory.path().join("Cargo.lock"),
+            format!(
+                "version = 4\n[[package]]\nname = \"{name}\"\nversion = \"0.1.0\"\ndependencies = [\"dep\"]\n\
+                 [[package]]\nname = \"dep\"\nversion = \"{dep_version}\"\n"
+            ),
+        )
+        .unwrap();
+        let metadata = cargo_utils::get_manifest_metadata(&manifest).unwrap();
+        (directory, metadata)
+    }
+
