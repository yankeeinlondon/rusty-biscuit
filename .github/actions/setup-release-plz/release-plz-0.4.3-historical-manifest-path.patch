+    /// Write a workspace with `members` (path, name), commit it as `message`,
+    /// and return the workspace manifest.
+    fn commit_workspace(
+        repo: &git_cmd::Repo,
+        root: &Utf8Path,
+        members: &[(&str, &str)],
+        message: &str,
+    ) -> Utf8PathBuf {
+        let paths: Vec<&str> = members.iter().map(|(path, _)| *path).collect();
+        let manifest = root.join("Cargo.toml");
+        fs_err::write(
+            &manifest,
+            format!("[workspace]\nmembers = {paths:?}\nresolver = \"3\"\n"),
+        )
+        .unwrap();
+        for (path, name) in members {
+            write_package(&root.join(path), name, "0.1.0", "");
+        }
+        repo.add_all_and_commit(message).unwrap();
+        manifest
+    }
+
+    /// Mirror a repository whose packages were renamed after their release tags
+    /// were created: the tags carry the current names, but the tagged manifests
+    /// still declare the old ones.
+    fn renamed_after_release(root: &Utf8Path, renames: &[(&str, &str, &str)]) -> Utf8PathBuf {
+        let repo = git_cmd::Repo::init(root);
+        let old: Vec<(&str, &str)> = renames.iter().map(|(path, old, _)| (*path, *old)).collect();
+        commit_workspace(&repo, root, &old, "release under the old names");
+        for (path, _, new) in renames {
+            fs_err::remove_dir_all(root.join(path)).unwrap();
+            repo.tag(&format!("{new}-v0.1.0"), "initial release").unwrap();
+        }
+        let new: Vec<(&str, &str)> = renames.iter().map(|(path, _, new)| (*path, *new)).collect();
+        commit_workspace(&repo, root, &new, "rename packages")
+    }
+
