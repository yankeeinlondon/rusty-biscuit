+    /// The released member that is the same package as the local `package`.
+    ///
+    /// A renamed package keeps its release tags, which carry its current name
+    /// but point at a commit whose manifest still declares the old one. The
+    /// current name is matched first; when no released member has it, the
+    /// member whose manifest has the same path relative to the workspace root
+    /// is the package. When neither matches, the current-name lookup error is
+    /// returned: the package is never treated as an initial release.
+    pub(crate) fn package_for(
+        &self,
+        local_workspace_root: &Utf8Path,
+        package: &Package,
+    ) -> anyhow::Result<&Package> {
+        let by_name = cargo_utils::workspace_package(&self.metadata, &package.name);
+        if by_name.is_ok() {
+            return by_name;
+        }
+        let Ok(relative_manifest) = package.manifest_path.strip_prefix(local_workspace_root)
+        else {
+            return by_name;
+        };
+        let by_path = self.metadata.workspace_packages().into_iter().find(|released| {
+            released
+                .manifest_path
+                .strip_prefix(&self.metadata.workspace_root)
+                .is_ok_and(|released_manifest| released_manifest == relative_manifest)
+        });
+        match by_path {
+            Some(released) => {
+                info!(
+                    "package {} was released as {} at commit {} ({relative_manifest})",
+                    package.name, released.name, self.commit
+                );
+                Ok(released)
+            }
+            None => by_name,
+        }
+    }
 }
 
