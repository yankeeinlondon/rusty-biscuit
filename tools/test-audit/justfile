set dotenv-load
set positional-arguments

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
RESET := '\033[0m'
ROOT := justfile_directory() + "/../.."

default:
    @echo
    @echo -e "{{ BOLD }}test-audit{{ RESET }} (shared test-suite audit tooling)"
    @echo "======================================================================================"
    @echo
    @just --list | grep -v 'default'
    @echo

# Install pinned Node dependencies through the root pnpm workspace lockfile.
install:
    pnpm --dir "{{ ROOT }}" install --frozen-lockfile

# Type-check the tool (tsc --noEmit).
typecheck:
    pnpm --dir "{{ justfile_directory() }}" typecheck

# Run the tool's own vitest suite.
test *args="":
    pnpm --dir "{{ justfile_directory() }}" exec vitest run {{ args }}

# typecheck → test; what CI's ci-tooling leg runs for this directory.
check: typecheck test

# Run a test-audit command, e.g. `just run junit <dir> --config <cfg>`.
run *args="":
    pnpm --dir "{{ justfile_directory() }}" exec tsx src/cli.ts {{ args }}

# Validate an area configuration file.
validate config:
    @just run config validate --config "{{ config }}"
