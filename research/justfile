set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

PACKAGE := "Research"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @echo -e "Building {{LIB_NAME}}"
    @echo
    @cargo build -p {{LIBRARY}} {{args}} || ( just _speak "The {{LIB_NAME}} build failed!" && echo -e "\n❌ The {{LIB_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{LIB_NAME}}{{RESET}} built successfully"
    @echo
    @echo -e "Building {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{CLI}} {{args}} || ( just _speak "The {{CLI_NAME}} build failed!" && echo -e "\n❌ The {{CLI_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{CLI_NAME}}{{RESET}} built successfully"
    @echo

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "research research-cli"

# Test both library and CLI
test *args="":
    @just _test_all "research research-cli" {{args}}

# not applicable: research has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for research"

# not applicable: research has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for research"

# not applicable: research emits markdown/skill artifacts, not HTML
test-browser:
    @echo "test-browser: not applicable for research"

# Real-resource tests (live provider/LLM lookups). Skip-clean when credentials absent.
test-real *args="":
    @just _test_real research {{args}}
    @just _test_real research-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint research
    @just _lint research-cli

# not applicable: no criterion benches (work is provider-bound I/O)
bench:
    @echo "bench: not applicable for research"

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage research {{args}}
    @just _coverage research-cli {{args}}

# Doctests.
doctest *args="":
    @just _doctest research {{args}}
    @just _doctest research-cli {{args}}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for research"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint research || just _fix_lint research
    @just _lint research-cli || just _fix_lint research-cli

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{LIBRARY}}*:"

# Show all README.md files in the package
readme:
    _readme_files research


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
