set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

default:
    @echo
    @echo "Research"
    @echo "------------------------------------"
    @echo ""
    @just --list | grep -v 'default'
    @echo

# build research modules (cli, lib)
build *args="":
    @echo ""
    @echo "Build Research Modules (CLI, LIB)"
    @echo "---------------------------------"
    @echo ""
    @cargo build -p research-cli -p research {{args}}

# run tests across research modules
test *args="":
    @echo ""
    @echo "Testing Research Modules"
    @echo "------------------------"
    @echo ""
    @cargo test -p research-cli -p research {{args}}

# install the `research` binary into the executable path
install:
    @echo
    @echo "{{BOLD}}Building Research Library{{RESET}}"
    @echo ""
    @cargo build --release -p research-cli || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo "{{BOLD}}{{YELLOW}}Installing Research CLI{{RESET}}"
    @echo ""
    @cargo install --path ./cli --locked  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Installed Research CLI{{RESET}}"
    @playa effect drop-4 2>/dev/null || return 0

# run the debug release of the Research CLI
cli *args="":
    @cargo run -p research-cli -- {{args}}

# run clippy on research packages
lint:
    @echo ""
    @echo "Linting research Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p research -- -D warnings
    @cargo clippy -p research-cli -- -D warnings

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# Open Claude Code in yolo mode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && echo "Loading {{BOLD}}Opencode{{RESET}}" && opencode {{args}}

# Open Opencode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})" && claude --dangerously-skip-permissions {{args}}

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
