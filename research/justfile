set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

PACKAGE := "Research"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @echo -e "Building {{LIB_NAME}}"
    @echo
    @cargo build -p {{LIBRARY}} {{args}} || ( just _speak "The {{LIB_NAME}} build failed!" && echo -e "\n❌ The {{LIB_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{LIB_NAME}}{{RESET}} built successfully"
    @echo
    @echo -e "Building {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{CLI}} {{args}} || ( just _speak "The {{CLI_NAME}} build failed!" && echo -e "\n❌ The {{CLI_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{CLI_NAME}}{{RESET}} built successfully"
    @echo

# Test both library and CLI
test:
   @just _test research
   @just _test research-cli

# Lint both the library and CLI
lint:
    _lint research
    _lint research-cli

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint research || just _fix_lint research
    @just _lint research-cli || just _fix_lint research-cli

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{LIBRARY}}*:"

# Show all README.md files in the package
readme:
    _readme_files research


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
