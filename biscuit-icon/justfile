set dotenv-load
set positional-arguments
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/spec.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'

default:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v md &> /dev/null; then
        md just.md
    fi
    echo "biscuit-icon Library & CLI"
    echo "=========================="
    echo
    just --list | grep -v 'default'

build *args="":
    @just _build biscuit-icon "Biscuit Icon Library" {{ args }}
    @just _build biscuit-icon-cli "Biscuit Icon CLI" {{ args }}

# `--features image` throughout: both crates declare `default = []`, and the
# feature gates 2 tests in each. `install` and `cli` below already pass it
# unconditionally ("Always include it"), and `test-l2` does too — so the
# no-feature build is a configuration this area never ships, and only the L1
# tier was still measuring it.
sanity:
    @just _sanity_all "biscuit-icon --features image; biscuit-icon-cli --features image"

test *args="":
    @just _test_all "biscuit-icon --features image; biscuit-icon-cli --features image" {{ args }}

test-l2 *args="":
    @just _test_l2 biscuit-icon-cli --features image,terminal-tests {{ args }}

test-l3:
    @echo "test-l3: not applicable for biscuit-icon"

test-browser:
    @echo "test-browser: not applicable for biscuit-icon"

test-real:
    @echo "test-real: not applicable for biscuit-icon"

lint:
    @just _lint biscuit-icon
    @just _lint biscuit-icon-cli

coverage *args="":
    @just _coverage biscuit-icon --features image {{ args }}
    @just _coverage biscuit-icon-cli --features image {{ args }}

doctest *args="":
    @just _doctest biscuit-icon --features image {{ args }}
    @just _doctest biscuit-icon-cli --features image {{ args }}

bench *args="":
    @just _bench biscuit-icon {{ args }}
    @just _bench biscuit-icon-cli {{ args }}

fuzz:
    @echo "fuzz: not applicable for biscuit-icon"

all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

lint-fix:
    @just _lint biscuit-icon || just _fix_lint biscuit-icon
    @just _lint biscuit-icon-cli || just _fix_lint biscuit-icon-cli

install *args="":
    @just build --release
    # `--features image` enables inline-image rendering (Kitty/iTerm2/etc.).
    # Without it, glyph-less icons degrade to a text identifier in any cell
    # that does not have a Unicode/Nerd Font glyph — even in terminals like
    # WezTerm that fully support the image protocol. Always include it.
    # Inlined (rather than delegating to `_install`) because that helper
    # treats the third positional as `binary` and would steal `--features`.
    @echo -e "Installing \033[33m\033[1mBiscuit Icon\033[0m"
    @cargo install --path ./cli --features image {{ args }} || (just _play error-2 && just _speak "Problems encountered when trying to install Biscuit Icon" && exit 1)
    @echo -e "✅ \033[1m\033[32mBiscuit Icon installed!\033[0m"
    @just _play drop-4 || exit 0

docs:
    @cargo doc -p biscuit-icon --open

cli *args="":
    # `--features image` enables inline-image rendering. See `install`.
    @cargo run -p biscuit-icon-cli --features image -- {{ args }}

# Dev-only: fetch curated icon bodies from the Iconify API into assets + generated.rs.
populate-assets *args="":
    @cargo run -p biscuit-icon --bin populate_assets -- {{ args }}

_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ RED }} {{ DIM }} >/dev/null || true
