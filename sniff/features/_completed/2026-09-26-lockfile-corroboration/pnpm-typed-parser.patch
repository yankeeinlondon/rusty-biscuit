+    /// A v9-shaped lockfile whose `importers` precede `packages` and
+    /// `snapshots`, so the typed parse must skip real trailing sections.
+    fn pnpm_lock_with_importers(importers: &[&str]) -> String {
+        let mut lock = String::from("lockfileVersion: '9.0'\n\nimporters:\n");
+        for importer in importers {
+            lock.push_str(&format!(
+                "  {importer}:\n    dependencies:\n      left-pad:\n        specifier: ^1.3.0\n        version: 1.3.0\n"
+            ));
+        }
+        lock.push_str(
+            "\npackages:\n  left-pad@1.3.0:\n    resolution: {integrity: sha512-abc}\n\n\
+             snapshots:\n  left-pad@1.3.0: {}\n",
+        );
+        lock
     }
 
+    fn assert_pnpm_parity(content: &str) -> Option<Vec<String>> {
+        let typed = pnpm_importer_keys(content);
+        assert_eq!(
+            typed,
+            pnpm_importer_keys_reference(content),
+            "typed and reference importer keys differ for {content:?}"
+        );
+        typed
+    }
+
     #[test]
+    fn pnpm_importer_keys_match_reference_for_matching_extra_and_missing_importers() {
+        let cases: [(&str, &[&str]); 3] = [
+            ("matching", &[".", "packages/web", "packages/ui"]),
+            ("extra", &[".", "packages/web", "packages/ui", "packages/stale"]),
+            ("missing", &[".", "packages/web"]),
+        ];
+        for (label, importers) in cases {
+            let keys = assert_pnpm_parity(&pnpm_lock_with_importers(importers));
+            let expected: Vec<String> = importers.iter().map(|k| k.to_string()).collect();
+            assert_eq!(keys, Some(expected), "{label}");
+        }
+    }
+
+    #[test]
+    fn pnpm_importer_keys_match_reference_for_malformed_lockfiles() {
+        let absent = [
+            ("invalid YAML", "importers:\n  .: {\n"),
+            ("invalid YAML after importers", "importers:\n  .: {}\npackages: [\n"),
+            ("empty document", ""),
+            ("scalar document", "just a string\n"),
+            ("sequence document", "- importers\n"),
+            ("no importers key", "lockfileVersion: '9.0'\npackages: {}\n"),
+            ("null importers", "importers:\n"),
+            ("scalar importers", "importers: 3\n"),
+            ("string importers", "importers: packages/web\n"),
+            ("sequence importers", "importers:\n  - packages/web\n"),
+            ("duplicate importer key", "importers:\n  a: {}\n  a: {}\n"),
+            ("duplicate non-string importer key", "importers:\n  1: {}\n  1: {}\n"),
+            ("duplicate importers key", "importers: {}\nimporters: {}\n"),
+        ];
+        for (label, content) in absent {
+            assert_eq!(assert_pnpm_parity(content), None, "{label}");
+        }
+
+        let present = [
+            ("empty importers", "importers: {}\n", vec![]),
+            (
+                "non-string keys are dropped",
+                "importers:\n  1: {}\n  true: {}\n  ~: {}\n  packages/web: {}\n",
+                vec!["packages/web".to_string()],
+            ),
+            (
+                "scalar importer bodies",
+                "importers:\n  .: 7\n  packages/web: ~\n",
+                vec![".".to_string(), "packages/web".to_string()],
+            ),
+        ];
+        for (label, content, expected) in present {
+            assert_eq!(assert_pnpm_parity(content), Some(expected), "{label}");
+        }
+    }
+
