+
+/// The string keys of a `pnpm-lock.yaml` document's top-level `importers`
+/// mapping, in document order; non-string keys are dropped.
+///
+/// Only the key set is retained: importer bodies and the `packages:` and
+/// `snapshots:` sections are skipped through `IgnoredAny`, so no YAML value
+/// tree is built for them. The whole document is still scanned, so invalid
+/// YAML anywhere yields `None`. One divergence from the generic `Value` parse
+/// it replaced: a duplicate key outside the `importers` keys (for example
+/// inside `packages:`) is not detected, where the generic parse rejected the
+/// document. pnpm does not write such a lockfile.
+///
+/// ## Returns
+///
+/// `None` when the content is not valid YAML, is not a mapping, or has no
+/// `importers` mapping.
+fn pnpm_importer_keys(content: &str) -> Option<Vec<String>> {
+    serde_yaml_ng::from_str::<PnpmLockDocument>(content)
+        .ok()?
+        .importers
+}
+
+/// The part of a `pnpm-lock.yaml` document that [`pnpm_importer_keys`] reads.
+#[derive(serde::Deserialize)]
+struct PnpmLockDocument {
+    #[serde(default, deserialize_with = "importer_keys_or_none")]
+    importers: Option<Vec<String>>,
+}
+
+/// Deserialize a mapping's string keys, or `None` for any non-mapping value.
+fn importer_keys_or_none<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Option<Vec<String>>, D::Error> {
+    use serde::de::{Error, IgnoredAny, MapAccess, SeqAccess, Visitor};
+
+    struct ImporterKeys;
+
+    impl<'de> Visitor<'de> for ImporterKeys {
+        type Value = Option<Vec<String>>;
+
+        fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
+            formatter.write_str("any YAML value")
+        }
+
+        fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> std::result::Result<Self::Value, A::Error> {
+            let mut keys = Vec::new();
+            let mut seen = HashSet::new();
+            // Keys go through `Value` so a non-string key is dropped rather than
+            // rejected, as the generic `as_str` filter did, and a duplicate key
+            // fails the document as the generic mapping did.
+            while let Some(key) = map.next_key::<serde_yaml_ng::Value>()? {
+                map.next_value::<IgnoredAny>()?;
+                if !seen.insert(key.clone()) {
+                    return Err(A::Error::custom("duplicate importer key"));
+                }
+                if let serde_yaml_ng::Value::String(key) = key {
+                    keys.push(key);
+                }
+            }
+            Ok(Some(keys))
+        }
+
+        fn visit_seq<A: SeqAccess<'de>>(self, seq: A) -> std::result::Result<Self::Value, A::Error> {
+            IgnoredAny.visit_seq(seq)?;
+            Ok(None)
+        }
+
+        fn visit_unit<E: Error>(self) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+
+        fn visit_bool<E: Error>(self, _: bool) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+
+        fn visit_i64<E: Error>(self, _: i64) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+
+        fn visit_u64<E: Error>(self, _: u64) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+
+        fn visit_f64<E: Error>(self, _: f64) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+
+        fn visit_str<E: Error>(self, _: &str) -> std::result::Result<Self::Value, E> {
+            Ok(None)
+        }
+    }
+
+    deserializer.deserialize_any(ImporterKeys)
+}
