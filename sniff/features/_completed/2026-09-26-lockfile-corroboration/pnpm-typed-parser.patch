+/// The generic `serde_yaml_ng::Value` path that [`pnpm_importer_keys`]
+/// replaced, kept as the parity oracle.
+#[cfg(test)]
+fn pnpm_importer_keys_reference(content: &str) -> Option<Vec<String>> {
+    let parsed: serde_yaml_ng::Value = serde_yaml_ng::from_str(content).ok()?;
+    let importers = parsed.get("importers")?.as_mapping()?;
+    Some(
+        importers
+            .keys()
+            .filter_map(|k| k.as_str())
+            .map(str::to_string)
+            .collect(),
+    )
 }
 
