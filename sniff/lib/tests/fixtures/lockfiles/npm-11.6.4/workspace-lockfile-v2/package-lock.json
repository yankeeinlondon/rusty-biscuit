{
  "name": "fixture-root",
  "version": "0.0.0",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-root",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        ".tools/hidden"
      ],
      "dependencies": {
        "local-lib": "file:./local-lib"
      }
    },
    ".tools/hidden": {
      "name": "hidden-tool",
      "version": "0.0.0"
    },
    "local-lib": {
      "version": "0.0.0"
    },
    "node_modules/@fixture/beta": {
      "resolved": "packages/beta",
      "link": true
    },
    "node_modules/alpha": {
      "resolved": "packages/alpha",
      "link": true
    },
    "node_modules/hidden-tool": {
      "resolved": ".tools/hidden",
      "link": true
    },
    "node_modules/local-lib": {
      "resolved": "local-lib",
      "link": true
    },
    "packages/alpha": {
      "version": "0.0.0",
      "dependencies": {
        "@fixture/beta": "0.0.0"
      }
    },
    "packages/beta": {
      "name": "@fixture/beta",
      "version": "0.0.0"
    }
  },
  "dependencies": {
    "@fixture/beta": {
      "version": "file:packages/beta"
    },
    "alpha": {
      "version": "file:packages/alpha",
      "requires": {
        "@fixture/beta": "0.0.0"
      }
    },
    "hidden-tool": {
      "version": "file:.tools/hidden"
    },
    "local-lib": {
      "version": "file:local-lib"
    }
  }
}
