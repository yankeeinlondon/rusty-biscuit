set dotenv-load
set positional-arguments

BOLD := '\033[1m'
RESET := '\033[0m'

default:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v md &> /dev/null; then
        md just.md
    else
        @echo "{{BOLD}}Sniff CLI and Library{{RESET}}"
        echo "=================================="
    fi
    echo
    just --list | grep -v 'default'

# build library and CLI
build *args="":
    @echo "Building ..."
    @echo
    @cargo build -p sniff {{args}}
    @cargo build -p sniff-cli {{args}}
    @echo

# test library and CLI
test *args="":
    @echo "Testing {{BOLD}}Library{{RESET}} code"
    @echo ""
    @cargo test -p sniff -- {{args}}
    @echo ""
    @echo "Testing {{BOLD}}CLI{{RESET}} code"
    @echo ""
    @cargo test -p sniff-cli -- {{args}}

# lint with clippy
lint *args="":
    @cargo clippy -p sniff -p sniff-cli -- {{args}}

# install latest release version of CLI
install *args="":
    @echo ""
    @echo "{{BOLD}}Building Sniff Library{{RESET}}"
    @cargo build --release -p sniff  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Sniff CLI{{RESET}}"
    @cargo build --release -p sniff-cli  || ( playa effect error-2 2>/dev/null && exit 1 )
    @cargo install --path cli -- {{args}}  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Sniff CLI Installed{{RESET}}"
    @echo ""
    @playa effect drop-4 2>/dev/null || return 0

# build and show the docs for the library code
docs:
    @echo "Building and then showing latest docs for the library code"
    @echo ""
    @cargo doc -p sniff --open

# build and show the docs for the Sniff CLI
docs_cli:
    @echo "Building and then showing latest docs for the Sniff CLI"
    @echo ""
    @cargo doc -p sniff --open

# Open Opencode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && opencode {{args}}

# Open Claude Code in yolo mode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# fix documentation drift and update the skill
drift *args="":
    @echo
    @echo "Refreshing {{BOLD}}sniff{{RESET}} skill via Rust drift script"
    @echo
    @echo "- set PREFER_AGENT=codex to force codex (default is claude)"
    @echo "- extra document paths can still be passed as drift args"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- sniff {{args}}

