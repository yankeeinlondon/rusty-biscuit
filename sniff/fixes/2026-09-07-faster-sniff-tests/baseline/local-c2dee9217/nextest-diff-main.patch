-# Tests that intentionally wait on a real clock (e.g. rate-limit pause policies)
-# need an even longer leash than the default termination window.
+# The rate-limit pause policy is a real wall-clock wait: the test asserts that a
+# `429`-shaped provider response pauses for the advertised interval and then
+# *continues*, so the elapsed time is the contract rather than overhead. It sits
+# just under the default 5s slow mark (4.34s measured on a 16-core Mac,
+# 2026-09-08), which is close enough that ordinary contention would otherwise
+# mark a healthy run slow and a loaded runner could reach the 30s kill.
 [[profile.default.overrides]]
 filter = 'test(=compose_loop_rate_limit_pause_waits_then_continues)'
 slow-timeout = { period = "30s", terminate-after = 3 }
 
