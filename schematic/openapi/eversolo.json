  "components": {
    "schemas": {
      "StatusResponse": {
        "title": "StatusResponse",
        "description": "Generic status response returned by most endpoints.\n\nA `status` of 200 indicates success.",
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "status"
        ]
      },
      "GetModelResponse": {
        "title": "GetModelResponse",
        "description": "Response from the `getModel` endpoint with device identity information.",
        "type": "object",
        "properties": {
          "ableRemoteBoot": {
            "description": "Whether the device supports remote boot/wake behavior.\n\nThis field may be absent on firmware versions that do not expose it.",
            "type": "boolean"
          },
          "androidVersion": {
            "description": "Android base version reported by firmware.\n\nThis field may be absent on older firmware builds. The API uses\nall-lowercase `androidversion` rather than camelCase.",
            "type": "string"
          },
          "firmware": {
            "type": "string"
          },
          "hasEqSetting": {
            "description": "Whether EQ settings are available on this hardware/firmware combination.\n\nThis field may be absent on models or firmware without EQ support metadata.",
            "type": "boolean"
          },
          "ip": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "net_mac": {
            "description": "Wired MAC address.\n\nThe API uses snake_case `net_mac` rather than camelCase for this field.",
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "wif_mac": {
            "description": "Wi-Fi MAC address.\n\nThe API uses `wif_mac` (missing the 'i' — a known Zidoo-lineage typo).",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model",
          "ip",
          "net_mac",
          "wif_mac",
          "firmware"
        ]
      },
      "GetStateResponse": {
        "title": "GetStateResponse",
        "description": "Current playback state from `getState`.\n\n## Notes\n\nThe payload includes owned `String` fields under `playing_music`. Polling this\nendpoint at high frequency can create steady allocation churn in UI loops.",
        "type": "object",
        "properties": {
          "duration": {
            "description": "Total duration in milliseconds.",
            "type": "integer",
            "format": "int64"
          },
          "playingMusic": {},
          "position": {
            "description": "Current position in milliseconds.",
            "type": "integer",
            "format": "int64"
          },
          "state": {
            "description": "Playback state enum value.\n\nCommon values observed in Zidoo-derived firmware:\n- `0` = stopped\n- `1` = playing\n- `2` = paused\n\nAdditional values may appear on newer firmware revisions.",
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "description": "Status code (200 = success). Absent from some firmware versions.",
            "type": "integer",
            "format": "int32"
          },
          "volumeData": {}
        },
        "required": [
          "state"
        ]
      },
      "InputOutputListResponse": {
        "title": "InputOutputListResponse",
        "description": "Input and output device listing.",
        "type": "object",
        "properties": {
          "inputData": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/InputItem"
                }
              ]
            }
          },
          "inputIndex": {
            "description": "Index into `input_data` of the currently selected input source.",
            "type": "integer",
            "format": "int32"
          },
          "outputData": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/OutputItem"
                }
              ]
            }
          },
          "outputIndex": {
            "description": "Index into `output_data` of the currently selected output port.",
            "type": "integer",
            "format": "int32"
          },
          "outputInfo": {
            "description": "Unstructured output info that varies by model/output type."
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "status",
          "inputData",
          "outputData"
        ]
      },
      "PowerOptionsResponse": {
        "title": "PowerOptionsResponse",
        "description": "Available power options.",
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PowerOption"
                }
              ]
            }
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "status",
          "data"
        ]
      },
      "BrightnessResponse": {
        "title": "BrightnessResponse",
        "description": "Brightness level response.",
        "type": "object",
        "properties": {
          "currentValue": {
            "description": "Current brightness level, typically in the range `0..=max`.\n\nThe API returns this as `currentValue`.",
            "type": "integer",
            "format": "int32"
          },
          "max": {
            "description": "Maximum brightness.",
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "description": "Status code (200 = success). May be absent on some firmware versions.",
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "currentValue"
        ]
      },
      "DisplayModeListResponse": {
        "title": "DisplayModeListResponse",
        "description": "List of available display modes (VU or spectrum).",
        "type": "object",
        "properties": {
          "currentIndex": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/DisplayMode"
                }
              ]
            }
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "status",
          "data"
        ]
      }
    }
  },
