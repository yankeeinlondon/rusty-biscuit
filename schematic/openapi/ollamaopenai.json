{
  "openapi": "3.0.3",
  "info": {
    "title": "OllamaOpenAI",
    "description": "Ollama OpenAI-compatible REST API for drop-in replacement of OpenAI clients",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:11434",
      "description": "OllamaOpenAI API Server"
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Create chat completion (SSE streaming when stream=true)",
        "description": "Create chat completion (SSE streaming when stream=true)",
        "operationId": "ChatCompletions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAIChatCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful binary response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "x-schematic": {
          "request": {
            "Json": {
              "module_path": null,
              "type_name": "OpenAIChatCompletionRequest"
            }
          },
          "response": "Binary"
        }
      }
    },
    "/v1/completions": {
      "post": {
        "summary": "Create text completion (SSE streaming when stream=true)",
        "description": "Create text completion (SSE streaming when stream=true)",
        "operationId": "Completions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAICompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful binary response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "x-schematic": {
          "request": {
            "Json": {
              "module_path": null,
              "type_name": "OpenAICompletionRequest"
            }
          },
          "response": "Binary"
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "summary": "Generate embeddings for text",
        "description": "Generate embeddings for text",
        "operationId": "Embeddings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAIEmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIEmbeddingResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "request": {
            "Json": {
              "module_path": null,
              "type_name": "OpenAIEmbeddingRequest"
            }
          },
          "response": {
            "Json": {
              "module_path": null,
              "type_name": "OpenAIEmbeddingResponse"
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List available models in OpenAI format",
        "description": "List available models in OpenAI format",
        "operationId": "ListModels",
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIListModelsResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "module_path": null,
              "type_name": "OpenAIListModelsResponse"
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmbeddingsResponse": {
        "title": "EmbeddingsResponse",
        "description": "Response from the `/api/embeddings` endpoint.",
        "type": "object",
        "properties": {
          "embedding": {
            "description": "The embedding vector.",
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "required": [
          "embedding"
        ]
      },
      "ListModelsResponse": {
        "title": "ListModelsResponse",
        "description": "Response from the `/api/tags` endpoint.",
        "type": "object",
        "properties": {
          "models": {
            "description": "List of available models.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              ]
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "ModelInfo": {
        "title": "ModelInfo",
        "description": "A model in the list response.",
        "type": "object",
        "properties": {
          "details": {
            "description": "Detailed model information."
          },
          "digest": {
            "description": "Model digest (truncated SHA256).",
            "type": "string"
          },
          "modified_at": {
            "description": "Model modification time.",
            "type": "string"
          },
          "name": {
            "description": "Model name with tag (e.g., \"llama3:latest\").",
            "type": "string"
          },
          "size": {
            "description": "Model size in bytes.",
            "type": "integer",
            "format": "uint64"
          }
        },
        "required": [
          "name"
        ]
      },
      "ModelDetails": {
        "title": "ModelDetails",
        "description": "Model details in list response.",
        "type": "object",
        "properties": {
          "families": {
            "description": "Model families (e.g., [\"llama\"]).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "family": {
            "description": "Model family.",
            "type": "string"
          },
          "format": {
            "description": "Format of the model.",
            "type": "string"
          },
          "parameter_size": {
            "description": "Parameter size (e.g., \"8B\").",
            "type": "string"
          },
          "parent_model": {
            "description": "Parent model name.",
            "type": "string"
          },
          "quantization_level": {
            "description": "Quantization level (e.g., \"Q4_0\").",
            "type": "string"
          }
        }
      },
      "ShowModelResponse": {
        "title": "ShowModelResponse",
        "description": "Response from the `/api/show` endpoint.",
        "type": "object",
        "properties": {
          "capabilities": {
            "description": "Model capabilities (e.g., \"completion\", \"vision\", \"tools\", \"thinking\").",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details": {
            "description": "Model details."
          },
          "license": {
            "description": "License information.",
            "type": "string"
          },
          "model_info": {
            "description": "Model information."
          },
          "modelfile": {
            "description": "The Modelfile content.",
            "type": "string"
          },
          "parameters": {
            "description": "Model parameters.",
            "type": "string"
          },
          "system": {
            "description": "System prompt.",
            "type": "string"
          },
          "template": {
            "description": "Model template.",
            "type": "string"
          }
        }
      },
      "ListRunningModelsResponse": {
        "title": "ListRunningModelsResponse",
        "description": "Response from the `/api/ps` endpoint.",
        "type": "object",
        "properties": {
          "models": {
            "description": "List of currently running models.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/RunningModel"
                }
              ]
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "RunningModel": {
        "title": "RunningModel",
        "description": "A running model in the `/api/ps` response.",
        "type": "object",
        "properties": {
          "details": {
            "description": "Model details."
          },
          "digest": {
            "description": "Model digest.",
            "type": "string"
          },
          "expires_at": {
            "description": "When the model will be unloaded.",
            "type": "string"
          },
          "model": {
            "description": "Model identifier.",
            "type": "string"
          },
          "name": {
            "description": "Model name.",
            "type": "string"
          },
          "size": {
            "description": "Model size in VRAM.",
            "type": "integer",
            "format": "uint64"
          },
          "size_vram": {
            "description": "Size in VRAM in bytes.",
            "type": "integer",
            "format": "uint64"
          }
        },
        "required": [
          "name"
        ]
      },
      "OpenAIEmbeddingResponse": {
        "title": "OpenAIEmbeddingResponse",
        "description": "Response from the `/v1/embeddings` endpoint.",
        "type": "object",
        "properties": {
          "data": {
            "description": "List of embeddings.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/OpenAIEmbeddingData"
                }
              ]
            }
          },
          "model": {
            "description": "Model used for embeddings.",
            "type": "string"
          },
          "object": {
            "description": "Object type, always \"list\".",
            "type": "string"
          },
          "usage": {
            "description": "Token usage information."
          }
        },
        "required": [
          "object",
          "data",
          "model"
        ]
      },
      "OpenAIEmbeddingData": {
        "title": "OpenAIEmbeddingData",
        "description": "An embedding object in the response.",
        "type": "object",
        "properties": {
          "embedding": {
            "description": "The embedding vector.",
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "index": {
            "description": "Index of this embedding.",
            "type": "integer",
            "format": "uint32"
          },
          "object": {
            "description": "Object type, always \"embedding\".",
            "type": "string"
          }
        },
        "required": [
          "object",
          "index",
          "embedding"
        ]
      },
      "OpenAIUsage": {
        "title": "OpenAIUsage",
        "description": "Token usage information.",
        "type": "object",
        "properties": {
          "completion_tokens": {
            "description": "Tokens generated.",
            "type": "integer",
            "format": "uint32"
          },
          "prompt_tokens": {
            "description": "Tokens in the prompt.",
            "type": "integer",
            "format": "uint32"
          },
          "total_tokens": {
            "description": "Total tokens used.",
            "type": "integer",
            "format": "uint32"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ]
      },
      "OpenAIListModelsResponse": {
        "title": "OpenAIListModelsResponse",
        "description": "Response from the `/v1/models` endpoint.",
        "type": "object",
        "properties": {
          "data": {
            "description": "List of available models.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/OpenAIModel"
                }
              ]
            }
          },
          "object": {
            "description": "Object type, always \"list\".",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ]
      },
      "OpenAIModel": {
        "title": "OpenAIModel",
        "description": "A model in the OpenAI-compatible list.",
        "type": "object",
        "properties": {
          "created": {
            "description": "Unix timestamp of creation.",
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "description": "Model identifier.",
            "type": "string"
          },
          "object": {
            "description": "Object type, always \"model\".",
            "type": "string"
          },
          "owned_by": {
            "description": "Owner of the model (always \"library\" for Ollama).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ]
      }
    }
  },
  "externalDocs": {
    "description": "API Documentation",
    "url": "https://github.com/ollama/ollama/blob/main/docs/openai.md"
  },
  "x-schematic": {
    "env_mapping": {
      "api_key": null,
      "basic_pass": null,
      "basic_user": null,
      "bearer_token": null
    },
    "module_path": "ollama",
    "request_suffix": "OaiRequest"
  }
}