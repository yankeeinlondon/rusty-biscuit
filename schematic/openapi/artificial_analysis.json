    "/critpt/evaluate": {
      "post": {
        "summary": "Submit a batch of code-generation submissions for evaluation against the CritPt benchmark.",
        "description": "Submit a batch of code-generation submissions for evaluation against the CritPt benchmark.",
        "operationId": "EvaluateCritPt",
