  "paths": {
    "/data/llms/models": {
      "get": {
        "summary": "Returns primary metrics from independent LLM benchmarks: intelligence, speed, and pricing.",
        "description": "Returns primary metrics from independent LLM benchmarks: intelligence, speed, and pricing.",
        "operationId": "ListLlmModels",
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmModelsResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "module_path": null,
              "type_name": "LlmModelsResponse"
            }
          }
        }
      }
    },
