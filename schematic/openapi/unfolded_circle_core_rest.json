  "components": {
    "schemas": {
      "LoginRequest": {
        "title": "LoginRequest",
        "description": "Login request payload for `/pub/login`.",
        "type": "object",
        "properties": {
          "password": {
            "description": "User password.",
            "type": "string"
          },
          "username": {
            "description": "User account name.",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ApiResponseMessage": {
        "title": "ApiResponseMessage",
        "description": "Generic API response envelope used by many endpoints.",
        "type": "object",
        "properties": {
          "message": {
            "nullable": true,
            "description": "Human-readable message.",
            "type": "string"
          },
          "status": {
            "nullable": true,
            "description": "Response status text.",
            "type": "string"
          }
        }
      },
      "SystemInfo": {
        "title": "SystemInfo",
        "description": "System information returned by `/system`.",
        "type": "object",
        "properties": {
          "hw_revision": {
            "description": "Hardware revision identifier.",
            "type": "string"
          },
          "model_name": {
            "description": "Friendly name of the device model.",
            "type": "string"
          },
          "model_number": {
            "description": "Full model number (for example `ucr2`, `ucr3-##`).",
            "type": "string"
          },
          "serial_number": {
            "description": "Hardware serial number.",
            "type": "string"
          }
        },
        "required": [
          "model_name",
          "model_number",
          "serial_number",
          "hw_revision"
        ]
      },
      "BackupRestoreReportItem": {
        "title": "BackupRestoreReportItem",
        "description": "One backup-restore report row.",
        "type": "object",
        "properties": {
          "available": {
            "description": "Total available items in the backup.",
            "type": "integer",
            "format": "int32"
          },
          "item": {
            "description": "Restored object category.",
            "allOf": [
              {
                "$ref": "#/components/schemas/BackupRestoreItem"
              }
            ]
          },
          "ok": {
            "description": "Successfully restored items.",
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "item",
          "available",
          "ok"
        ]
      },
      "BackupRestoreItem": {
        "description": "Backup restore report item type.",
        "oneOf": [
          {
            "description": "Database records.",
            "type": "string",
            "enum": [
              "db"
            ]
          },
          {
            "description": "Integration driver records.",
            "type": "string",
            "enum": [
              "integration_driver"
            ]
          },
          {
            "description": "Integration records.",
            "type": "string",
            "enum": [
              "integration"
            ]
          },
          {
            "description": "Activity records.",
            "type": "string",
            "enum": [
              "activity"
            ]
          },
          {
            "description": "Macro records.",
            "type": "string",
            "enum": [
              "macro"
            ]
          },
          {
            "description": "Remote records.",
            "type": "string",
            "enum": [
              "remote"
            ]
          },
          {
            "description": "Profile records.",
            "type": "string",
            "enum": [
              "profile"
            ]
          },
          {
            "description": "Dock records.",
            "type": "string",
            "enum": [
              "dock"
            ]
          },
          {
            "description": "Resource records.",
            "type": "string",
            "enum": [
              "resource"
            ]
          }
        ]
      },
      "ResourceItem": {
        "title": "ResourceItem",
        "description": "Single uploaded/listed resource item.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Resource identifier.",
            "type": "string"
          },
          "size": {
            "nullable": true,
            "description": "Size in bytes.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "type": {
            "description": "Resource type.\n\nSerialized as `type` in API payloads.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ]
      },
      "IntegrationDriverInfo": {
        "title": "IntegrationDriverInfo",
        "description": "Installed custom integration summary.",
        "type": "object",
        "properties": {
          "developer_name": {
            "nullable": true,
            "description": "Optional developer name.",
            "type": "string"
          },
          "driver_id": {
            "description": "Driver identifier.",
            "type": "string"
          },
          "driver_state": {
            "description": "Optional runtime state.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/DriverState"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "driver_type": {
            "description": "Driver origin/type.",
            "allOf": [
              {
                "$ref": "#/components/schemas/IntegrationDriverType"
              }
            ]
          },
          "driver_url": {
            "nullable": true,
            "description": "Optional external driver URL.",
            "type": "string"
          },
          "enabled": {
            "description": "Whether the driver is enabled.",
            "type": "boolean"
          },
          "icon": {
            "nullable": true,
            "description": "Optional icon identifier.",
            "type": "string"
          },
          "name": {
            "description": "Localized driver display name.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "version": {
            "description": "Driver version.",
            "type": "string"
          }
        },
        "required": [
          "driver_id",
          "name",
          "driver_type",
          "version",
          "enabled"
        ]
      },
      "DriverState": {
        "description": "Integration driver runtime state.",
        "oneOf": [
          {
            "description": "Driver exists but requires configuration before activation.",
            "type": "string",
            "enum": [
              "NOT_CONFIGURED"
            ]
          },
          {
            "description": "Driver is idle.",
            "type": "string",
            "enum": [
              "IDLE"
            ]
          },
          {
            "description": "Driver is currently connecting.",
            "type": "string",
            "enum": [
              "CONNECTING"
            ]
          },
          {
            "description": "Driver is connected and active.",
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          {
            "description": "Driver is attempting to reconnect.",
            "type": "string",
            "enum": [
              "RECONNECTING"
            ]
          },
          {
            "description": "Driver is in an error state.",
            "type": "string",
            "enum": [
              "ERROR"
            ]
          }
        ]
      },
      "IntegrationDriverType": {
        "description": "Integration driver type.",
        "oneOf": [
          {
            "description": "Firmware built-in integration driver.",
            "type": "string",
            "enum": [
              "LOCAL"
            ]
          },
          {
            "description": "User-installed integration driver package.",
            "type": "string",
            "enum": [
              "CUSTOM"
            ]
          },
          {
            "description": "External network-hosted integration driver.",
            "type": "string",
            "enum": [
              "EXTERNAL"
            ]
          }
        ]
      },
      "CodeSetUploadResult": {
        "title": "CodeSetUploadResult",
        "description": "Result of uploading IR code-set CSV content.",
        "type": "object",
        "properties": {
          "added": {
            "description": "Number of newly added rows.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "processed": {
            "description": "Total number of processed CSV rows.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "updated": {
            "description": "Number of updated IR code rows.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "required": [
          "processed",
          "added",
          "updated"
        ]
      },
      "CustomInstall": {
        "title": "CustomInstall",
        "description": "Installed custom component information.",
        "type": "object",
        "properties": {
          "active": {
            "description": "Whether the component is currently active.",
            "type": "boolean"
          },
          "component": {
            "description": "Component key (`ui` or `web_configurator`).",
            "allOf": [
              {
                "$ref": "#/components/schemas/CustomComponent"
              }
            ]
          },
          "installation_date": {
            "nullable": true,
            "description": "Installation timestamp (when installed).",
            "type": "string"
          },
          "installed": {
            "description": "Whether the component is installed.",
            "type": "boolean"
          }
        },
        "required": [
          "component",
          "installed",
          "active"
        ]
      },
      "CustomComponent": {
        "description": "Type of custom component installation.",
        "oneOf": [
          {
            "description": "Custom UI replacement.",
            "type": "string",
            "enum": [
              "ui"
            ]
          },
          {
            "description": "Custom web configurator replacement.",
            "type": "string",
            "enum": [
              "web_configurator"
            ]
          }
        ]
      }
