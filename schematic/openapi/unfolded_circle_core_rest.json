              }
            }
          }
        },
        "x-schematic": {
          "response": "Binary"
        }
      }
    },
    "/system/backup/restore": {
      "put": {
        "summary": "Upload and restore a backup archive using multipart form-data (`file`). The response contains per-domain restore counters.",
        "description": "Upload and restore a backup archive using multipart form-data (`file`). The response contains per-domain restore counters.",
