    "/resources/{resource_type}/{resource_id}": {
      "get": {
        "summary": "Download a single stored resource by type and identifier. Valid `resource_type` values: `icon`, `background`, `sound`. Binary response supports image/audio/file resources.",
        "description": "Download a single stored resource by type and identifier. Valid `resource_type` values: `icon`, `background`, `sound`. Binary response supports image/audio/file resources.",
        "operationId": "GetResource",
        "responses": {
          "200": {
            "description": "Successful binary response",
