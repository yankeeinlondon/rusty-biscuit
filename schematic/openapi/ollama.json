  "components": {
    "schemas": {
      "GenerateBody": {
        "title": "GenerateBody",
        "description": "Request body for the `/api/generate` endpoint.",
        "type": "object",
        "properties": {
          "context": {
            "description": "Context from a previous response to continue generation.",
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "images": {
            "description": "Images for multimodal models (base64 encoded).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keep_alive": {
            "description": "How long to keep the model loaded (e.g., \"5m\", \"-1\" for forever).",
            "type": "string"
          },
          "model": {
            "description": "Model name to use.",
            "type": "string"
          },
          "options": {
            "description": "Model options."
          },
          "prompt": {
            "description": "The prompt to generate a response for.",
            "type": "string"
          },
          "raw": {
            "description": "Raw mode bypasses templating.",
            "type": "boolean"
          },
          "stream": {
            "description": "Enable streaming (default: true).",
            "type": "boolean"
          },
          "system": {
            "description": "Optional system prompt to override the model's default.",
            "type": "string"
          },
          "template": {
            "description": "Optional template to use for generation.",
            "type": "string"
          }
        },
        "required": [
          "model",
          "prompt"
        ]
      },
      "ModelOptions": {
        "description": "Model generation options for native Ollama API.\n\nControls model behavior including sampling parameters, context window,\nand hardware utilization.",
        "type": "object",
        "properties": {
          "mirostat": {
            "description": "Enable Mirostat sampling (0, 1, or 2)."
          },
          "mirostat_eta": {
            "description": "Mirostat learning rate."
          },
          "mirostat_tau": {
            "description": "Mirostat target perplexity."
          },
          "num_ctx": {
            "description": "Context window size (default: 2048)."
          },
          "num_gpu": {
            "description": "Number of GPU layers to offload (-1 for all)."
          },
          "num_predict": {
            "description": "Maximum tokens to generate."
          },
          "num_thread": {
            "description": "Number of CPU threads to use."
          },
          "penalize_newline": {
            "description": "Penalize newline tokens."
          },
          "repeat_penalty": {
            "description": "Repetition penalty (1.0 = no penalty)."
          },
          "seed": {
            "description": "Random seed for reproducibility."
          },
          "stop": {
            "description": "Stop sequences."
          },
          "temperature": {
            "description": "Sampling temperature (0.0-2.0)."
          },
          "tfs_z": {
            "description": "Tail-free sampling parameter."
          },
          "top_k": {
            "description": "Top-K sampling parameter."
          },
          "top_p": {
            "description": "Top-P (nucleus) sampling parameter."
          }
        }
      },
      "ChatBody": {
        "title": "ChatBody",
        "description": "Request body for the `/api/chat` endpoint.",
        "type": "object",
        "properties": {
          "format": {
            "description": "Format of the response (e.g., \"json\").",
            "type": "string"
          },
          "keep_alive": {
            "description": "How long to keep the model loaded.",
            "type": "string"
          },
          "messages": {
            "description": "Chat messages.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Message"
                }
              ]
            }
          },
          "model": {
            "description": "Model name to use.",
            "type": "string"
          },
          "options": {
            "description": "Model options."
          },
          "stream": {
            "description": "Enable streaming (default: true).",
            "type": "boolean"
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "Message": {
        "title": "Message",
        "description": "A chat message in the native Ollama format.",
        "type": "object",
        "properties": {
          "content": {
            "description": "The content of the message.",
            "type": "string"
          },
          "images": {
            "description": "Optional images for multimodal models (base64 encoded).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "description": "The role of the message author (system, user, assistant).",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "EmbeddingsBody": {
        "title": "EmbeddingsBody",
        "description": "Request body for the `/api/embeddings` endpoint.",
        "type": "object",
        "properties": {
          "keep_alive": {
            "description": "How long to keep the model loaded.",
            "type": "string"
          },
          "model": {
            "description": "Model name to use.",
            "type": "string"
          },
          "options": {
            "description": "Model options."
          },
          "prompt": {
            "description": "Text to generate embeddings for.",
            "type": "string"
          }
        },
        "required": [
          "model",
          "prompt"
        ]
      },
      "ShowModelBody": {
        "title": "ShowModelBody",
        "description": "Request body for the `/api/show` endpoint.",
        "type": "object",
        "properties": {
          "name": {
            "description": "Model name to show.",
            "type": "string"
          },
          "verbose": {
            "description": "Include verbose details.",
