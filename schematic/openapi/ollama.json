        ]
      },
      "PullModelBody": {
        "title": "PullModelBody",
        "description": "Request body for the `/api/pull` endpoint.",
        "type": "object",
        "properties": {
          "insecure": {
            "description": "Allow insecure connections.",
            "type": "boolean"
          },
          "name": {
            "description": "Model name to pull.",
            "type": "string"
          },
          "stream": {
            "description": "Enable streaming progress updates (default: true).",
