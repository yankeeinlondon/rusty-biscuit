      "CreateModelBody": {
        "title": "CreateModelBody",
        "description": "Request body for the `/api/create` endpoint.",
        "type": "object",
        "properties": {
          "modelfile": {
            "description": "Modelfile content.",
            "type": "string"
          },
          "name": {
            "description": "Name for the new model.",
            "type": "string"
          },
          "path": {
            "description": "Path to a Modelfile.",
            "type": "string"
          },
          "stream": {
            "description": "Enable streaming progress updates (default: true).",
            "type": "boolean"
          }
        },
        "required": [
