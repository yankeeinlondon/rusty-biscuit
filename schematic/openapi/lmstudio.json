{
  "openapi": "3.0.3",
  "info": {
    "title": "lmstudio",
    "description": "LM Studio v1 native REST API for local LLM inference and model management",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:1234",
      "description": "LmStudio API Server"
    }
  ],
  "paths": {
    "/api/v1/chat": {
      "post": {
        "summary": "Chat completion with SSE streaming support",
        "description": "Chat completion with SSE streaming support",
        "operationId": "Chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful response\n\napplication/json: returned when `stream` is false or omitted\n\ntext/event-stream: returned when `stream` is true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResult"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ChatStreamEvent"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "ChatResult"
            }
          },
          "success": [
            {
              "note": "returned when `stream` is false or omitted",
              "shape": {
                "Json": {
                  "Named": "ChatResult"
                }
              }
            },
            {
              "note": "returned when `stream` is true",
              "shape": {
                "Stream": {
                  "end": {
                    "EventNamed": "chat.end"
                  },
                  "framing": {
                    "Sse": {
                      "Named": "ChatStreamEvent"
                    }
                  },
                  "keep": true
                }
              }
            }
          ]
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "summary": "List available models",
        "description": "List available models",
        "operationId": "ListModels",
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListModelsResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "ListModelsResponse"
            }
          }
        }
      }
    },
    "/api/v1/models/load": {
      "post": {
        "summary": "Load a model into memory",
        "description": "Load a model into memory",
        "operationId": "LoadModel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadModelBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadModelResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "LoadModelResponse"
            }
          }
        }
      }
    },
    "/api/v1/models/unload": {
      "post": {
        "summary": "Unload a model from memory",
        "description": "Unload a model from memory",
        "operationId": "UnloadModel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnloadModelBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnloadModelResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "UnloadModelResponse"
            }
          }
        }
      }
    },
    "/api/v1/models/download": {
      "post": {
        "summary": "Download a model from HuggingFace",
        "description": "Download a model from HuggingFace",
        "operationId": "DownloadModel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadModelBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadModelResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "DownloadModelResponse"
            }
          }
        }
      }
    },
    "/api/v1/models/download/status": {
      "post": {
        "summary": "Check the status of a download job",
        "description": "Check the status of a download job",
        "operationId": "GetDownloadStatus",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadStatusBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadStatusResponse"
                }
              }
            }
          }
        },
        "x-schematic": {
          "response": {
            "Json": {
              "Named": "DownloadStatusResponse"
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatBody": {
        "title": "ChatBody",
        "description": "Request body for the `/api/v1/chat` endpoint.\n\nThe reply is a [`ChatResult`] unless `stream` is `true`, in which case it\nis a stream of [`ChatStreamEvent`]s.",
        "type": "object",
        "properties": {
          "context_length": {
            "nullable": true,
            "description": "Context length override (optional).",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "max_tokens": {
            "nullable": true,
            "description": "Maximum tokens to generate.",
            "type": "integer",
            "format": "int32"
          },
          "messages": {
            "description": "Chat messages.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "model": {
            "description": "Model identifier to use for generation.",
            "type": "string"
          },
          "stop": {
            "nullable": true,
            "description": "Stop sequences.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stream": {
            "nullable": true,
            "description": "Whether to stream the response as SSE (default: false).",
            "type": "boolean"
          },
          "temperature": {
            "nullable": true,
            "description": "Sampling temperature (0.0-2.0).",
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "Message": {
        "description": "A chat message in the LM Studio format.",
        "type": "object",
        "properties": {
          "content": {
            "description": "The content of the message.",
            "type": "string"
          },
          "role": {
            "description": "The role of the message author (system, user, assistant).",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "LoadModelBody": {
        "title": "LoadModelBody",
        "description": "Request body for the `/api/v1/models/load` endpoint.",
        "type": "object",
        "properties": {
          "config": {
            "description": "Optional load configuration.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/LoadConfig"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "integrations": {
            "nullable": true,
            "description": "Optional MCP integrations.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Integration"
            }
          },
          "model": {
            "description": "Model identifier to load.",
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "Integration": {
        "description": "Configuration for an MCP integration.",
        "type": "object",
        "properties": {
          "name": {
            "description": "The MCP server name or identifier.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "LoadConfig": {
        "description": "Load configuration options.",
        "type": "object",
        "properties": {
          "context_length": {
            "nullable": true,
            "description": "Context length to use.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "gpu_offload": {
            "nullable": true,
            "description": "GPU offload layers (-1 for all).",
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "UnloadModelBody": {
        "title": "UnloadModelBody",
        "description": "Request body for the `/api/v1/models/unload` endpoint.",
        "type": "object",
        "properties": {
          "model": {
            "description": "Model identifier to unload.",
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "DownloadModelBody": {
        "title": "DownloadModelBody",
        "description": "Request body for the `/api/v1/models/download` endpoint.",
        "type": "object",
        "properties": {
          "model": {
            "description": "Model identifier to download (e.g., \"lmstudio-community/gemma-2-2b-it-GGUF\").",
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "DownloadStatusBody": {
        "title": "DownloadStatusBody",
        "description": "Request body for the `/api/v1/models/download/status` endpoint.",
        "type": "object",
        "properties": {
          "job_id": {
            "description": "The job ID to check status for.",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ]
      },
      "ListModelsResponse": {
        "title": "ListModelsResponse",
        "description": "Response from the `/api/v1/models` endpoint.",
        "type": "object",
        "properties": {
          "data": {
            "description": "List of available models.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            }
          },
          "object": {
            "description": "Object type (always \"list\").",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ]
      },
      "Capabilities": {
        "title": "Capabilities",
        "description": "Model capabilities.",
        "type": "object",
        "properties": {
          "function_calling": {
            "nullable": true,
            "description": "Whether the model supports function calling.",
            "type": "boolean"
          },
          "vision": {
            "nullable": true,
            "description": "Whether the model supports vision/multimodal input.",
            "type": "boolean"
          }
        }
      },
      "LoadedInstance": {
        "title": "LoadedInstance",
        "description": "A loaded model instance.",
        "type": "object",
        "properties": {
          "context_length": {
            "nullable": true,
            "description": "Current context length.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "id": {
            "nullable": true,
            "description": "The instance identifier.",
            "type": "string"
          }
        }
      },
      "ModelInfo": {
        "title": "ModelInfo",
        "description": "Information about a model in the list response.",
        "type": "object",
        "properties": {
          "architecture": {
            "nullable": true,
            "description": "Architecture of the model.",
            "type": "string"
          },
          "capabilities": {
            "description": "Model capabilities.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Capabilities"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "compatibility_type": {
            "nullable": true,
            "description": "Compatibility type.",
            "type": "string"
          },
          "id": {
            "description": "Model identifier (path).",
            "type": "string"
          },
          "loaded_instances": {
            "nullable": true,
            "description": "Currently loaded instances.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoadedInstance"
            }
          },
          "object": {
            "description": "Object type (always \"model\").",
            "type": "string"
          },
          "publisher": {
            "nullable": true,
            "description": "Publisher/author of the model.",
            "type": "string"
          },
          "quantization": {
            "description": "Quantization details.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quantization"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "stats": {
            "description": "Model statistics.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stats"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "type": {
            "nullable": true,
            "description": "Model type (e.g., \"llm\").",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object"
        ]
      },
      "Quantization": {
        "title": "Quantization",
        "description": "Quantization information for a model.",
        "type": "object",
        "properties": {
          "format": {
            "nullable": true,
            "description": "The quantization format (e.g., \"Q4_0\", \"Q8_0\").",
            "type": "string"
          }
        }
      },
      "Stats": {
        "title": "Stats",
        "description": "Statistics about a model.",
        "type": "object",
        "properties": {
          "parameters": {
            "nullable": true,
            "description": "Number of parameters.",
            "type": "string"
          },
          "size": {
            "nullable": true,
            "description": "Model size in bytes.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "LoadModelResponse": {
        "title": "LoadModelResponse",
        "description": "Response from the `/api/v1/models/load` endpoint.",
        "type": "object",
        "properties": {
          "model": {
            "description": "The loaded model's identifier.",
            "type": "string"
          },
          "status": {
            "nullable": true,
            "description": "Load status message.",
            "type": "string"
          }
        },
        "required": [
          "model"
        ]
      },
      "UnloadModelResponse": {
        "title": "UnloadModelResponse",
        "description": "Response from the `/api/v1/models/unload` endpoint.",
        "type": "object",
        "properties": {
          "status": {
            "description": "Unload status message.",
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "DownloadStatusResponse": {
        "title": "DownloadStatusResponse",
        "description": "Response from the `/api/v1/models/download/status` endpoint.",
        "type": "object",
        "properties": {
          "error": {
            "nullable": true,
            "description": "Error message if download failed.",
            "type": "string"
          },
          "output": {
            "nullable": true,
            "description": "Output items being downloaded.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "progress": {
            "nullable": true,
            "description": "Overall progress (0.0-1.0).",
            "type": "number",
            "format": "double"
          },
          "status": {
            "description": "Current status (e.g., \"downloading\", \"completed\", \"failed\").",
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "OutputItem": {
        "title": "OutputItem",
        "description": "An output item in the download status response.",
        "type": "object",
        "properties": {
          "path": {
            "nullable": true,
            "description": "Path where the file is being downloaded.",
            "type": "string"
          },
          "progress": {
            "nullable": true,
            "description": "Download progress (0.0-1.0).",
            "type": "number",
            "format": "double"
          },
          "type": {
            "nullable": true,
            "description": "Type of output (e.g., \"file\").",
            "type": "string"
          }
        }
      },
      "ChatResult": {
        "title": "ChatResult",
        "description": "The reply of `/api/v1/chat` when `stream` is false or omitted, and the\n`result` of the stream's final `chat.end` event.\n\nNot named `ChatResponse`: that name belongs to the generated success enum\nof the `Chat` endpoint.",
        "type": "object",
        "properties": {
          "model_instance_id": {
            "description": "The loaded model instance that generated the reply.",
            "type": "string"
          },
          "output": {
            "description": "Output items in generation order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatOutputItem"
            }
          },
          "response_id": {
            "nullable": true,
            "description": "Response identifier starting with `resp_`; present when `store` is true.",
            "type": "string"
          },
          "stats": {
            "description": "Token usage and performance.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatStats"
              }
            ]
          }
        },
        "required": [
          "model_instance_id",
          "output",
          "stats"
        ]
      },
      "ChatOutputItem": {
        "description": "One item of a chat result's `output`.",
        "oneOf": [
          {
            "description": "Text of the model's reply.",
            "type": "object",
            "properties": {
              "content": {
                "description": "The reply text.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "message"
                ]
              }
            },
            "required": [
              "type",
              "content"
            ]
          },
          {
            "description": "A tool call the model made and its result.",
            "type": "object",
            "properties": {
              "arguments": {
                "description": "The arguments passed to the tool."
              },
              "output": {
                "description": "The raw tool output.",
                "type": "string"
              },
              "provider_info": {
                "description": "The tool provider.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ToolProviderInfo"
                  }
                ]
              },
              "tool": {
                "description": "The tool name.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "tool_call"
                ]
              }
            },
            "required": [
              "type",
              "tool",
              "arguments",
              "output",
              "provider_info"
            ]
          },
          {
            "description": "The model's reasoning text.",
            "type": "object",
            "properties": {
              "content": {
                "description": "The reasoning text.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "reasoning"
                ]
              }
            },
            "required": [
              "type",
              "content"
            ]
          },
          {
            "description": "A tool call that was rejected.",
            "type": "object",
            "properties": {
              "metadata": {
                "description": "Details of the rejected call.",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/InvalidToolCallMetadata"
                  }
                ]
              },
              "reason": {
                "description": "Why the call was invalid.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "invalid_tool_call"
                ]
              }
            },
            "required": [
              "type",
              "reason",
              "metadata"
            ]
          }
        ]
      },
      "ChatStats": {
        "description": "Token usage and performance of one chat.",
        "type": "object",
        "properties": {
          "input_tokens": {
            "description": "Input tokens, including formatting, tool definitions, and prior messages.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "model_load_time_seconds": {
            "nullable": true,
            "description": "Seconds spent loading the model; only when the request loaded it.",
            "type": "number",
            "format": "double"
          },
          "reasoning_output_tokens": {
            "description": "Output tokens spent on reasoning.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "time_to_first_token_seconds": {
            "description": "Seconds until the first token.",
            "type": "number",
            "format": "double"
          },
          "tokens_per_second": {
            "description": "Generation speed.",
            "type": "number",
            "format": "double"
          },
          "total_output_tokens": {
            "description": "Total output tokens generated.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "total_output_tokens",
          "reasoning_output_tokens",
          "tokens_per_second",
          "time_to_first_token_seconds"
        ]
      },
      "InvalidToolCallMetadata": {
        "description": "Why a tool call the model attempted was rejected.",
        "type": "object",
        "properties": {
          "arguments": {
            "description": "The arguments the model passed; only for `invalid_arguments`."
          },
          "provider_info": {
            "description": "The tool provider; only for `invalid_arguments`.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolProviderInfo"
              },
              {
                "nullable": true,
                "type": "object",
                "enum": [
                  null
                ]
              }
            ]
          },
          "tool_name": {
            "description": "The tool name the model used.",
            "type": "string"
          },
          "type": {
            "description": "`invalid_name` or `invalid_arguments`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "tool_name"
        ]
      },
      "ToolProviderInfo": {
        "description": "The provider of a tool the model called.",
        "oneOf": [
          {
            "description": "A tool provided by an LM Studio plugin.",
            "type": "object",
            "properties": {
              "plugin_id": {
                "description": "The plugin identifier.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "plugin"
                ]
              }
            },
            "required": [
              "type",
              "plugin_id"
            ]
          },
          {
            "description": "A tool provided by an ephemeral MCP server.",
            "type": "object",
            "properties": {
              "server_label": {
                "description": "The MCP server label.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ephemeral_mcp"
                ]
              }
            },
            "required": [
              "type",
              "server_label"
            ]
          }
        ]
      },
      "ChatStreamEvent": {
        "title": "ChatStreamEvent",
        "description": "One server-sent event of `/api/v1/chat` when `stream` is true, decoded\nfrom the event's `data`, whose `type` repeats the SSE event name.\n\nThe stream ends with [`ChatStreamEvent::ChatEnd`]. An `error` event does\nnot end it: `chat.end` still follows with whatever was generated.",
        "oneOf": [
          {
            "description": "The chat began.",
            "type": "object",
            "properties": {
              "model_instance_id": {
                "description": "The model instance serving the chat.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
