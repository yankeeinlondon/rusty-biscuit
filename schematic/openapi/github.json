  "components": {
    "schemas": {
      "RepositoryInfo": {
        "title": "RepositoryInfo",
        "description": "Repository information from `GET /repos/{owner}/{repo}`.",
        "type": "object",
        "properties": {
          "archived": {
            "description": "Whether the repository is archived.",
            "type": "boolean"
          },
          "created_at": {
            "description": "Creation timestamp (ISO 8601).",
            "type": "string"
          },
          "default_branch": {
            "description": "Default branch name.",
            "type": "string"
          },
          "description": {
            "description": "Repository description.",
            "type": "string"
          },
          "disabled": {
            "description": "Whether the repository is disabled.",
            "type": "boolean"
          },
          "forks_count": {
            "description": "Number of forks.",
            "type": "integer",
            "format": "uint64"
          },
          "full_name": {
            "description": "Full name in \"owner/repo\" format.",
            "type": "string"
          },
          "has_issues": {
            "description": "Whether issues are enabled.",
            "type": "boolean"
          },
          "has_wiki": {
            "description": "Whether the wiki is enabled.",
            "type": "boolean"
          },
          "html_url": {
            "description": "HTML URL to the repository.",
            "type": "string"
          },
          "id": {
            "description": "Repository ID.",
            "type": "integer",
            "format": "uint64"
          },
          "language": {
            "description": "Primary programming language.",
            "type": "string"
          },
          "license": {
            "description": "License information."
          },
          "name": {
            "description": "Repository name.",
            "type": "string"
          },
          "open_issues_count": {
            "description": "Number of open issues.",
            "type": "integer",
            "format": "uint64"
          },
          "owner": {
            "description": "Repository owner."
          },
          "private": {
            "description": "Whether the repository is private.",
            "type": "boolean"
          },
          "pushed_at": {
            "description": "Last push timestamp (ISO 8601).",
            "type": "string"
          },
          "stargazers_count": {
            "description": "Number of stargazers.",
            "type": "integer",
            "format": "uint64"
          },
          "topics": {
            "description": "Topics/tags on the repository.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updated_at": {
            "description": "Last update timestamp (ISO 8601).",
            "type": "string"
          },
          "url": {
            "description": "API URL for the repository.",
            "type": "string"
          },
          "watchers_count": {
            "description": "Number of watchers.",
            "type": "integer",
            "format": "uint64"
          }
        },
        "required": [
          "id",
          "name",
          "full_name",
          "owner",
          "html_url",
          "url",
          "default_branch"
        ]
      },
      "GitTreeResponse": {
        "title": "GitTreeResponse",
        "description": "Response from `GET /repos/{owner}/{repo}/git/trees/{tree_sha}`.",
        "type": "object",
        "properties": {
          "sha": {
            "description": "SHA of the tree.",
            "type": "string"
          },
          "tree": {
            "description": "Tree entries (files and directories).",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/GitTreeEntry"
                }
              ]
            }
          },
          "truncated": {
            "description": "Whether the response was truncated (> 100k entries or 7MB).",
            "type": "boolean"
          },
          "url": {
            "description": "API URL for this tree.",
            "type": "string"
          }
        },
        "required": [
          "sha",
          "url",
          "tree"
        ]
      },
      "PullRequestSummary": {
        "title": "PullRequestSummary",
        "description": "Pull request summary from list endpoints.",
        "type": "object",
        "properties": {
          "base": {
            "description": "Base branch info."
          },
          "body": {
            "description": "PR body/description.",
            "type": "string"
          },
          "closed_at": {
            "description": "Close timestamp (if closed).",
            "type": "string"
          },
          "comments_url": {
            "description": "API URL for PR comments.",
            "type": "string"
          },
          "commits_url": {
            "description": "API URL for commits.",
            "type": "string"
          },
          "created_at": {
            "description": "Creation timestamp.",
            "type": "string"
          },
          "draft": {
            "description": "Whether this is a draft PR.",
            "type": "boolean"
          },
          "head": {
            "description": "Head branch info."
          },
          "html_url": {
            "description": "HTML URL to the PR.",
            "type": "string"
          },
          "issue_url": {
            "description": "API URL for issue resource.",
            "type": "string"
          },
          "labels": {
            "description": "Labels applied to the PR.\n\nGitHub returns labels on PRs through the same `labels` array shape\nused by issues. The list endpoint includes this field by default,\nbut `#[serde(default)]` keeps older fixtures (or alternative APIs\nthat omit it) deserializable.",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IssueLabel"
                }
              ]
            }
          },
          "merged_at": {
            "description": "Merge timestamp (if merged).",
            "type": "string"
          },
          "number": {
            "description": "PR number.",
            "type": "integer",
            "format": "uint64"
          },
          "review_comments_url": {
            "description": "API URL for review comments.",
            "type": "string"
          },
          "state": {
            "description": "PR state: \"open\", \"closed\".",
            "type": "string"
          },
          "statuses_url": {
            "description": "API URL for statuses.",
            "type": "string"
          },
