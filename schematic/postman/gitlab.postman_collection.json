{
  "info": {
    "name": "GitLab",
    "description": "GitLab REST API v4 for repository, MR, issue, and release workflows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://gitlab.com/api/v4",
      "description": "Base URL for all requests"
    },
    {
      "key": "apiKey",
      "value": "",
      "description": "API key value"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "PRIVATE-TOKEN"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "item": [
    {
      "name": "Groups",
      "item": [
        {
          "name": "ListGroupProjects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/groups/:id/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                ":id",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "description": "Page number (1-indexed, default: 1)"
                },
                {
                  "key": "per_page",
                  "description": "Items per page (default: 100, max: 100)"
                },
                {
                  "key": "archived",
                  "description": "Filter by archived status"
                },
                {
                  "key": "visibility",
                  "description": "Filter by visibility level"
                },
                {
                  "key": "order_by",
                  "description": "Sort field"
                },
                {
                  "key": "sort",
                  "description": "Sort direction"
                },
                {
                  "key": "include_subgroups",
                  "description": "Include projects from subgroups"
                }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<id>"
                }
              ]
            },
            "header": [
              {
                "key": "User-Agent",
                "value": "schematic-gitlab-client"
              }
            ],
            "description": "List projects in a group"
          }
        }
      ]
    },
