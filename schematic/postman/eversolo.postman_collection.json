          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/setVUMode",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "setVUMode"
              ],
              "query": [
                {
                  "key": "index",
                  "description": "VU mode index from getVUModeList"
                }
              ]
            },
            "description": "Set the VU meter display mode (community-discovered)"
          }
        },
        {
          "name": "SystemGetSpectrumModeList",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/getSpPlayModeList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "getSpPlayModeList"
              ]
            },
            "description": "List available spectrum display modes (community-discovered)"
