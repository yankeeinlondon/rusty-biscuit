                "{{baseUrl}}"
              ],
              "path": [
                "ZidooControlCenter",
                "RemoteControl",
                "sendkey"
              ],
              "query": [
                {
                  "key": "key",
                  "description": "Remote key constant (e.g., Key.VolumeUp, Key.MediaPlay, Key.PowerOff)"
                }
              ]
            },
            "description": "Send a remote control key command to the device"
          }
        },
        {
          "name": "RemoteInputText",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ZidooControlCenter/RemoteControl/inputtext",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ZidooControlCenter",
                "RemoteControl",
                "inputtext"
              ],
              "query": [
                {
                  "key": "text",
                  "description": "Text string to input"
                }
              ]
            },
            "description": "Send text input to the device"
          }
        }
      ]
    },
    {
