            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ZidooControlCenter/getModel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ZidooControlCenter",
                "getModel"
              ]
            },
            "description": "Get device model, firmware, and network information"
