{
  "info": {
    "name": "Eversolo",
    "description": "Eversolo DMP-A8 local-network HTTP control API (Zidoo lineage)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.1.1:9529",
      "description": "Base URL for all requests"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "SystemSettings",
      "item": [
        {
          "name": "SystemGetScreenBrightness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/getScreenBrightness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "getScreenBrightness"
              ]
            },
            "description": "Get current screen brightness level (community-discovered)"
          }
        },
        {
          "name": "SystemSetScreenBrightness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/setScreenBrightness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "setScreenBrightness"
              ],
              "query": [
                {
                  "key": "index",
                  "description": "Brightness level index"
                }
              ]
            },
            "description": "Set screen brightness level (community-discovered)"
          }
        },
        {
          "name": "SystemGetKnobBrightness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/getKnobBrightness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "getKnobBrightness"
              ]
            },
            "description": "Get current knob LED brightness level (community-discovered)"
          }
        },
        {
          "name": "SystemSetKnobBrightness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/setKnobBrightness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "setKnobBrightness"
              ],
              "query": [
                {
                  "key": "index",
                  "description": "Brightness level index"
                }
              ]
            },
            "description": "Set knob LED brightness level (community-discovered)"
          }
        },
        {
          "name": "SystemGetVuModeList",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/getVUModeList",
              "host": [
                "{{baseUrl}}"
