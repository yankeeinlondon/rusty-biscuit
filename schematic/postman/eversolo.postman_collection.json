        {
          "name": "SystemSetSpectrumMode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/SystemSettings/displaySettings/setSpPlayModeList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "SystemSettings",
                "displaySettings",
                "setSpPlayModeList"
              ],
              "query": [
                {
                  "key": "index",
                  "description": "Spectrum mode index from getSpPlayModeList"
                }
              ]
            },
            "description": "Set the spectrum display mode (community-discovered)"
          }
