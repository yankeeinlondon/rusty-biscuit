                "api",
                "embeddings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generate embeddings for text"
          }
        },
        {
          "name": "ListModels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": [
                "{{baseUrl}}"
