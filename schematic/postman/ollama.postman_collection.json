{
  "info": {
    "name": "Ollama",
    "description": "OllamaNative: Ollama native REST API for local LLM inference and model management\nOllamaOpenAI: Ollama OpenAI-compatible REST API for drop-in replacement of OpenAI clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:11434",
      "description": "Base URL for OllamaNative"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Api",
      "item": [
        {
          "name": "Generate",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generate text completion from a prompt (streaming NDJSON by default)"
          }
        },
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generate chat completion from messages (streaming NDJSON by default)"
          }
        },
        {
          "name": "Embeddings",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/embeddings",
              "host": [
                "{{baseUrl}}"
