{
  "info": {
    "name": "Ollama",
    "description": "OllamaNative: Ollama native REST API for local LLM inference and model management\nOllamaOpenAI: Ollama OpenAI-compatible REST API for drop-in replacement of OpenAI clients",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:11434",
      "description": "Base URL for OllamaNative"
    },
    {
      "key": "baseUrl2",
      "value": "http://localhost:11434",
      "description": "Base URL for OllamaOpenAI"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Api",
      "item": [
        {
          "name": "Generate",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"string\",\n  \"prompt\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generate text completion from a prompt (streaming NDJSON by default)\n\nResponse content type: `application/x-ndjson`."
          },
          "response": [
            {
              "name": "200 OK (application/x-ndjson)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/x-ndjson"
                }
              ],
              "body": "{\"error\":\"string\"}\n{\"done\":true,\"error\":\"string\"}\n"
            },
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"created_at\": \"string\",\n  \"done\": false,\n  \"model\": \"string\",\n  \"response\": \"string\"\n}"
            }
          ]
        },
