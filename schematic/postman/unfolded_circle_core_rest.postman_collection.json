{
  "info": {
    "name": "UnfoldedCircleCoreRest",
    "description": "Unfolded Circle Core REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://remote.local/api",
      "description": "Base URL for all requests"
    },
    {
      "key": "bearerToken",
      "value": "",
      "description": "Bearer token for Authorization header"
    },
    {
      "key": "path_resource_type",
      "value": "",
      "description": "Value of the `resource_type` path parameter"
    },
    {
      "key": "path_resource_id",
      "value": "",
      "description": "Value of the `resource_id` path parameter"
    },
    {
      "key": "path_code_set_id",
      "value": "",
      "description": "Value of the `code_set_id` path parameter"
    },
    {
      "key": "path_custom_component",
      "value": "",
      "description": "Value of the `custom_component` path parameter"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "Intg",
      "item": [
        {
          "name": "InstallCustomIntegration",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/intg/install",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intg",
                "install"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "description": "Install a custom integration driver from a tar archive upload (`file`). Returned metadata includes required driver identity fields."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"driver_id\": \"string\",\n  \"driver_type\": \"LOCAL\",\n  \"enabled\": false,\n  \"name\": {},\n  \"version\": \"string\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Ir",
      "item": [
        {
          "name": "UploadCustomIrCodeSet",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/ir/codes/custom/:code_set_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ir",
                "codes",
                "custom",
                ":code_set_id"
              ],
              "variable": [
                {
                  "key": "code_set_id",
                  "value": "{{path_code_set_id}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "description": "Upload an IR code CSV for a custom code-set via multipart form-data (`file`). Response reports processed/added/updated counts."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"added\": 0,\n  \"processed\": 0,\n  \"updated\": 0\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Pub",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/pub/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pub",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"string\",\n  \"username\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a cookie session using username/password credentials for clients that do not use bearer tokens. Docs: /pub/login in the official Core REST reference."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/pub/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pub",
                "logout"
              ]
            },
            "description": "Invalidate the active cookie session created by Login. Typical usage is explicit sign-out in long-running admin tools."
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204
            }
          ]
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "UploadResource",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/resources/:resource_type",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resources",
                ":resource_type"
              ],
              "variable": [
                {
                  "key": "resource_type",
                  "value": "{{path_resource_type}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "description": "Upload a custom resource for the selected resource type via multipart form-data (`file`). Valid `resource_type` values: `icon`, `background`, `sound`."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[]"
            }
          ]
        },
        {
          "name": "GetResource",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/resources/:resource_type/:resource_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resources",
                ":resource_type",
                ":resource_id"
              ],
              "variable": [
                {
                  "key": "resource_type",
                  "value": "{{path_resource_type}}"
                },
                {
                  "key": "resource_id",
                  "value": "{{path_resource_id}}"
                }
              ]
            },
            "description": "Download a single stored resource by type and identifier. Valid `resource_type` values: `icon`, `background`, `sound`. Binary response supports image/audio/file resources."
          },
          "response": [
            {
              "name": "200 OK (application/octet-stream)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/octet-stream"
                }
              ],
              "body": "<binary application/octet-stream body; not representable as an example>"
            }
          ]
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "GetSystemInfo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/system",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system"
              ]
            },
            "description": "Return model/serial/hardware metadata for the remote. If this endpoint is polled frequently, callers should avoid storing repeated owned `String` snapshots to reduce memory churn."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"hw_revision\": \"string\",\n  \"model_name\": \"string\",\n  \"model_number\": \"string\",\n  \"serial_number\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "ExportBackup",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/system/backup/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "backup",
                "export"
              ]
            },
            "description": "Download the current device backup archive as binary bytes. This endpoint maps to ApiResponse::Binary because the server returns an archive stream."
          },
          "response": [
            {
              "name": "200 OK (application/octet-stream)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/octet-stream"
                }
              ],
              "body": "<binary application/octet-stream body; not representable as an example>"
            }
          ]
        },
        {
          "name": "RestoreBackup",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/system/backup/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "backup",
                "restore"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "description": "Upload and restore a backup archive using multipart form-data (`file`). The response contains per-domain restore counters."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[]"
            }
          ]
        },
        {
          "name": "InstallCustomComponent",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/system/install/:custom_component",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "install",
                ":custom_component"
              ],
              "variable": [
                {
                  "key": "custom_component",
                  "value": "{{path_custom_component}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                }
              ]
            },
            "description": "Upload and install a custom UI or web-configurator component package (`file`). Valid `custom_component` values: `ui`, `web_configurator`. Returns install/activation status."
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"active\": false,\n  \"component\": \"ui\",\n  \"installed\": false\n}"
            }
          ]
        },
        {
          "name": "QueryLogsText",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/system/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "logs"
              ]
            },
            "description": "Retrieve system logs as plain text export for diagnostics pipelines and offline inspection."
          },
          "response": [
            {
              "name": "200 OK (text/plain)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "string"
            }
          ]
        }
      ]
    }
  ]
}