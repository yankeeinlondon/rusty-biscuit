{
  "info": {
    "name": "LmStudio",
    "description": "LM Studio v1 native REST API for local LLM inference and model management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1234",
      "description": "Base URL for all requests"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "Api",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Chat completion with SSE streaming support"
          }
        },
        {
          "name": "ListModels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models"
              ]
            },
            "description": "List available models"
          }
        },
        {
          "name": "LoadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/load",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "load"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Load a model into memory"
          }
        },
        {
          "name": "UnloadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/unload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "unload"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Unload a model from memory"
          }
        },
        {
          "name": "DownloadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "download"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Download a model from HuggingFace with SSE progress"
          }
        },
        {
          "name": "GetDownloadStatus",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/download/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "download",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Check the status of a download job"
          }
        }
      ]
    }
  ]
}