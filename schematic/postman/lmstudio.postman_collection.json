{
  "info": {
    "name": "LmStudio",
    "description": "LM Studio v1 native REST API for local LLM inference and model management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1234",
      "description": "Base URL for all requests"
    },
    {
      "key": "bearerToken",
      "value": "",
      "description": "Bearer token for Authorization header"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "Api",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [],\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Chat completion with SSE streaming support"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"model_instance_id\": \"string\",\n  \"output\": [],\n  \"stats\": {\n    \"input_tokens\": 0,\n    \"reasoning_output_tokens\": 0,\n    \"time_to_first_token_seconds\": 0,\n    \"tokens_per_second\": 0,\n    \"total_output_tokens\": 0\n  }\n}"
            },
            {
              "name": "200 OK (text/event-stream)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/event-stream"
                }
              ],
              "body": "data: {\"model_instance_id\":\"string\",\"type\":\"chat.start\"}\n\nevent: chat.end\ndata: {\"model_instance_id\":\"string\",\"type\":\"chat.start\"}\n\n"
            }
          ]
        },
        {
          "name": "ListModels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models"
              ]
            },
            "description": "List available models"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [],\n  \"object\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "LoadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/load",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "load"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Load a model into memory"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"model\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "UnloadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/unload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "unload"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Unload a model from memory"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "DownloadModel",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "download"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Download a model from HuggingFace"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "GetDownloadStatus",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/models/download/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "download",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Check the status of a download job"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"string\"\n}"
            }
          ]
        }
      ]
    }
  ]
}