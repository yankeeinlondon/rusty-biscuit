{
  "info": {
    "name": "Anthropic",
    "description": "Anthropic Messages API for Claude AI interactions and agent tool use",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.anthropic.com/v1",
      "description": "Base URL for all requests"
    },
    {
      "key": "apiKey",
      "value": "",
      "description": "API key value"
    },
    {
      "key": "path_model_id",
      "value": "",
      "description": "Value of the `model_id` path parameter"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "item": [
    {
      "name": "Messages",
      "item": [
        {
          "name": "CreateMessage",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages"
              ]
            },
            "header": [
              {
                "key": "anthropic-version",
                "value": "2023-06-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_tokens\": 0,\n  \"messages\": [],\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a message with optional tool use for agent interactions"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"content\": [],\n  \"id\": \"string\",\n  \"model\": \"string\",\n  \"role\": \"user\",\n  \"stop_reason\": \"end_turn\",\n  \"type\": \"string\",\n  \"usage\": {\n    \"input_tokens\": 0,\n    \"output_tokens\": 0\n  }\n}"
            },
            {
              "name": "200 OK (text/event-stream)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/event-stream"
                }
              ],
              "body": "data: {\"message\":{\"content\":[],\"id\":\"string\",\"model\":\"string\",\"role\":\"user\",\"type\":\"string\"},\"type\":\"message_start\"}\n\nevent: message_stop\ndata: {}\n\n"
            }
          ]
        },
        {
          "name": "CountTokens",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/messages/count_tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages",
                "count_tokens"
              ]
            },
            "header": [
              {
                "key": "anthropic-version",
                "value": "2023-06-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [],\n  \"model\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Count tokens in a message before sending"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"input_tokens\": 0\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Models",
      "item": [
        {
          "name": "ListModels",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "models"
              ]
            },
            "header": [
              {
                "key": "anthropic-version",
                "value": "2023-06-01"
              }
            ],
            "description": "List available Claude models"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [],\n  \"first_id\": \"string\",\n  \"has_more\": false,\n  \"last_id\": \"string\"\n}"
            }
          ]
        },
        {
          "name": "RetrieveModel",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/models/:model_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "models",
                ":model_id"
              ],
              "variable": [
                {
                  "key": "model_id",
                  "value": "{{path_model_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "anthropic-version",
                "value": "2023-06-01"
              }
            ],
            "description": "Get information about a specific model"
          },
          "response": [
            {
              "name": "200 OK (application/json)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"created_at\": \"string\",\n  \"display_name\": \"string\",\n  \"id\": \"string\",\n  \"type\": \"string\"\n}"
            }
          ]
        }
      ]
    }
  ]
}