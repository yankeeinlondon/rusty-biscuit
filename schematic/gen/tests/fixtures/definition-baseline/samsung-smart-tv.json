      {
        "description": "Canonical Smart View info endpoint for modern Samsung TVs. Returns device identity, model, firmware, and network details. Payload fields vary by model and firmware revision; unknown fields are preserved via flattened extras. For high-frequency polling, prefer conditional requests or payload diffing to reduce repeated owned-string allocations when firmware does not support ETag-style cache validation.",
        "headers": [],
        "id": "GetDeviceInfo",
        "method": "GET",
        "params": null,
        "path": "/api/v2/",
        "request": null,
        "response": {
          "Json": {
            "Named": "SamsungDeviceInfoResponse"
          }
        }
      },
      {
        "description": "Debug/developer-facing log endpoint. May require developer mode enabled on the TV and can return non-success status when disabled.",
        "headers": [],
        "id": "GetServerLogs",
        "method": "GET",
        "params": null,
        "path": "/logs/",
        "request": null,
        "response": "Text"
      },
      {
        "description": "Launch a Samsung application by its package ID. Firmware-dependent support; use when the Samsung app ID is known. Recommended runtime strategy: attempt this endpoint first, fall back to LaunchApplicationByName.",
        "headers": [],
        "id": "LaunchApplicationById",
        "method": "POST",
        "params": null,
        "path": "/api/v2/applications/{app_id}",
        "request": null,
        "response": "Empty"
      },
      {
        "description": "Launch a Samsung application by name. Compatibility fallback for firmware that does not honor /api/v2/applications/{id}.",
        "headers": [],
        "id": "LaunchApplicationByName",
        "method": "POST",
        "params": null,
        "path": "/ws/apps/{app_name}",
        "request": null,
        "response": "Empty"
      },
      {
        "description": "Get the running status and metadata of a specific application. Returns visibility, running state, version, and name.",
        "headers": [],
        "id": "GetAppStatus",
        "method": "GET",
        "params": null,
        "path": "/api/v2/applications/{app_id}",
        "request": null,
        "response": {
          "Json": {
            "Named": "SamsungAppStatusResponse"
          }
        }
      },
      {
        "description": "Close a running application by its ID. Sends a DELETE to the application endpoint, which requests the TV terminate the app.",
        "headers": [],
        "id": "CloseApp",
        "method": "DELETE",
        "params": null,
        "path": "/api/v2/applications/{app_id}",
        "request": null,
        "response": "Empty"
      },
      {
        "description": "Install (or reinstall) an application by its ID. The TV downloads and installs the app from the Samsung app store.",
        "headers": [],
        "id": "InstallApp",
        "method": "PUT",
        "params": null,
        "path": "/api/v2/applications/{app_id}",
        "request": null,
        "response": "Empty"
      }
