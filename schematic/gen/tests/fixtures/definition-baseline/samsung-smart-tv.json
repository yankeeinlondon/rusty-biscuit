        "oauth_scopes": null,
        "params": null,
        "path": "/logs/",
        "request": null,
        "response": "Text"
      },
      {
        "description": "Launch a Samsung application by its package ID. Firmware-dependent support; use when the Samsung app ID is known. Recommended runtime strategy: attempt this endpoint first, fall back to LaunchApplicationByName.",
