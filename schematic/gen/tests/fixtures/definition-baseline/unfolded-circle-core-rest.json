{
  "definition": {
    "auth": {
      "BearerToken": {
        "header": null
      }
    },
    "auth_policy": null,
    "base_url": "http://remote.local/api",
    "cross_origin": "SameOrigin",
    "default_pagination": null,
    "description": "Unfolded Circle Core REST API",
    "docs_url": "https://unfoldedcircle.github.io/core-api/rest/",
    "endpoints": [
      {
        "description": "Create a cookie session using username/password credentials for clients that do not use bearer tokens. Docs: /pub/login in the official Core REST reference.",
        "headers": [],
        "id": "Login",
        "method": "POST",
        "params": null,
        "path": "/pub/login",
        "request": {
          "Json": {
            "Named": "LoginRequest"
          }
        },
        "response": {
          "Json": {
            "Named": "ApiResponseMessage"
          }
        }
      },
      {
        "description": "Invalidate the active cookie session created by Login. Typical usage is explicit sign-out in long-running admin tools.",
        "headers": [],
        "id": "Logout",
        "method": "POST",
        "params": null,
        "path": "/pub/logout",
        "request": null,
        "response": "Empty"
      },
      {
        "description": "Return model/serial/hardware metadata for the remote. If this endpoint is polled frequently, callers should avoid storing repeated owned `String` snapshots to reduce memory churn.",
        "headers": [],
        "id": "GetSystemInfo",
        "method": "GET",
        "params": null,
        "path": "/system",
        "request": null,
        "response": {
          "Json": {
            "Named": "SystemInfo"
          }
        }
      },
      {
        "description": "Download the current device backup archive as binary bytes. This endpoint maps to ApiResponse::Binary because the server returns an archive stream.",
        "headers": [],
        "id": "ExportBackup",
        "method": "GET",
        "params": null,
        "path": "/system/backup/export",
        "request": null,
        "response": "Binary"
      },
      {
        "description": "Upload and restore a backup archive using multipart form-data (`file`). The response contains per-domain restore counters.",
        "headers": [],
        "id": "RestoreBackup",
        "method": "PUT",
        "params": null,
        "path": "/system/backup/restore",
        "request": {
          "FormData": {
            "fields": [
              {
                "description": null,
                "kind": {
                  "File": {
                    "accept": []
                  }
                },
                "name": "file",
                "required": true
              }
            ]
          }
        },
        "response": {
          "Json": {
            "Array": {
              "Named": "BackupRestoreReportItem"
            }
          }
        }
      },
      {
        "description": "Upload a custom resource for the selected resource type via multipart form-data (`file`). Valid `resource_type` values: `icon`, `background`, `sound`.",
        "headers": [],
        "id": "UploadResource",
        "method": "POST",
        "params": null,
        "path": "/resources/{resource_type}",
        "request": {
          "FormData": {
            "fields": [
              {
                "description": null,
                "kind": {
                  "File": {
                    "accept": []
                  }
                },
                "name": "file",
                "required": true
              }
            ]
          }
        },
        "response": {
          "Json": {
            "Array": {
              "Named": "ResourceItem"
            }
          }
        }
      },
      {
        "description": "Download a single stored resource by type and identifier. Valid `resource_type` values: `icon`, `background`, `sound`. Binary response supports image/audio/file resources.",
        "headers": [],
        "id": "GetResource",
        "method": "GET",
        "params": null,
        "path": "/resources/{resource_type}/{resource_id}",
        "request": null,
        "response": "Binary"
      },
      {
        "description": "Install a custom integration driver from a tar archive upload (`file`). Returned metadata includes required driver identity fields.",
        "headers": [],
        "id": "InstallCustomIntegration",
        "method": "POST",
        "params": null,
        "path": "/intg/install",
        "request": {
          "FormData": {
            "fields": [
              {
                "description": null,
                "kind": {
                  "File": {
                    "accept": []
                  }
                },
                "name": "file",
                "required": true
              }
            ]
          }
        },
        "response": {
          "Json": {
            "Named": "IntegrationDriverInfo"
          }
        }
      },
      {
        "description": "Upload an IR code CSV for a custom code-set via multipart form-data (`file`). Response reports processed/added/updated counts.",
        "headers": [],
        "id": "UploadCustomIrCodeSet",
        "method": "POST",
        "params": null,
        "path": "/ir/codes/custom/{code_set_id}",
        "request": {
          "FormData": {
            "fields": [
              {
                "description": null,
                "kind": {
                  "File": {
                    "accept": []
                  }
                },
                "name": "file",
                "required": true
              }
            ]
          }
        },
        "response": {
          "Json": {
            "Named": "CodeSetUploadResult"
          }
        }
      },
      {
        "description": "Upload and install a custom UI or web-configurator component package (`file`). Valid `custom_component` values: `ui`, `web_configurator`. Returns install/activation status.",
        "headers": [],
        "id": "InstallCustomComponent",
        "method": "POST",
        "params": null,
        "path": "/system/install/{custom_component}",
        "request": {
          "FormData": {
            "fields": [
              {
                "description": null,
                "kind": {
                  "File": {
                    "accept": []
                  }
                },
                "name": "file",
                "required": true
              }
            ]
          }
        },
        "response": {
          "Json": {
            "Named": "CustomInstall"
          }
        }
      },
      {
        "description": "Retrieve system logs as plain text export for diagnostics pipelines and offline inspection.",
        "headers": [],
        "id": "QueryLogsText",
        "method": "GET",
        "params": null,
        "path": "/system/logs",
        "request": null,
        "response": "Text"
      }
    ],
    "env_auth": [
      "UCR_CORE_API_KEY",
      "UNFOLDED_CIRCLE_API_KEY"
    ],
    "env_mapping": {
      "api_key": null,
      "basic_pass": {
        "names": [
          "UCR_CORE_PASSWORD"
        ]
      },
      "basic_user": {
        "names": [
          "UCR_CORE_USER"
        ]
      },
      "bearer_token": {
        "names": [
          "UCR_CORE_API_KEY",
          "UNFOLDED_CIRCLE_API_KEY"
        ]
      }
    },
    "env_username": "UCR_CORE_USER",
    "headers": [],
    "module_path": "unfolded_circle_core_rest",
    "name": "UnfoldedCircleCoreRest",
    "request_id_header": null,
