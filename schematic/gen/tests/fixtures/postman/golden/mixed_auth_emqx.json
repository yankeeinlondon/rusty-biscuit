{
  "info": {
    "description": "EmqxBasic: EmqxBasic test API\nEmqxBearer: EmqxBearer test API",
    "name": "Emqx",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "name": "ListAlarms (EmqxBasic)",
          "request": {
            "auth": {
              "basic": [
                {
                  "key": "username",
                  "value": "{{username_EmqxBasic}}"
                },
                {
                  "key": "password",
                  "value": "{{password_EmqxBasic}}"
                }
              ],
              "type": "basic"
            },
            "description": "List active alarms (basic auth)",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alarms"
              ],
              "raw": "{{baseUrl}}/alarms"
            }
          },
          "response": [
            {
              "body": "{}",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "name": "200 OK (application/json)",
              "status": "OK"
            }
          ]
        },
        {
          "name": "ListAlarms (EmqxBearer)",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken_EmqxBearer}}"
                }
              ],
              "type": "bearer"
            },
            "description": "List active alarms (bearer auth)",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl2}}"
              ],
              "path": [
                "alarms"
              ],
              "raw": "{{baseUrl2}}/alarms"
            }
          },
          "response": [
            {
              "body": "{}",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "name": "200 OK (application/json)",
              "status": "OK"
            }
          ]
        }
      ],
      "name": "Alarms"
    },
    {
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken_EmqxBearer}}"
                }
              ],
              "type": "bearer"
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{}"
            },
            "description": "Exchange credentials for a bearer token",
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl2}}"
              ],
              "path": [
                "login"
              ],
              "raw": "{{baseUrl2}}/login"
            }
          },
          "response": [
            {
              "body": "{}",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "name": "200 OK (application/json)",
              "status": "OK"
            }
          ]
        }
      ],
      "name": "Login"
    },
    {
      "item": [
        {
          "name": "GetSettings",
          "request": {
            "auth": {
              "basic": [
                {
                  "key": "username",
                  "value": "{{username_EmqxBasic}}"
                },
                {
                  "key": "password",
                  "value": "{{password_EmqxBasic}}"
                }
              ],
              "type": "basic"
            },
            "description": "Read EMQX settings",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "settings"
              ],
              "raw": "{{baseUrl}}/settings"
            }
          },
          "response": [
            {
              "body": "{}",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "name": "200 OK (application/json)",
              "status": "OK"
            }
          ]
        }
      ],
      "name": "Settings"
    }
  ],
  "variable": [
    {
      "description": "Base URL for EmqxBasic",
      "key": "baseUrl",
      "value": "http://localhost:18083/api/v5"
    },
    {
      "description": "Base URL for EmqxBearer",
      "key": "baseUrl2",
      "value": "http://localhost:18083/api/v5"
    },
    {
      "description": "Username for Basic authentication",
      "key": "username_EmqxBasic",
      "value": ""
    },
    {
      "description": "Password for Basic authentication",
      "key": "password_EmqxBasic",
      "value": ""
    },
    {
      "description": "Bearer token for Authorization header",
      "key": "bearerToken_EmqxBearer",
      "value": ""
    }
  ]
}
