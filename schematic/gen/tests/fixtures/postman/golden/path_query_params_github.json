{
  "auth": {
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ],
    "type": "bearer"
  },
  "info": {
    "description": "GitHub test API",
    "name": "GitHub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "name": "ListRepoIssues",
          "request": {
            "description": "List issues for a repository",
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "repos",
                ":owner",
                ":repo",
                "issues"
              ],
              "query": [
                {
                  "description": "Issue state filter",
                  "disabled": true,
                  "key": "state",
                  "value": "{{query_state}}"
                }
              ],
              "raw": "{{baseUrl}}/repos/:owner/:repo/issues",
              "variable": [
                {
                  "key": "owner",
                  "value": "{{path_owner}}"
                },
                {
                  "key": "repo",
                  "value": "{{path_repo}}"
                }
              ]
            }
          },
          "response": [
            {
              "body": "{}",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "name": "200 OK (application/json)",
              "status": "OK"
            }
          ]
        }
      ],
      "name": "Repos"
    }
  ],
  "variable": [
    {
      "description": "Base URL for all requests",
      "key": "baseUrl",
      "value": "https://api.github.com"
    },
    {
      "description": "Bearer token for Authorization header",
      "key": "bearerToken",
      "value": ""
    },
    {
      "description": "Value of the `owner` path parameter",
      "key": "path_owner",
      "value": ""
    },
    {
      "description": "Value of the `repo` path parameter",
      "key": "path_repo",
      "value": ""
    },
    {
      "description": "Value of the `state` query parameter",
      "key": "query_state",
      "value": ""
    }
  ]
}
