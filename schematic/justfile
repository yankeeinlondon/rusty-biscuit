set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

TODAY := `date +%F`

PACKAGE := "Schematic"
SCHEMATIC := lowercase(PACKAGE)
DEFINE_NAME := PACKAGE + " Define Library"
DEFINE := SCHEMATIC + "-define"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Schematic Package"
        echo "=================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build schematic packages (define, definitions, gen, oauth)
build *args="":
    @just _build schematic-define "Schematic Define" {{ args }}
    @just _build schematic-gen "Schematic Generation" {{ args }}
    @just _build schematic-definitions "Schematic Definitions" {{ args }}
    @just _build schematic-oauth "Schematic OAuth" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# `--all-features` on schematic-define throughout: `default = []`, and the
# `openapi` feature gates 233 of its 535 tests. Both in-area consumers
# (schematic-gen, schematic-definitions) enable it, so the default set is a
# configuration nobody builds — running it reports 302 tests as the whole suite.
# Same reasoning as biscuit-visualized's `--all-features`.

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "schematic-define --all-features; schematic-definitions; schematic-gen; schematic-oauth"

# run tests for schematic packages
test *args="":
    @just _test_all "schematic-define --all-features; schematic-gen; schematic-definitions; schematic-oauth" {{ args }}

# test the generated schematic-schema crate (excluded from the workspace; uses its generated manifest)
test-schema *args="":
    @echo ""
    @echo "Testing schematic-schema (generated)"
    @echo "------------------------------------"
    @echo ""
    @cargo nextest run --manifest-path schema/Cargo.toml {{ args }}

# clippy the generated schematic-schema crate (excluded from the workspace)
lint-schema:
    @echo ""
    @echo "Linting schematic-schema (generated)"
    @echo "------------------------------------"
    @echo ""
    @cargo clippy --manifest-path schema/Cargo.toml --all-targets -- -D warnings

# not applicable: schematic has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for schematic"

# not applicable: schematic has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for schematic"

# not applicable: schematic emits API client code, not HTML
test-browser:
    @echo "test-browser: not applicable for schematic"

# E2E generation tests live behind `--ignored`; expose via test-real.
test-real *args="":
    @just _test_real schematic-define {{ args }}
    @just _test_real schematic-definitions {{ args }}
    @just _test_real schematic-gen {{ args }}
    @just _test_real schematic-oauth {{ args }}

# Criterion benches: schematic crates are code-generation focused with no algorithmic hot paths.
bench:
    @echo "bench: not applicable for schematic"

# Per-package LCOV coverage for schematic crates.
coverage *args="":
    @just _coverage schematic-define --all-features {{ args }}
    @just _coverage schematic-definitions {{ args }}
    @just _coverage schematic-gen {{ args }}
    @just _coverage schematic-oauth {{ args }}

# Doctests for schematic crates.
doctest *args="":
    @just _doctest schematic-define --all-features {{ args }}
    @just _doctest schematic-definitions {{ args }}
    @just _doctest schematic-gen {{ args }}
    @just _doctest schematic-oauth {{ args }}

# not applicable: schematic has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for schematic"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just lint-schema
    @just doctest
    @just test
    @just test-schema
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# check for artifact drift (run after making definition changes)
check-drift:
    @echo ""
    @echo "Checking Artifact Drift"
    @echo "-----------------------"
    @echo ""
    @cargo test -p schematic-gen artifact_drift -- --ignored

# run clippy on schematic packages
lint:
    @just _lint schematic-define
    @just _lint schematic-gen
    @just _lint schematic-definitions
    @just _lint schematic-oauth

# generate OpenAI API client code (dry-run preview)
generate-dry-run:
    @echo ""
    @echo "Generating Code (Dry Run)"
    @echo "-------------------------"
    @echo ""
    @cargo run -p schematic-gen -- --api openai --dry-run

# re-import the OpenAI definition from its vendored OpenAPI spec
#
# Rewrites definitions/src/openai/{mod,types}.rs. Run `just generate` afterwards
# to rebuild the client and the exported artifacts. The Assistants family is
# excluded: OpenAI has superseded it with Responses + Conversations.
import-openai:
    @echo ""
    @echo "Importing OpenAI Definition"
    @echo "---------------------------"
    @echo ""
    @cargo run -p schematic-gen -- import \
        --input specs/openai/openapi.yaml \
        --api-name OpenAI \
        --module-path openai \
        --definitions-out definitions/src/openai \
        --exclude-path /assistants \
        --exclude-path /threads

# generate all API clients to schematic/schema
generate:
    @echo ""
    @echo "Generating All API Clients"
    @echo "--------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --openapi-out openapi --postman-out postman -v
    @just _notify "The Schematic definitions in schematic-definitions were generated to schematic-schema" "Schematic"

# generate a single API client to schematic/schema
generate-one api:
    @echo ""
    @echo "Generating {{ api }} API Client"
    @echo "------------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api {{ api }} --output schema/src \
        --openapi-out openapi --postman-out postman -v

# generate only OpenAPI specs (no Postman)
generate-openapi:
    @echo ""
    @echo "Generating OpenAPI Specs"
    @echo "------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --openapi-out openapi --no-postman -v

# generate only Postman collections (no OpenAPI)
generate-postman:
    @echo ""
    @echo "Generating Postman Collections"
    @echo "------------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --postman-out postman --no-openapi -v

# build, install CLI, generate schemas, and verify
install:
    @echo ""
    @echo -e "Installing {{ BOLD }}{{ YELLOW }}Schematic{{ RESET }}"
    @echo "--------------------"
    @echo ""
    @echo -e "{{ BOLD }}Building schematic packages (release){{ RESET }}"
    @cargo build --release -p schematic-define -p schematic-definitions -p schematic-gen  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{ BOLD }}Installing schematic-gen CLI{{ RESET }}"
    @cargo install --path gen --locked  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{ BOLD }}Generating all API clients{{ RESET }}"
    @cargo run --release -p schematic-gen -- --api all --output schema/src -v  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{ BOLD }}Verifying generated code compiles{{ RESET }}"
    @cargo check -p schematic-schema  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{ BLUE }}{{ BOLD }}Schematic installed successfully!{{ RESET }}"
    @echo ""
    @playa effect drop-4 2>/dev/null || exit 0

# clean generated schema code
clean-generated:
    @echo ""
    @echo "Cleaning Generated Code"
    @echo "-----------------------"
    @echo ""
    @rm -rf schema/src
    @rm -f schema/Cargo.toml
    @echo "Cleaned schema/"

# full workflow: generate and verify compilation
full: generate
    @echo ""
    @echo "Verifying Generated Code"
    @echo "------------------------"
    @echo ""
    @cargo check --manifest-path schema/Cargo.toml
    @just lint-schema
    @just test-schema
    @echo ""
    @echo "Generation complete and verified!"

# run slow E2E tests (compiles generated code)
test-e2e:
    @echo ""
    @echo "Running E2E Tests"
    @echo "-----------------"
    @echo ""
    @cargo test -p schematic-gen --test e2e_generation -- --ignored

# build and show the docs for the library code
docs:
    @echo "Documentation for Schematic packages"
    @echo ""
    @cargo doc --workspace --no-deps --open
    @just _speak "Documentation for {{ PACKAGE }} was built";

release:
    @just lint
    @just test-e2e
    @just build --release
    @just full
    @just docs

# Provides a two-step review of an API defined in Schematic
review-api api design:
    @echo ""
    @echo "Review the {{ BOLD }}{{ api }}{{ RESET }} API in schematic"
    @echo "{{ DIM }}{{ ITALIC }}- review file located at {{ BLUE }}./docs/{{ TODAY }}-review-of-{{ api }}.md{{ RESET }}"
    @touch "./docs/{{ TODAY }}-review-of-{{ api }}.md"
    @claudine gemini --ni "Your task is to review the {{ api }} API definition(s) which are defined in the schematic-definitions as well the generated API clients for {{ api }} API's in schematic-schema. Keep in mind the best practices for API definitions found in @schematic/skill/best-practices-in-designing-an-api.md . Also review the original design document found at @schematic/docs/{{ design }} . Look for for all opportunities to improve the ergonomics and/or performance of the code. Also look at the quality of documentation and ensure that it's high quality in both the schematic-definitions package but that the generated API client in schematic-schema is fully documented. Make sure that this API also exports a valid OpenAPI definition as part of the generation step. Write all your recommendations to @schematic/docs/{{ TODAY }}-review-of-{{ api }}.md . Remember that this is a non-interactive process so avoid asking questions and just complete the task."
    @echo
    @echo "First Stage of Review is Complete. Now will validate that Completion Steps have been completed."
    @echo
    @claudine gem --ni "A review on the {{ api }} API in schematic was performed and produced the suggestions found in @schematic/docs/{{ TODAY }}-review-of-{{ api }}.md ; your task is to apply the completion checklist found in @schematic/skill/completion-checklist.md to the {{ api }} API implementation and then add any additional suggestions you have to the same @schematic/docs/{{ TODAY }}-review-of-{{ api }}.md document. Remember that this is a non-interactive process so avoid asking questions and just complete the task."

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo -e "Staging all {{ BOLD }}modified{{ RESET }} or {{ BOLD }}untracked{{ RESET }} files for the {{ PACKAGE }} package area."
    @echo ""
    @git add .
    @echo ""
    @echo "Files have been added"
    @echo
    @sniff git --package "{{ PACKAGE }}"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just _play select-4
    @echo -e "All committed files from {{ BOLD }}{{ PACKAGE }}{{ RESET }} have now been pushed to remote."
    @echo

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{ DEFINE }}*:"

readme:
    _readme_files schematic

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} >/dev/null || true
