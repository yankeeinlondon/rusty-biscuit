set dotenv-load
set positional-arguments

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Schematic"
SCHEMATIC := lowercase(PACKAGE)
DEFINE_NAME := PACKAGE + " Define Library"
DEFINE := SCHEMATIC + "/define"
GEN_NAME := PACKAGE + " Gen Library"
GEN := SCHEMATIC + "/gen"
SCHEMA_NAME := PACKAGE + " Schema Library"
SCHEMA := SCHEMATIC + "/schema"

DOCS := "@schematic/docs/io/openapi-extensions.md @schematic/docs/json-schema/deep-dive.md "

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Schematic Package"
        echo "=================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build schematic packages (define, definitions, gen)
build *args="":
    @echo ""
    @echo "Build Schematic Packages"
    @echo "------------------------"
    @echo ""
    @cargo build -p schematic-define -p schematic-definitions -p schematic-gen {{args}}

# run tests for schematic packages
test *args="":
    @echo ""
    @echo "Testing Schematic Packages"
    @echo "--------------------------"
    @echo ""
    @cargo test -p schematic-define -p schematic-definitions -p schematic-gen {{args}}

# run clippy on schematic packages
lint:
    @echo ""
    @echo "Linting Schematic Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p schematic-define -- -D warnings
    @cargo clippy -p schematic-definitions -- -D warnings
    @cargo clippy -p schematic-gen -- -D warnings

# generate OpenAI API client code (dry-run preview)
generate-dry-run:
    @echo ""
    @echo "Generating Code (Dry Run)"
    @echo "-------------------------"
    @echo ""
    @cargo run -p schematic-gen -- --api openai --dry-run

# generate all API clients to schematic/schema
generate:
    @echo ""
    @echo "Generating All API Clients"
    @echo "--------------------------"
    @echo ""
    @cargo run -p schematic-gen -- --api all --output schema/src -v

# generate a single API client to schematic/schema
generate-one api:
    @echo ""
    @echo "Generating {{api}} API Client"
    @echo "------------------------------"
    @echo ""
    @cargo run -p schematic-gen -- --api {{api}} --output schema/src -v

# generate all API clients and OpenAPI specs
generate-openapi:
    @echo ""
    @echo "Generating API Clients + OpenAPI Specs"
    @echo "---------------------------------------"
    @echo ""
    @mkdir -p openapi
    @cargo run -p schematic-gen -- generate --api all --output schema/src --openapi-out openapi -v

# export OpenAPI specs only (no code generation)
export-openapi api="openai" format="json":
    @echo ""
    @echo "Exporting OpenAPI Spec for {{api}}"
    @echo "-----------------------------------"
    @echo ""
    @mkdir -p openapi
    @cargo run -p schematic-gen -- generate --api {{api}} --output schema/src --openapi-out openapi --openapi-format {{format}} -v

# build, install CLI, generate schemas, and verify
install:
    @echo ""
    @echo "Installing {{BOLD}}{{YELLOW}}Schematic{{RESET}}"
    @echo "--------------------"
    @echo ""
    @echo "{{BOLD}}Building schematic packages (release){{RESET}}"
    @cargo build --release -p schematic-define -p schematic-definitions -p schematic-gen  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}Installing schematic-gen CLI{{RESET}}"
    @cargo install --path gen --locked  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}Generating all API clients{{RESET}}"
    @cargo run --release -p schematic-gen -- --api all --output schema/src -v  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}Verifying generated code compiles{{RESET}}"
    @cargo check -p schematic-schema  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BLUE}}{{BOLD}}Schematic installed successfully!{{RESET}}"
    @echo ""
    @playa effect drop-4 2>/dev/null || return 0

# clean generated schema code
clean-generated:
    @echo ""
    @echo "Cleaning Generated Code"
    @echo "-----------------------"
    @echo ""
    @rm -rf schema/src
    @rm -f schema/Cargo.toml
    @echo "Cleaned schema/"

# full workflow: generate and verify compilation
full: generate
    @echo ""
    @echo "Verifying Generated Code"
    @echo "------------------------"
    @echo ""
    @cargo check --manifest-path schema/Cargo.toml
    @echo ""
    @echo "Generation complete and verified!"

# run slow E2E tests (compiles generated code)
test-e2e:
    @echo ""
    @echo "Running E2E Tests"
    @echo "-----------------"
    @echo ""
    @cargo test -p schematic-gen --test e2e_generation -- --ignored

# build and show the docs for the library code
docs:
    @echo "Documentation for Schematic packages"
    @echo ""
    @cargo doc --workspace --no-deps --open

release:
    @just lint
    @just test-e2e
    @just just build --release
    @just just full
    @just docs


# Use GPT 5.2 to commit staged changes
commit:
    @cd .. && opencode run commit "-f" --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in {{BOLD}}rusty-biscuit{{RESET}} monorepo"; \
    fi

# Open Claude Code in yolo mode
oc *args="":
    @clear
    @echo -e "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && opencode {{args}}

# Open Opencode
cc *args="":
    @clear
    @echo -e "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Open Codex CLI
codex *args="":
    @clear
    @echo -e "Loading {{BOLD}}Codex CLI{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && codex --dangerously-bypass-approvals-and-sandbox {{args}}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{DEFINE}}*:"

readme_files:
    @sniff docs --readme --json | jq -r '[.[] | select(.relative | startswith("{{DEFINE}}")) | "@" + .relative ] | join(" ")'

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}{{DEFINE_NAME}}{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the {{DEFINE_NAME}} package; use the rust, {{DEFINE}}, biscuit-terminal, and clap skills during the review. Write your findings to the file '@{{DEFINE}}/docs/{YYYY}-{MM}. {{DEFINE}}-review.md' (where YYYY is the current year, and MM is the current month).\n\n$(just deps)\n\n{{args}}"  || ( so-you-say "There was a problem running the code review in the {{DEFINE_NAME}} package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the {{DEFINE_NAME}} review."  && exit 1 )
    @echo
    @echo -e "Code Review for the {{BLUE}}{{DEFINE_NAME}}{{RESET}} package has completed"
    @just _speak "Review for {{DEFINE_NAME}} package has completed."


TODAY := `date +%F`
# the temp file for the documents prompt
DOCS_PROMPT := "../.ai/logs/" + TODAY + ". docs_prompt_for_" + SCHEMATIC + "_docs_prompt.md"
# the temp file for the skills prompt
SKILL_PROMPT := "../.ai/logs/" + TODAY + ". skill_prompt_for_" + SCHEMATIC + "_skill_prompt.md"
# the captured summary from the docs refresh step
DOCS_SUMMARY := "../.ai/logs/" + TODAY +  ". doc_update_summary_for_" + SCHEMATIC + "_docs_summary.md"

# Render the documentation refresh prompt template.
#
# Placeholder keys in the template: DOCS, ARGS, LIBRARY, CLI, LIB_NAME, DEPS
_docs_prompt TEMPLATE DOCS ARGS LIBRARY CLI LIB_NAME DEPS:
    #!/usr/bin/env bash
    set -euo pipefail
    TEMPLATE_CONTENT="$(cat "{{TEMPLATE}}")"
    DOCS_VALUE={{quote(DOCS)}}
    ARGS_VALUE={{quote(ARGS)}}
    LIBRARY_VALUE={{quote(LIBRARY)}}
    CLI_VALUE={{quote(CLI)}}
    LIB_NAME_VALUE={{quote(LIB_NAME)}}
    DEPS_VALUE={{quote(DEPS)}}
    OPEN=$'\x7b\x7b'
    CLOSE=$'\x7d\x7d'
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DOCS${CLOSE}/${DOCS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}ARGS${CLOSE}/${ARGS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIBRARY${CLOSE}/${LIBRARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}CLI${CLOSE}/${CLI_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIB_NAME${CLOSE}/${LIB_NAME_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DEPS${CLOSE}/${DEPS_VALUE}}"
    mkdir -p "$(dirname "{{DOCS_PROMPT}}")"
    printf '%s\n' "$TEMPLATE_CONTENT" > "{{DOCS_PROMPT}}"

# Render the skill refresh prompt template.
#
# Placeholder keys in the template: LIBRARY, LIB_NAME, DOCS, SUMMARY, ARGS
_skill_prompt TEMPLATE LIBRARY LIB_NAME DOCS SUMMARY_FILE ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    TEMPLATE_CONTENT="$(cat "{{TEMPLATE}}")"
    LIBRARY_VALUE={{quote(LIBRARY)}}
    LIB_NAME_VALUE={{quote(LIB_NAME)}}
    DOCS_VALUE={{quote(DOCS)}}
    ARGS_VALUE={{quote(ARGS)}}
    SUMMARY_VALUE="$(cat "{{SUMMARY_FILE}}")"
    OPEN=$'\x7b\x7b'
    CLOSE=$'\x7d\x7d'
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIBRARY${CLOSE}/${LIBRARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIB_NAME${CLOSE}/${LIB_NAME_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DOCS${CLOSE}/${DOCS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}SUMMARY${CLOSE}/${SUMMARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}ARGS${CLOSE}/${ARGS_VALUE}}"
    mkdir -p "$(dirname "{{SKILL_PROMPT}}")"
    printf '%s\n' "$TEMPLATE_CONTENT" > "{{SKILL_PROMPT}}"

_refresh_docs *args="":
    @echo >&2
    @echo -e "🏃 starting the refresh of the {{ITALIC}}documents{{RESET}} in {{BOLD}}{{PACKAGE}}{{RESET}}: {{DIM}}$(just readme_files) {{DOCS}} {{args}}{{RESET}}" >&2
    @just _docs_prompt "../.ai/prompts/refresh_documentation.md" "$(just readme_files)" "{{args}}" "{{DEFINE}}" "{{CLI}}" "{{DEFINE_NAME}}" "$(just deps)"
    @echo -e "{{DIM}}- prompt stored at {{BLUE}}{{DOCS_PROMPT}}{{RESET}}" >&2
    @just _claude_file "{{DOCS_PROMPT}}"


_refresh_skill SUMMARY_FILE *args:
    @just _speak "The documentation files for {{PACKAGE}} were updated and now we're starting the update of the skill files"
    @echo >&2
    @echo -e "🏃 starting the update of the {{ITALIC}}skill files{{RESET}} for {{BOLD}}{{PACKAGE}}{{RESET}}" >&2
    @echo >&2
    @just _skill_prompt "../.ai/prompts/agent-skills.md" "{{DEFINE}}" "{{DEFINE_NAME}}" "$(just readme_files)" "{{SUMMARY_FILE}}" "{{args}}"
    @echo -e "{{DIM}}- prompt stored at {{BLUE}}{{SKILL_PROMPT}}{{RESET}}" >&2
    @just _claude_file "{{SKILL_PROMPT}}"

# fix documentation drift and update the skill
drift *args="":
    @echo
    @echo -e "Refreshing the {{BOLD}}{{SCHEMATIC}}{{RESET}} {{BLUE}}skill{{RESET}}"
    @echo
    @echo -e "- this will be done by updating all of the README.md files in the repo ({{DIM}}{{ITALIC}}as well as any files{{RESET}}"
    @echo -e "  {{DIM}}{{ITALIC}}passed in by caller{{RESET}})"
    @echo -e "- once the {{ITALIC}}drift{{RESET}} of the documentation files has been eliminated we'll rework the {{BOLD}}skill{{RESET}} files"
    @echo -e "- as a final step, we'll look at whether the {{BOLD}}CLAUDE.md{{RESET}} file would benefit from being updated"
    @echo -e "  based on the changes made\n"

    @DOC_SUMMARY_FILE="{{DOCS_SUMMARY}}" && mkdir -p "$(dirname "$DOC_SUMMARY_FILE")" && just _refresh_docs {{args}} > "$DOC_SUMMARY_FILE" && just _refresh_skill "$DOC_SUMMARY_FILE" "{{args}}"


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
