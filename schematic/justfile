set dotenv-load
set positional-arguments
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]


BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

TODAY := `date +%F`

PACKAGE := "Schematic"
SCHEMATIC := lowercase(PACKAGE)
DEFINE_NAME := PACKAGE + " Define Library"
DEFINE := SCHEMATIC + "-define"
GEN_NAME := PACKAGE + " Gen Library"
GEN := SCHEMATIC + "-gen"
SCHEMA_NAME := PACKAGE + " Schema Library"
SCHEMA := SCHEMATIC + "-schema"

DOCS := "@schematic/docs/io/openapi-extensions.md @schematic/docs/json-schema/deep-dive.md "


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Schematic Package"
        echo "=================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

# play a sound effect if `playa` CLI is installed (never errors)
_play effect background="":
    @playa "{{effect}}" "{{background}}" >/dev/null 2>&1 || exit 0

_notify message title=PACKAGE:
    #!/usr/bin/env bash
    if command -v osascript &> /dev/null; then
        osascript -e 'display notification "message" with title "{{title}}"'
    elif command -v notify-send &> /dev/null; then
        notify-send '{{message}}'
    fi

_ask_opencode prompt:
    #!/usr/bin/env bash
    if command -v opencode &> /dev/null; then
        local MODEL
        MODEL="${MODEL:-minimax/MiniMax-M2.5-highspeed}"
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}using the {{BOLD}}${MODEL}{{DIM}} model with {{BOLD}}OpenCode CLI{{DIM}}.{{RESET}}"
        echo -e "{{DIM}}{{ITALIC}}- you can choose a different model by setting the {{BOLD}}MODEL{{DIM}} env variable"
        echo
        opencode run "{{prompt}}" --model "$MODEL"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}OpenCode{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}OpenCode{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_claude prompt:
    #!/usr/bin/env bash
    if command -v claude &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Claude Code{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        unset ANTHROPIC_API_KEY && claude -p "{{prompt}}"
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Claude{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_codex prompt:
    #!/usr/bin/env bash
    if command -v codex &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Codex CLI{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        codex exec "{{prompt}}"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}Codex CLI{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Codex{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi


# use an AI agent to respond to a question (uses `AGENT`)
ask prompt:
    #!/usr/bin/env bash
    if [[ "${AGENT,,}" == "opencode" ]]; then
        just _ask_opencode "{{prompt}}" || ( echo -e "- OpenCode failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    elif [[ "${AGENT,,}" == "codex"  ]]; then
        just _ask_codex "{{prompt}}" || ( echo -e "- Codex failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    else
        just _ask_claude "{{prompt}}" || ( echo -e "- will try using Opencode instead ..." && just _ask_opencode "{{prompt}}" || exit 1 )
    fi


# build schematic packages (define, definitions, gen)
build *args="":
    @echo ""
    @echo "Build Schematic Packages"
    @echo "------------------------"
    @echo ""
    @cargo build -p schematic-define -p schematic-definitions -p schematic-gen {{args}}

# run tests for schematic packages
test *args="":
    @echo ""
    @echo "Testing Schematic Packages"
    @echo "--------------------------"
    @echo ""
    @cargo test -p schematic-define -p schematic-definitions -p schematic-gen {{args}}

# check for artifact drift (run after making definition changes)
check-drift:
    @echo ""
    @echo "Checking Artifact Drift"
    @echo "-----------------------"
    @echo ""
    @cargo test -p schematic-gen artifact_drift -- --ignored

# run clippy on schematic packages
lint:
    @echo ""
    @echo "Linting Schematic Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p schematic-define -- -D warnings
    @cargo clippy -p schematic-definitions -- -D warnings
    @cargo clippy -p schematic-gen -- -D warnings

# generate OpenAI API client code (dry-run preview)
generate-dry-run:
    @echo ""
    @echo "Generating Code (Dry Run)"
    @echo "-------------------------"
    @echo ""
    @cargo run -p schematic-gen -- --api openai --dry-run

# generate all API clients to schematic/schema
generate:
    @echo ""
    @echo "Generating All API Clients"
    @echo "--------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --openapi-out openapi --postman-out postman -v
    @just _notify "The Schematic definitions in schematic-definitions were generated to schematic-schema"


# generate a single API client to schematic/schema
generate-one api:
    @echo ""
    @echo "Generating {{api}} API Client"
    @echo "------------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api {{api}} --output schema/src \
        --openapi-out openapi --postman-out postman -v

# generate only OpenAPI specs (no Postman)
generate-openapi:
    @echo ""
    @echo "Generating OpenAPI Specs"
    @echo "------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --openapi-out openapi --no-postman -v

# generate only Postman collections (no OpenAPI)
generate-postman:
    @echo ""
    @echo "Generating Postman Collections"
    @echo "------------------------------"
    @echo ""
    @cargo run -p schematic-gen -- generate --api all --output schema/src \
        --postman-out postman --no-openapi -v


# build, install CLI, generate schemas, and verify
install:
    @echo ""
    @echo -e "Installing {{BOLD}}{{YELLOW}}Schematic{{RESET}}"
    @echo "--------------------"
    @echo ""
    @echo -e "{{BOLD}}Building schematic packages (release){{RESET}}"
    @cargo build --release -p schematic-define -p schematic-definitions -p schematic-gen  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}Installing schematic-gen CLI{{RESET}}"
    @cargo install --path gen --locked  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}Generating all API clients{{RESET}}"
    @cargo run --release -p schematic-gen -- --api all --output schema/src -v  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}Verifying generated code compiles{{RESET}}"
    @cargo check -p schematic-schema  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{BLUE}}{{BOLD}}Schematic installed successfully!{{RESET}}"
    @echo ""
    @just _play drop-4 --background

# clean generated schema code
clean-generated:
    @echo ""
    @echo "Cleaning Generated Code"
    @echo "-----------------------"
    @echo ""
    @rm -rf schema/src
    @rm -f schema/Cargo.toml
    @echo "Cleaned schema/"

# full workflow: generate and verify compilation
full: generate
    @echo ""
    @echo "Verifying Generated Code"
    @echo "------------------------"
    @echo ""
    @cargo check --manifest-path schema/Cargo.toml
    @echo ""
    @echo "Generation complete and verified!"

# run slow E2E tests (compiles generated code)
test-e2e:
    @echo ""
    @echo "Running E2E Tests"
    @echo "-----------------"
    @echo ""
    @cargo test -p schematic-gen --test e2e_generation -- --ignored

# build and show the docs for the library code
docs:
    @echo "Documentation for Schematic packages"
    @echo ""
    @cargo doc --workspace --no-deps --open
    @just _speak "Documentation for {{PACKAGE}} was built";

release:
    @just lint
    @just test-e2e
    @just build --release
    @just full
    @just docs

# Provides a two-step review of an API defined in Schematic
review-api api design:
    @echo ""
    @echo "Review the {{BOLD}}{{api}}{{RESET}} API in schematic"
    @echo "{{DIM}}{{ITALIC}}- review file located at {{BLUE}}./docs/{{TODAY}}-review-of-{{api}}.md{{RESET}}"
    @touch "./docs/{{TODAY}}-review-of-{{api}}.md"
    @claudine gemini --ni "Your task is to review the {{api}} API definition(s) which are defined in the schematic-definitions as well the generated API clients for {{api}} API's in schematic-schema. Keep in mind the best practices for API definitions found in @schematic/skill/best-practices-in-designing-an-api.md . Also review the original design document found at @schematic/docs/{{design}} . Look for for all opportunities to improve the ergonomics and/or performance of the code. Also look at the quality of documentation and ensure that it's high quality in both the schematic-definitions package but that the generated API client in schematic-schema is fully documented. Make sure that this API also exports a valid OpenAPI definition as part of the generation step. Write all your recommendations to @schematic/docs/{{TODAY}}-review-of-{{api}}.md . Remember that this is a non-interactive process so avoid asking questions and just complete the task."
    @echo
    @echo "First Stage of Review is Complete. Now will validate that Completion Steps have been completed."
    @echo
    @claudine gem --ni "A review on the {{api}} API in schematic was performed and produced the suggestions found in @schematic/docs/{{TODAY}}-review-of-{{api}}.md ; your task is to apply the completion checklist found in @schematic/skill/completion-checklist.md to the {{api}} API implementation and then add any additional suggestions you have to the same @schematic/docs/{{TODAY}}-review-of-{{api}}.md document. Remember that this is a non-interactive process so avoid asking questions and just complete the task."


# commits all the staged changes using MiniMax M2.5-highspeed model in OpenCode
commit:
    @echo ""
    @echo -e "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo -e "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.5-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @claudine opencode -n "evaluate all the staged commits in the repo and then group them by scope (e.g., $(sniff repo packages)) and operation (e.g., fix, docs, chore, feat, refactor, style, perf, test, ci) and then commit each group separately using the conventional commit naming conventions with a well thought out commit message. Note: there are two cases where it's ok to have no 'scope' (aka, package) associated to a commit message:\n1. If the change appears to have no relationship to any particular package in the monorepo.\n2. If there are bunch of small changes which are all related to the same underlying event or cause and the changes do not touch any source code then it's possible to group them all into one commit which has no scope specified. Note: the action 'refactor' should be reserved for commits which have at least some source code files.\nIf no files are staged for commit then communicate this to the user and exit. Note: make sure NOT to commit everything as one commit. You are committing files in groups. IMPORTANT: remember that you are running in a non-interactive mode so you can not ask the user questions and expect a reply! DO NOT PUSH COMMITS TO THE ORIGIN." --op "commit"
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff git 2>/dev/null || exit 0

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo -e "Staging all {{BOLD}}modified{{RESET}} or {{BOLD}}untracked{{RESET}} files for the {{PACKAGE}} package area."
    @echo ""
    @git add .
    @echo ""
    @echo "Files have been added"
    @echo
    @sniff git --package "{{PACKAGE}}"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just _play select-4
    @echo -e "All committed files from {{BOLD}}{{PACKAGE}}{{RESET}} have now been pushed to remote."
    @echo

# Open Opencode in yolo mode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{args}}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{args}}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{args}}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{args}}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{DEFINE}}*:"

readme_files:
    @sniff docs --readme --json | jq -r '[.[] | select(.relative | startswith("{{DEFINE}}")) | "@" + .relative ] | join(" ")'

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}{{DEFINE_NAME}}{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the {{DEFINE_NAME}} package; use the rust, {{DEFINE}}, biscuit-terminal, and clap skills during the review. Write your findings to the file '@{{DEFINE}}/docs/{YYYY}-{MM}. {{DEFINE}}-review.md' (where YYYY is the current year, and MM is the current month).\n\n$(just deps)\n\n{{args}}"  || ( so-you-say "There was a problem running the code review in the {{DEFINE_NAME}} package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the {{DEFINE_NAME}} review."  && exit 1 )
    @echo
    @echo -e "Code Review for the {{BLUE}}{{DEFINE_NAME}}{{RESET}} package has completed"
    @just _speak "Review for {{DEFINE_NAME}} package has completed."


# the temp file for the documents prompt
DOCS_PROMPT := "../.ai/logs/" + TODAY + ". docs_prompt_for_" + SCHEMATIC + "_docs_prompt.md"
# the temp file for the skills prompt
SKILL_PROMPT := "../.ai/logs/" + TODAY + ". skill_prompt_for_" + SCHEMATIC + "_skill_prompt.md"


# Render the documentation refresh prompt template.
#
# Placeholder keys in the template: DOCS, ARGS, LIBRARY, CLI, LIB_NAME, DEPS
_docs_prompt TEMPLATE DOCS ARGS LIBRARY CLI LIB_NAME DEPS:
    #!/usr/bin/env bash
    set -euo pipefail
    TEMPLATE_CONTENT="$(cat "{{TEMPLATE}}")"
    DOCS_VALUE={{quote(DOCS)}}
    ARGS_VALUE={{quote(ARGS)}}
    LIBRARY_VALUE={{quote(LIBRARY)}}
    CLI_VALUE={{quote(CLI)}}
    LIB_NAME_VALUE={{quote(LIB_NAME)}}
    DEPS_VALUE={{quote(DEPS)}}
    OPEN=$'\x7b\x7b'
    CLOSE=$'\x7d\x7d'
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DOCS${CLOSE}/${DOCS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}ARGS${CLOSE}/${ARGS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIBRARY${CLOSE}/${LIBRARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}CLI${CLOSE}/${CLI_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIB_NAME${CLOSE}/${LIB_NAME_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DEPS${CLOSE}/${DEPS_VALUE}}"
    mkdir -p "$(dirname "{{DOCS_PROMPT}}")"
    printf '%s\n' "$TEMPLATE_CONTENT" > "{{DOCS_PROMPT}}"

# Render the skill refresh prompt template.
#
# Placeholder keys in the template: LIBRARY, LIB_NAME, DOCS, SUMMARY, ARGS
_skill_prompt TEMPLATE LIBRARY LIB_NAME DOCS SUMMARY_FILE ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    TEMPLATE_CONTENT="$(cat "{{TEMPLATE}}")"
    LIBRARY_VALUE={{quote(LIBRARY)}}
    LIB_NAME_VALUE={{quote(LIB_NAME)}}
    DOCS_VALUE={{quote(DOCS)}}
    ARGS_VALUE={{quote(ARGS)}}
    SUMMARY_VALUE="$(cat "{{SUMMARY_FILE}}")"
    OPEN=$'\x7b\x7b'
    CLOSE=$'\x7d\x7d'
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIBRARY${CLOSE}/${LIBRARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}LIB_NAME${CLOSE}/${LIB_NAME_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}DOCS${CLOSE}/${DOCS_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}SUMMARY${CLOSE}/${SUMMARY_VALUE}}"
    TEMPLATE_CONTENT="${TEMPLATE_CONTENT//${OPEN}ARGS${CLOSE}/${ARGS_VALUE}}"
    mkdir -p "$(dirname "{{SKILL_PROMPT}}")"
    printf '%s\n' "$TEMPLATE_CONTENT" > "{{SKILL_PROMPT}}"

_refresh_docs *args="":
    @echo >&2
    @echo -e "🏃 starting the refresh of the {{ITALIC}}documents{{RESET}} in {{BOLD}}{{PACKAGE}}{{RESET}}: {{DIM}}$(just readme_files) {{DOCS}} {{args}}{{RESET}}" >&2
    @just _docs_prompt "../.ai/prompts/refresh_documentation.md" "$(just readme_files)" "{{args}}" "{{DEFINE}}" "{{SCHEMATIC}}" "{{DEFINE_NAME}}" "$(just deps)"
    @echo -e "{{DIM}}- prompt stored at {{BLUE}}{{DOCS_PROMPT}}{{RESET}}" >&2
    @just _claude_file "{{DOCS_PROMPT}}"


_refresh_skill SUMMARY_FILE *args:
    @just _speak "The documentation files for {{PACKAGE}} were updated and now we're starting the update of the skill files"
    @echo >&2
    @echo -e "🏃 starting the update of the {{ITALIC}}skill files{{RESET}} for {{BOLD}}{{PACKAGE}}{{RESET}}" >&2
    @echo >&2
    @just _skill_prompt "../.ai/prompts/agent-skills.md" "{{DEFINE}}" "{{DEFINE_NAME}}" "$(just readme_files)" "{{SUMMARY_FILE}}" "{{args}}"
    @echo -e "{{DIM}}- prompt stored at {{BLUE}}{{SKILL_PROMPT}}{{RESET}}" >&2
    @just _claude_file "{{SKILL_PROMPT}}"

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}{{SCHEMATIC}}{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- {{SCHEMATIC}} {{DOCS}} {{args}}
    @_speak "the drift recipe for the {{PACKAGE}} package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."




# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
