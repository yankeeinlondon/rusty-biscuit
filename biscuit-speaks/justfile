set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Biscuit Speaks"
LIBRARY := replace(lowercase(PACKAGE), " ", "-")
CLI := replace(lowercase(PACKAGE) + "-cli", " ", "-")


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    else
      echo
      echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
      echo "======================================================================================"
      echo ""
    fi

    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build biscuit-speaks "Biscuit Speaks Library" {{args}}
    @just _build biscuit-speaks-cli "Biscuit Speaks CLI" {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# `--features playa` on the library throughout: `default = []`, so the whole
# playback path and its 23 tests (357 of 380) are cfg'd out of a default-feature
# run. Its two in-repo consumers — biscuit-speaks-cli (the shipped `so-you-say`
# binary) and claudine — both enable it, so the default set is a configuration
# nobody ships. The feature costs no audio device: playa's own `default = []`,
# and biscuit-speaks asks only for `playa/async`, so no rodio/CoreAudio/ALSA
# backend is compiled in.

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "biscuit-speaks --features playa; biscuit-speaks-cli"

# Test both library and CLI.
test *args="":
    @just _test_all "biscuit-speaks --features playa; biscuit-speaks-cli" {{args}}

# not applicable: biscuit-speaks has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for biscuit-speaks"

# not applicable: biscuit-speaks has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-speaks"

# not applicable: biscuit-speaks emits audio, not HTML
test-browser:
    @echo "test-browser: not applicable for biscuit-speaks"

# Real-resource TTS provider tests. Skip-clean when provider credentials absent.
test-real *args="":
    @just _test_real biscuit-speaks {{args}}
    @just _test_real biscuit-speaks-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint biscuit-speaks
    @just _lint biscuit-speaks-cli

# not applicable: no criterion benches (audio synthesis is provider-bound)
bench:
    @echo "bench: not applicable for biscuit-speaks"

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage biscuit-speaks --features playa {{args}}
    @just _coverage biscuit-speaks-cli {{args}}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest biscuit-speaks --features playa {{args}}
    @just _doctest biscuit-speaks-cli {{args}}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for biscuit-speaks"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint biscuit-speaks || just _fix_lint biscuit-speaks
    @just _lint biscuit-speaks-cli || just _fix_lint biscuit-speaks-cli


# Install the CLI
install *args="":
    @just build --release
    @just _install "./cli" "Biscuit Speaks" {{args}}

# Validate the source code without doing a full build
check:
    @cargo check -p {{LIBRARY}} -p {{CLI}}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{CLI}} {{args}}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{LIBRARY}}*:"

readme:
    _readme_files claudine



# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
