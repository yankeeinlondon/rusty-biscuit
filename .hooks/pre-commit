#!/usr/bin/env bash
#
# Pre-commit hook: run doctests for any workspace crate that has staged .rs changes.
# Catches broken doc examples before they land.
#
set -euo pipefail

# Collect package names from staged .rs files
declare -A packages

for file in $(git diff --cached --name-only --diff-filter=ACM -- '*.rs'); do
    # Walk up from the file to find the nearest Cargo.toml
    dir="$(dirname "$file")"
    while [[ "$dir" != "." && "$dir" != "/" ]]; do
        if [[ -f "$dir/Cargo.toml" ]]; then
            # Extract package name from Cargo.toml
            pkg=$(grep -m1 '^name' "$dir/Cargo.toml" | sed 's/.*= *"\(.*\)"/\1/')
            if [[ -n "$pkg" ]]; then
                packages["$pkg"]=1
            fi
            break
        fi
        dir="$(dirname "$dir")"
    done
done

if [[ ${#packages[@]} -eq 0 ]]; then
    exit 0
fi

echo "Running doctests for changed crates: ${!packages[*]}"

for pkg in "${!packages[@]}"; do
    if ! cargo test --doc -p "$pkg" 2>&1; then
        echo ""
        echo "ERROR: doctests failed for $pkg"
        echo "Fix the doc examples before committing."
        exit 1
    fi
done
