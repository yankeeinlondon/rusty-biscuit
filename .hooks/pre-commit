#!/usr/bin/env bash
#
# Pre-commit hook: run doctests for dirty package areas.
# Delegates to `just doctest` with areas from `sniff repo --dirty-package-areas`.
#
set -euo pipefail

# Only run if staged .rs files exist
if ! git diff --cached --name-only --diff-filter=ACM -- '*.rs' | grep -q .; then
    exit 0
fi

dirty=$(sniff repo --dirty-package-areas 2>/dev/null || true)
if [[ -z "$dirty" ]]; then
    exit 0
fi

echo "Running doctests for dirty areas: $dirty"
just doctest $dirty || {
    echo ""
    echo "ERROR: doctests failed. Fix the doc examples before committing."
    exit 1
}
