set dotenv-load := true
set positional-arguments := true

# set allow-duplicate-recipes

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/spec.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
PACKAGE := "Messenger"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build messenger "Messenger" {{ args }}
    @just _build messenger-cli "Messenger CLI" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
#
# `--features desktop` for the library only: messenger's default feature set
# omits the desktop implementation its test contract covers (the same
# special case `_test_workspace` encodes for the root `just test`).
sanity:
    @just _sanity_all "messenger --features desktop; messenger-cli"

# Test both library and CLI
test *args="":
    @just _test_all "messenger --features desktop; messenger-cli" {{ args }}

# not applicable: messenger has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for messenger"

# not applicable: messenger has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for messenger"

# not applicable: messenger renders Markdown for providers, not for a browser
test-browser:
    @echo "test-browser: not applicable for messenger"

# not applicable: messenger has no real-resource tier — provider transports are
# covered by stub binaries and wiremock, never by a live account
test-real:
    @echo "test-real: not applicable for messenger"

# Lint both the library and CLI
lint:
    @echo "Linting {{ BOLD }}messenger{{ RESET }} (features: desktop)"
    @cargo clippy -p messenger --features desktop --all-targets -- -D warnings
    @just _lint messenger-cli

# not applicable: messenger has no criterion benches
bench:
    @echo "bench: not applicable for messenger"

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage {{ LIBRARY }} {{ args }}
    @just _coverage {{ CLI }} {{ args }}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest {{ LIBRARY }} --features desktop {{ args }}
    @just _doctest {{ CLI }} {{ args }}

# not applicable: messenger has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for messenger"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

lint-fix:
    @cargo clippy -p messenger --features desktop --all-targets -- -D warnings || just _lint_fix messenger
    @just _lint messenger-cli || just _lint_fix messenger-cli

# Install the CLI (enables native playback on macOS/Windows; Linux requires libasound2-dev)
install *args="":
    @just build
    @just _install "./cli" "Messenger" "{{ args }}"

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo "Staging all {{ BOLD }}modified{{ RESET }} or {{ BOLD }}untracked{{ RESET }} files for the {{ PACKAGE }} package area."
    @echo ""
    @git add .
    @echo ""
    @echo "Files have been added"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just _play select-4
    @echo "All committed files from {{ BOLD }}{{ PACKAGE }}{{ RESET }} have now been pushed to remote."
    @echo

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{ LIBRARY }}*:"

# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
