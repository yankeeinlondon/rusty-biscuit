set dotenv-load
set positional-arguments
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"
import "../just/lifecycle.just"
import "../just/review.just"
import "../just/plan.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'

LIBRARY := "biscuit-tui"
CLI := "biscuit-tui-cli"
CLI_PATH := "./cli"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi
    echo "biscuit-tui Library & CLI (binary: question)"
    echo "==========================================="
    echo
    just --list | grep -v 'default'

# build library and CLI
build *args="":
    @just _build {{LIBRARY}} "biscuit-tui Library" {{args}}
    @just _build {{CLI}} "biscuit-tui CLI" {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "{{LIBRARY}} {{CLI}}"

# Full L1 suite for library and CLI.
test *args="":
    @just _test_all "{{LIBRARY}} {{CLI}}" {{args}}

# Level-2 (real-terminal) tests for the CLI. Library has no L2 tests.
#
# By default, missing harnesses (WezTerm / Kitty / tmux) cause individual
# tests to skip cleanly. Set `BISCUIT_TEST_LEVEL_REQUIRED=2` in the
# environment to convert missing harnesses into hard failures (CI use).
test-l2 *args="":
    @echo
    @echo -e "Running {{BOLD}}Level-2{{RESET}} real-terminal tests"
    @echo -e "{{DIM}}- export BISCUIT_TEST_LEVEL_REQUIRED=2 to hard-fail on missing harness{{RESET}}"
    @echo
    @just _test_l2 {{CLI}} {{args}}

# Level-3 OS-keyboard-injection tests for the CLI. Library has no L3 tests.
#
# The shared `_test_l3` recipe exports RUN_LEVEL3=1 so the `require_level!` gate
# trips; each test also skips cleanly when its backend (WezTerm + cliclick,
# macOS only) is absent. Covers physical Ctrl+Shift / Alt+Shift chord selection
# for choose-one and choose-many (`level3_chord_select.rs`) — the always-on L2
# byte-injection tests in `real_terminal_render.rs` remain the headless
# contract; L3 is the opt-in physical-keypress proof. These steal desktop focus,
# so they are intentionally NOT part of `test`/`all`.
test-l3 *args="":
    @just _test_l3 {{CLI}} {{args}}

# Windows-host runtime gate for F2 captured-stdout parity. Runs the ignored,
# deterministic console-boundary integration test by exact name; it must execute
# on a Windows host with an attached console (the test injects Enter via
# `WriteConsoleInputW`). The CI counterpart is
# `.github/workflows/biscuit-tui-windows-captured-stdout.yml`.
test-windows-captured-stdout:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "${OS:-}" != "Windows_NT" ]; then
        echo "test-windows-captured-stdout must run on a Windows host with an attached console" >&2
        exit 1
    fi
    cargo test -p {{CLI}} --test windows_captured_stdout -- --ignored captured_stdout_receives_only_value_no_tui_bytes

# Not applicable: biscuit-tui has no browser-target tests.
test-browser:
    @echo "test-browser: not applicable for biscuit-tui"

# Not applicable: biscuit-tui has no real-resource (device / network) tier.
test-real:
    @echo "test-real: not applicable for biscuit-tui"

# Lint both the library and CLI
lint:
    @just _lint {{LIBRARY}}
    @just _lint {{CLI}}

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage {{LIBRARY}} {{args}}
    @just _coverage {{CLI}} {{args}}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest {{LIBRARY}} {{args}}
    @just _doctest {{CLI}} {{args}}

# Not applicable: biscuit-tui has no Criterion benches (opted out).
bench:
    @echo "bench: not applicable for biscuit-tui (opted out via package metadata)"

# Not applicable: biscuit-tui has no fuzz targets.
fuzz:
    @echo "fuzz: not applicable for biscuit-tui"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ---------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint {{LIBRARY}} || just _fix_lint {{LIBRARY}}
    @just _lint {{CLI}} || just _fix_lint {{CLI}}

# Run the env-gated PTY/shell verification suites
# (keyboard protocol, completions shell, choose-cli PTY).
# Requires bash + zsh on the host. macOS/Linux only.
test-pty:
    @RUN_PTY_TESTS=1 cargo test -p {{CLI}} --test keyboard_protocol -- --nocapture
    @RUN_SHELL_TESTS=1 cargo test -p {{CLI}} --test completions_shell -- --nocapture
    @QUESTION_INTERACTIVE_PTY=1 cargo test -p {{CLI}} --test choose_cli pty:: -- --nocapture

# install CLI binary
install *args="":
    @just build --release
    @just _install "{{CLI_PATH}}" "biscuit-tui" "question" {{args}}

# Validate the source code without doing a full build
check:
    @cargo check -p {{LIBRARY}} -p {{CLI}}

# build and show the docs for the library code
docs:
    @echo "Build and then show latest docs for the biscuit-tui library code"
    @echo ""
    @cargo doc -p {{LIBRARY}} --open

# run CLI in development mode
cli *args="":
    @cargo run -p {{CLI}} -- {{args}}


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
