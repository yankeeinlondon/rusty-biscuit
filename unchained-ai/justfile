set dotenv-load := true
set positional-arguments := true

# set allow-duplicate-recipes

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "unchained-ai Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build unchained-ai packages (lib, cli, gen, contract)
build *args="":
    @just _build unchained-ai "unchained-ai Library" {{ args }}
    @just _build unchained-ai-contract "unchained-ai Contract Library" {{ args }}
    @just _build unchained-ai-cli "unchained-ai CLI" {{ args }}
    @just _build unchained-ai-gen "unchained-ai Gen" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "unchained-ai unchained-ai-contract unchained-ai-cli unchained-ai-gen model_id"

# Test both library and CLI.
test *args="":
    @just _test_all "unchained-ai unchained-ai-contract unchained-ai-cli unchained-ai-gen model_id" {{ args }}

# not applicable: unchained-ai has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for unchained-ai"

# not applicable: unchained-ai has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for unchained-ai"

# not applicable: unchained-ai does not emit HTML
test-browser:
    @echo "test-browser: not applicable for unchained-ai"

# Live provider-API tests. Skip-clean without credentials.
test-real *args="":
    @just _test_real unchained-ai {{ args }}
    @just _test_real unchained-ai-contract {{ args }}
    @just _test_real unchained-ai-cli {{ args }}
    @just _test_real unchained-ai-gen {{ args }}

# not applicable: no criterion benches (work is provider-bound I/O)
bench:
    @echo "bench: not applicable for unchained-ai"

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage unchained-ai {{ args }}
    @just _coverage unchained-ai-contract {{ args }}
    @just _coverage unchained-ai-cli {{ args }}
    @just _coverage unchained-ai-gen {{ args }}
    @just _coverage model_id {{ args }}

# Doctests.
doctest *args="":
    @just _doctest unchained-ai {{ args }}
    @just _doctest unchained-ai-contract {{ args }}
    @just _doctest unchained-ai-cli {{ args }}
    @just _doctest unchained-ai-gen {{ args }}
    @just _doctest model_id {{ args }}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for unchained-ai"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# run clippy on unchained-ai packages
lint *args="":
    @just _lint unchained-ai {{ args }}
    @just _lint unchained-ai-contract {{ args }}
    @just _lint unchained-ai-cli {{ args }}
    @just _lint unchained-ai-gen {{ args }}

# lint and fix with AI if problems found
lint-fix *args="":
    @just _lint unchained-ai {{ args }} || just _lint_fix unchained-ai
    @just _lint unchained-ai-cli {{ args }} || just _lint_fix unchained-ai-cli
    @just _lint unchained-ai-gen {{ args }} || just _lint_fix unchained-ai-gen

install *args="":
    @just build --release
    @just _install "./cli" "Unchained AI" {{ args }}

check:
    @echo ""
    @echo "Checking unchained-ai Library, Contract, CLI and Gen"
    @echo ""
    @cargo check -p unchained-ai -p unchained-ai-contract -p unchained-ai-cli -p unchained-ai-gen

# Regenerate provider model enums and metadata lookup tables.

# Pass extra args to gen-models, e.g.: just generate-models --providers openai,anthropic
generate-models *args="":
    @echo ""
    @echo -e "{{ BOLD }}Regenerating unchained-ai provider models & metadata{{ RESET }}"
    @echo -e "{{ ITALIC }}Fetching live model lists from provider APIs and metadata from models.dev...{{ RESET }}"
    @echo ""
    @cargo run -p unchained-ai-gen -- -v {{ args }}

# Re-emit the committed model-catalog artifact (offline; see artifacts/README.md)
artifact:
    @cargo run -p unchained-ai-gen --bin emit-catalog

# Outdated packages
outdated:
    @cargo outdated --root-deps-only

# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ YELLOW2 }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} >/dev/null || true
