set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "unchained-ai Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build unchained-ai packages (lib, cli, gen)
build *args="":
    @echo ""
    @echo "Build unchained-ai Packages (Library, CLI, Gen)"
    @echo "---------------------------------------------------"
    @echo ""
    @cargo build -p unchained-ai -p unchained-ai-cli -p unchained-ai-gen {{args}}

# run tests for unchained-ai packages
test *args="":
    @echo ""
    @echo "Testing {{BOLD}}unchained-ai{{RESET}} ({{ITALIC}}Library, CLI, Gen{{RESET}})"
    @echo "-----------------------------------------------"
    @echo ""
    @cargo test -p unchained-ai -p unchained-ai-cli -p unchained-ai-gen {{args}}

# run clippy on unchained-ai packages
lint:
    @echo ""
    @echo "Linting unchained-ai Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p unchained-ai -- -D warnings
    @cargo clippy -p unchained-ai-cli -- -D warnings
    @cargo clippy -p unchained-ai-gen -- -D warnings

install:
    @echo ""
    @echo "{{BOLD}}Building unchained-ai Library{{RESET}}"
    @cargo build -p unchained-ai --release
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing unchained-ai CLI ({{ITALIC}}unchained{{RESET}}{{BOLD}}{{YELLOW}}){{RESET}}"
    @cargo install --path ./cli
    @echo ""
    @echo "{{BOLD}}{{BLUE}}unchained-ai CLI installed{{RESET}}"
    @echo ""

check:
    @echo ""
    @echo "Checking unchained-ai Library, CLI and Gen"
    @echo ""
    @cargo check -p unchained-ai -p unchained-ai-cli -p unchained-ai-gen

# run the unchained CLI in dev mode
cli *args="":
    @cargo run -p unchained-ai-cli -- {{args}}

# run model gen
gen *args="":
    @cargo run -p unchained-ai-gen -- {{args}}

# Open Opencode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && opencode {{args}}

# Open Claude Code in yolo mode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

refresh-skill:
    @clear
    @echo "Refreshing {{BOLD}}unchained-ai{{RESET}} skill"
    @unset ANTHROPIC_API_KEY && cd .. && claude --dangerously-skip-permissions --model opus -p \'"$(cat docs/skills-unchained-ai.md)"\'
