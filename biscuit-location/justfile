set dotenv-load
set positional-arguments
set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

default:
    @echo "biscuit-location Library & CLI"
    @echo "=============================="
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @just _build biscuit-location "Biscuit Location Library" {{args}}
    @just _build biscuit-location-cli "Biscuit Location CLI" {{args}}


# Test both library and CLI.
test *args="":
    @just _test biscuit-location {{args}}
    @just _test biscuit-location-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint biscuit-location
    @just _lint biscuit-location-cli

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint biscuit-location || just _fix_lint biscuit-location
    @just _lint biscuit-location-cli || just _fix_lint biscuit-location-cli

# install CLI binary
install *args="":
    @just build --release
    @just _install "./cli" "Biscuit Location" {{args}}

# build and show the docs for the library code
docs:
    @echo "Build and then show latest docs for the biscuit-location library code"
    @echo ""
    @cargo doc -p biscuit-location --open

# run CLI in development mode
cli *args="":
    @cargo run -p biscuit-location-cli -- {{args}}


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
