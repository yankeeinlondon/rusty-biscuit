set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

default:
    @echo "biscuit-location Library & CLI"
    @echo "=============================="
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @just _build biscuit-location "Biscuit Location Library" {{args}}
    @just _build biscuit-location-cli "Biscuit Location CLI" {{args}}


# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "biscuit-location biscuit-location-cli"

# Test both library and CLI.
test *args="":
    @just _test_all "biscuit-location biscuit-location-cli" {{args}}

# not applicable: biscuit-location has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for biscuit-location"

# not applicable: biscuit-location has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-location"

# not applicable: biscuit-location does not emit HTML
test-browser:
    @echo "test-browser: not applicable for biscuit-location"

# Real-resource tests (MaxMind DB / Nominatim). Skip-clean when resources absent.
test-real *args="":
    @just _test_real biscuit-location {{args}}
    @just _test_real biscuit-location-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint biscuit-location
    @just _lint biscuit-location-cli

# not applicable: no criterion benches yet
bench:
    @echo "bench: not applicable for biscuit-location"

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage biscuit-location {{args}}
    @just _coverage biscuit-location-cli {{args}}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest biscuit-location {{args}}
    @just _doctest biscuit-location-cli {{args}}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for biscuit-location"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint biscuit-location || just _fix_lint biscuit-location
    @just _lint biscuit-location-cli || just _fix_lint biscuit-location-cli

# install CLI binary
install *args="":
    @just build --release
    @just _install "./cli" "Biscuit Location" {{args}}

# build and show the docs for the library code
docs:
    @echo "Build and then show latest docs for the biscuit-location library code"
    @echo ""
    @cargo doc -p biscuit-location --open

# run CLI in development mode
cli *args="":
    @cargo run -p biscuit-location-cli -- {{args}}


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
