#!/bin/sh
# Pre-push hook: a launcher for `ci-push` (`scripts/ci-push.rs`, whose
# decisions live in `repo_deps::ci_push::run`). The shared hooks directory's
# dispatcher (`.githooks/pre-push-dispatcher`) runs this copy from the
# worktree being pushed.
#
# RUSTY_BISCUIT_PRE_PUSH chooses how much of the push is gated: auto (the
# default), scope-only, warn, or strict; `off` is a deprecated alias of
# scope-only. RUSTY_BISCUIT_PRE_PUSH_AREAS narrows the gates to the
# space-separated packages or areas it names.
#
# Only Git's arguments and stdin are passed on, so no shell (Git Bash
# included) rewrites a path on the way. There is deliberately no cached
# binary: Cargo already rebuilds exactly when the sources changed, while a
# binary picked by timestamp can run another checkout's stale code.
set -eu

top="$(git rev-parse --show-toplevel)" || {
    echo "Rusty Biscuit pre-push: cannot resolve the checkout being pushed" >&2
    exit 1
}
cd "$top"
exec cargo run --quiet -p repo-deps --no-default-features --features local-tools --bin ci-push -- "$@"
