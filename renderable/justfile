default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    else
        echo
        echo -e "{{ BOLD }}Renderable Library{{ RESET }}"
        echo "======================================================================================"
    fi
    echo


    just --list | grep -v 'default'
    echo

# Build the Library
build *args="":
    @just _build renderable "Renderable Library" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity renderable

# Test Library
test *args="":
    @just _test renderable {{ args }}

# not applicable: renderable has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for renderable"

# not applicable: renderable has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for renderable"

# not applicable: renderable emits structured data, not HTML
test-browser:
    @echo "test-browser: not applicable for renderable"

# not applicable: renderable has no real-resource tier
test-real:
    @echo "test-real: not applicable for renderable"

# Lint Library
lint:
    @just _lint renderable

# Criterion benches for renderable tree rendering.
bench *args="":
    @just _bench renderable {{ args }}

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage renderable {{ args }}

# Doctests.
doctest *args="":
    @just _doctest renderable {{ args }}

# not applicable: renderable has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for renderable"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint library (and fix)
lint-fix:
    @just _lint renderable || just _fix_lint renderable

# Validate the source code without doing a full build
check:
    @cargo check -p renderable

# the directory structure of both CLI and Library
structure:
    @echo
    @echo "{{ BOLD }}{{ GREEN }}Renderable Library{{ RESET }}"
    @echo
    @just _structure src
    @echo

# produce documentation for renderable (without dependencies)
doc open="false":
    @just _doc renderable "{{ open }}"

# test parity between old and new rendering
parity:
    @echo Parity Test for biscuit-terminal
    @echo
    @cargo run -p biscuit-terminal --example parity
    @echo
    @cargo run -p darkmatter --example parity

layout_matrix:
    @echo Layout Matrix Test for Renderers
    @echo
    @cargo run -p biscuit-terminal --example layout_matrix
    @echo
    @cargo run -p darkmatter --example layout_matrix

# Report tree-vs-bespoke render drift, split by which renderer is correct
drift-report:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    echo -e "{{ BOLD }}Render Drift Report{{ RESET }}"
    echo -e "{{ DIM }}render-tree engine vs bespoke renderer — KNOWN_DRIFT ledger{{ RESET }}"
    echo
    echo -e "{{ DIM }}non-cosmetic = one renderer is semantically/capability correct{{ RESET }}"
    echo -e "{{ DIM }}cosmetic = semantically equivalent drift, such as trailing spaces or equivalent styling encoding{{ RESET }}"
    echo -e "{{ DIM }}neutral/unclassified = cosmetic drift whose preferred renderer has not been reviewed yet{{ RESET }}"
    echo

    tree_total=0
    cosmetic_tree_total=0
    for crate in biscuit-terminal darkmatter; do
        echo -e "  {{ DIM }}comparing ${crate} (compiling + running render_comparison, ~1-2 min, no output until done)…{{ RESET }}"
        out=$(RECORD_DRIFT=1 cargo test -q -p "$crate" --test render_comparison -- --nocapture)
        # Isolate the recorded ledger block.
        ledger=$(echo "$out" \
            | awk '/=== BEGIN KNOWN_DRIFT/{f=1;next} /=== END KNOWN_DRIFT/{f=0} f')

        tree_lines=$(echo "$ledger" | grep -F 'Verdict::TreeBehind' || true)
        cosmetic_tree_lines=$(echo "$ledger" | grep -F 'Verdict::CosmeticTreeBehind' || true)
        cosmetic_neutral_lines=$(echo "$ledger" | grep -F 'Verdict::CosmeticNeutral' || true)
        tree=$(echo "$tree_lines" | grep -c . || true)
        bespoke=$(echo "$ledger" | grep -cF 'Verdict::BespokeBehind' || true)
        cosmetic_tree=$(echo "$cosmetic_tree_lines" | grep -c . || true)
        cosmetic_bespoke=$(echo "$ledger" | grep -cF 'Verdict::CosmeticBespokeBehind' || true)
        cosmetic_neutral=$(echo "$cosmetic_neutral_lines" | grep -c . || true)
        tree_total=$((tree_total + tree))
        cosmetic_tree_total=$((cosmetic_tree_total + cosmetic_tree))

        echo -e "  {{ BOLD }}${crate}{{ RESET }}"
        echo -e "    {{ BOLD }}non-cosmetic{{ RESET }}"
        echo -e "      {{ BOLD }}render-tree behind:{{ RESET }}   ${tree}   {{ DIM }}<- entries where the render-tree must catch up{{ RESET }}"
        echo -e "      bespoke behind:       ${bespoke}"
        echo -e "    {{ BOLD }}cosmetic{{ RESET }}"
        echo -e "      render-tree behind:   ${cosmetic_tree}"
        echo -e "      bespoke behind:       ${cosmetic_bespoke}"
        echo -e "      neutral/unclassified: ${cosmetic_neutral}"
        if [ "${tree}" -gt 0 ]; then
            echo -e "    {{ DIM }}non-cosmetic render-tree behind, by component:{{ RESET }}"
            echo "$tree_lines" \
                | sed -n 's/.*("\([^"]*\)".*/\1/p' \
                | sort | uniq -c | sed 's/^/    /'
        fi
        if [ "${cosmetic_tree}" -gt 0 ]; then
            echo -e "    {{ DIM }}cosmetic render-tree behind, by component:{{ RESET }}"
            echo "$cosmetic_tree_lines" \
                | sed -n 's/.*("\([^"]*\)".*/\1/p' \
                | sort | uniq -c | sed 's/^/    /'
        fi
        if [ "${cosmetic_neutral}" -gt 0 ]; then
            echo -e "    {{ DIM }}cosmetic neutral/unclassified, by component:{{ RESET }}"
            echo "$cosmetic_neutral_lines" \
                | sed -n 's/.*("\([^"]*\)".*/\1/p' \
                | sort | uniq -c | sed 's/^/    /'
            echo -e "    {{ DIM }}cosmetic neutral/unclassified, by facet:{{ RESET }}"
            echo "$cosmetic_neutral_lines" \
                | sed -n 's/.*, Facet::\([A-Za-z]*\),.*/\1/p' \
                | sort | uniq -c | sed 's/^/    /'
        fi
        echo
    done
    echo -e "  {{ BOLD }}total non-cosmetic render-tree behind{{ RESET }}: ${tree_total}"
    echo -e "  {{ BOLD }}total cosmetic render-tree behind{{ RESET }}: ${cosmetic_tree_total}"
    echo -e "  {{ DIM }}exit condition: 0 non-cosmetic render-tree-behind entries{{ RESET }}"
    echo

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
