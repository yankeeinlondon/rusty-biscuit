<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="max-width:800px" viewBox="0 0 800 400" role="graphics-document document" aria-roledescription="sankey"><rect x="0" y="0" width="800" height="400" fill="#ffffff" style="fill:#ffffff;stroke:none"/><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#333333;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:hsl(220.5882352941, 100%, 98.3333333333%);}#bv-ID .error-text{fill:rgb(8.5000000002, 5.7500000001, 0);stroke:rgb(8.5000000002, 5.7500000001, 0);}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#0b0b0b;stroke:#0b0b0b;}#bv-ID .marker.cross{stroke:#0b0b0b;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .label{font-family:"trebuchet ms",verdana,arial,sans-serif;}#bv-ID .node-labels{font-family:"trebuchet ms",verdana,arial,sans-serif;}#bv-ID .sankey-label-bg{stroke:#fff4dd;stroke-width:4px;stroke-linejoin:round;paint-order:stroke;}#bv-ID .sankey-label-fg{fill:#333333;}#bv-ID .node rect{shape-rendering:crispEdges;}#bv-ID .link{fill:none;stroke-opacity:0.5;mix-blend-mode:multiply;}#bv-ID .node .neo-node{stroke:hsl(40.5882352941, 60%, 83.3333333333%);}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node 