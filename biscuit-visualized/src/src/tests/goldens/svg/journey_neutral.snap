<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="max-width:1300px" viewBox="0 -25 1300 540" preserveAspectRatio="xMinYMin meet" height="565" role="graphics-document document" aria-roledescription="journey" aria-describedby="chart-desc-bv-ID" aria-labelledby="chart-title-bv-ID"><rect x="0" y="-25" width="1300" height="540" fill="#ffffff" style="fill:#ffffff;stroke:none"/><title id="chart-title-bv-ID">Very simple journey demo</title><desc id="chart-desc-bv-ID">2 main sections: work and home, each with just a few tasks</desc><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#000000;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:hsl(220.5882352941, 100%, 98.3333333333%);}#bv-ID .error-text{fill:rgb(8.5000000002, 5.7500000001, 0);stroke:rgb(8.5000000002, 5.7500000001, 0);}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#0b0b0b;stroke:#0b0b0b;}#bv-ID .marker.cross{stroke:#0b0b0b;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .label{font-family:"trebuchet ms",verdana,arial,sans-serif;color:#000000;}#bv-ID .mouth{stroke:#666;}#bv-ID line{stroke:#000000;}#bv-ID .legend{fill:#000000;font-family:"trebuchet ms",verdana,arial,sans-serif;}#bv-ID .label text{fill:#000000;}#bv-ID .label{color:#000000;}#bv-ID .face{fill:#FFF8DC;stroke:#999;}#bv-ID .node rect,#bv-ID .node circle,#bv-ID .node ellipse,#bv-ID .node polygon,#bv-ID .node path{fill:#fff4dd;stroke:hsl(40.5882352941, 60%, 83.3333333333%);stroke-width:1px;}#bv-ID .node .label{text-align:center;}#bv-ID .node.clickable{cursor:pointer;}#bv-ID .arrowheadPath{fill:#0b0b0b;}#bv-ID .edgePaths .path{stroke:#0b0b0b;stroke-width:1.5px;}#bv-ID .flowchart-link{stroke:#0b0b0b;fill:none;}#bv-ID .edgeLabel{background-color:hsl(-79.4117647059, 100%, 93.3333333333%);text-align:center;}#bv-ID .edgeLabel rect{opacity:0.5;}#bv-ID .cluster text{fill:rgb(8.5000000002, 5.7500000001, 0);}#bv-ID div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:12px;background:hsl(220.5882352941, 100%, 98.3333333333%);border:1px solid hsl(220.5882352941, 60%, 88.3333333333%);border-radius:2px;pointer-events:none;z-index:100;}#bv-ID .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#bv-ID .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#bv-ID .node .neo-node{stroke:hsl(40.5882352941, 60%, 83.3333333333%);}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:url(#bv-ID-gradient);stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:hsl(40.5882352941, 60%, 83.3333333333%);filter:none;}#bv-ID [data-look="neo"].node circle{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}</style><g/><defs><marker id="bv-ID-arrowhead" refX="5" refY="2" markerWidth="6" markerHeight="4" orient="auto"><path d="M 0,0 V 4 L6,2 Z"/></marker></defs><circle cx="20" cy="60" class="actor-0" fill="#8FBC8F" stroke="#000" r="7"/><text x="40" y="67" class="legend"><tspan x="50">Cat</tspan></text><circle cx="20" cy="80" class="actor-1" fill="#7CFC00" stroke="#000" r="7"/><text x="40" y="87" class="legend"><tspan x="50">Me</tspan></text><g><rect x="150" y="50" fill="#191970" stroke="#666" style="fill:#dadada" width="550" height="50" rx="3" ry="3" class="journey-section section-type-0"/><g><text x="425" y="75" dominant-baseline="central" alignment-baseline="central" class="journey-section section-type-0" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="425" dy="0">Go to work</tspan></text></g></g><g><line id="bv-ID-task0" x1="225" y1="110" x2="225" y2="450" class="task-line" stroke-width="1" stroke-dasharray="4 2" stroke="#666"/><circle cx="225" cy="300" class="face" r="15" stroke-width="2" overflow="visible"/><g><circle cx="220" cy="295" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><circle cx="230" cy="295" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><path class="mouth" d="M7.5,0A7.5,7.5,0,1,1,-7.5,0L-6.818,0A6.818,6.818,0,1,0,6.818,0Z" transform="translate(225,302)"/></g><rect x="150" y="110" fill="#191970" stroke="#666" style="fill:#dadada;stroke:#949494" width="150" height="50" rx="3" ry="3" class="task task-type-0"/><circle cx="164" cy="110" class="actor-1" fill="#7CFC00" stroke="#000" r="7"><title>Me</title></circle><g><text x="225" y="135" dominant-baseline="central" alignment-baseline="central" class="task" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="225" dy="0">  Make tea</tspan></text></g></g><g><line id="bv-ID-task1" x1="425" y1="110" x2="425" y2="450" class="task-line" stroke-width="1" stroke-dasharray="4 2" stroke="#666"/><circle cx="425" cy="360" class="face" r="15" stroke-width="2" overflow="visible"/><g><circle cx="420" cy="355" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><circle cx="430" cy="355" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><line class="mouth" stroke="#666" x1="420" y1="367" x2="430" y2="367" stroke-width="1"/></g><rect x="350" y="110" fill="#191970" stroke="#666" style="fill:#dadada;stroke:#949494" width="150" height="50" rx="3" ry="3" class="task task-type-0"/><circle cx="364" cy="110" class="actor-1" fill="#7CFC00" stroke="#000" r="7"><title>Me</title></circle><g><text x="425" y="135" dominant-baseline="central" alignment-baseline="central" class="task" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="425" dy="0">  Go upstairs</tspan></text></g></g><g><line id="bv-ID-task2" x1="625" y1="110" x2="625" y2="450" class="task-line" stroke-width="1" stroke-dasharray="4 2" stroke="#666"/><circle cx="625" cy="420" class="face" r="15" stroke-width="2" overflow="visible"/><g><circle cx="620" cy="415" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><circle cx="630" cy="415" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><path class="mouth" d="M-7.5,0A7.5,7.5,0,1,1,7.5,0L6.818,0A6.818,6.818,0,1,0,-6.818,0Z" transform="translate(625,427)"/></g><rect x="550" y="110" fill="#191970" stroke="#666" style="fill:#dadada;stroke:#949494" width="150" height="50" rx="3" ry="3" class="task task-type-0"/><circle cx="564" cy="110" class="actor-1" fill="#7CFC00" stroke="#000" r="7"><title>Me</title></circle><circle cx="574" cy="110" class="actor-0" fill="#8FBC8F" stroke="#000" r="7"><title>Cat</title></circle><g><text x="625" y="135" dominant-baseline="central" alignment-baseline="central" class="task" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="625" dy="0">  Do work</tspan></text></g></g><g><rect x="750" y="50" fill="#8B008B" stroke="#666" style="fill:#e1e1e1" width="350" height="50" rx="3" ry="3" class="journey-section section-type-1"/><g><text x="925" y="75" dominant-baseline="central" alignment-baseline="central" class="journey-section section-type-1" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="925" dy="0">Go home</tspan></text></g></g><g><line id="bv-ID-task3" x1="825" y1="110" x2="825" y2="450" class="task-line" stroke-width="1" stroke-dasharray="4 2" stroke="#666"/><circle cx="825" cy="300" class="face" r="15" stroke-width="2" overflow="visible"/><g><circle cx="820" cy="295" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><circle cx="830" cy="295" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><path class="mouth" d="M7.5,0A7.5,7.5,0,1,1,-7.5,0L-6.818,0A6.818,6.818,0,1,0,6.818,0Z" transform="translate(825,302)"/></g><rect x="750" y="110" fill="#8B008B" stroke="#666" style="fill:#e1e1e1;stroke:#949494" width="150" height="50" rx="3" ry="3" class="task task-type-1"/><circle cx="764" cy="110" class="actor-1" fill="#7CFC00" stroke="#000" r="7"><title>Me</title></circle><g><text x="825" y="135" dominant-baseline="central" alignment-baseline="central" class="task" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="825" dy="0">  Go downstairs</tspan></text></g></g><g><line id="bv-ID-task4" x1="1025" y1="110" x2="1025" y2="450" class="task-line" stroke-width="1" stroke-dasharray="4 2" stroke="#666"/><circle cx="1025" cy="360" class="face" r="15" stroke-width="2" overflow="visible"/><g><circle cx="1020" cy="355" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><circle cx="1030" cy="355" r="1.5" stroke-width="2" fill="#666" stroke="#666"/><line class="mouth" stroke="#666" x1="1020" y1="367" x2="1030" y2="367" stroke-width="1"/></g><rect x="950" y="110" fill="#8B008B" stroke="#666" style="fill:#e1e1e1;stroke:#949494" width="150" height="50" rx="3" ry="3" class="task task-type-1"/><circle cx="964" cy="110" class="actor-1" fill="#7CFC00" stroke="#000" r="7"><title>Me</title></circle><g><text x="1025" y="135" dominant-baseline="central" alignment-baseline="central" class="task" style="text-anchor:middle;font-size:14px;font-family:&quot;Open Sans&quot;, sans-serif;fill:#000000"><tspan x="1025" dy="0">  Sit down</tspan></text></g></g><text x="150" font-size="4ex" font-weight="bold" y="25" font-family="&quot;trebuchet ms&quot;, verdana, arial, sans-serif">My working day</text><line x1="150" y1="200" x2="1146" y2="200" stroke-width="4" stroke="black" marker-end="url(#bv-ID-arrowhead)"/><defs></defs><defs></defs><defs></defs><defs></defs><defs></defs><defs></defs><defs></defs></svg>
