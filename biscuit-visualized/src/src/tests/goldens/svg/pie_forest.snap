<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 661.8125 450" style="max-width:661.812px" role="graphics-document document" aria-roledescription="pie"><rect x="0" y="0" width="661.8125" height="450" fill="#ffffff" style="fill:#ffffff;stroke:none"/><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#333;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:hsl(220.5882352941, 100%, 98.3333333333%);}#bv-ID .error-text{fill:rgb(8.5000000002, 5.7500000001, 0);stroke:rgb(8.5000000002, 5.7500000001, 0);}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#0b0b0b;stroke:#0b0b0b;}#bv-ID .marker.cross{stroke:#0b0b0b;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .pieCircle{stroke:#ffffff;stroke-width:2px;opacity:0.7;}#bv-ID .pieCircle.highlighted{scale:1.05;opacity:1;}#bv-ID .pieCircle.highlightedOnHover:hover{transition-duration:250ms;scale:1.05;opacity:1;}#bv-ID .pieOuterCircle{stroke:#ffffff;stroke-width:5px;fill:none;}#bv-ID .pieTitleText{text-anchor:middle;font-size:25px;fill:#000000;font-family:"trebuchet ms",verdana,arial,sans-serif;}#bv-ID .slice{font-family:"trebuchet ms",verdana,arial,sans-serif;fill:#000000;font-size:17px;}#bv-ID .legend text{fill:#000000;font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:17px;}#bv-ID .node .neo-node{stroke:hsl(40.5882352941, 60%, 83.3333333333%);}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:url(#bv-ID-gradient);stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:hsl(40.5882352941, 60%, 83.3333333333%);filter:none;}#bv-ID [data-look="neo"].node circle{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}</style><g/><g transform="translate(225,225)"><g><circle cx="0" cy="0" r="186" class="pieOuterCircle"/><path d="M0,-185A185,185,0,0,1,110.8879034348174,148.08400613108296L0,0Z" fill="#dea085" class="pieCircle"/><path d="M110.8879034348174,148.08400613108296A185,185,0,0,1,-141.76816525308922,-118.85616231720081L0,0Z" fill="#b0c67f" class="pieCircle"/><path d="M-141.76816525308922,-118.85616231720081A185,185,0,0,1,-53.04905278800112,-177.23091716259856L0,0Z" fill="#cdbe81" class="pieCircle"/><path d="M-53.04905278800112,-177.23091716259856A185,185,0,0,1,0,-185L0,0Z" fill="#85c3de" class="pieCircle"/><text transform="translate(87.76427315133017,-29.217843147958526)" class="slice" style="text-anchor:middle">40%</text><text transform="translate(-67.18009568557264,63.58525570977367)" class="slice" style="text-anchor:middle">46%</text><text transform="translate(-50.84373145268871,-77.27331345274948)" class="slice" style="text-anchor:middle">9%</text><text transform="translate(-13.403732338975873,-91.52371255245873)" class="slice" style="text-anchor:middle">5%</text></g><text x="0" y="-200" class="pieTitleText">Key elements in Product X</text><g class="legend" transform="translate(216,-44)"><rect width="18" height="18" style="fill:rgb(222, 160, 133);stroke:rgb(222, 160, 133)"/><text x="22" y="14">Calcium [42.96]</text></g><g class="legend" transform="translate(216,-22)"><rect width="18" height="18" style="fill:rgb(176, 198, 127);stroke:rgb(176, 198, 127)"/><text x="22" y="14">Potassium [50.05]</text></g><g class="legend" transform="translate(216,0)"><rect width="18" height="18" style="fill:rgb(205, 190, 129);stroke:rgb(205, 190, 129)"/><text x="22" y="14">Magnesium [10.01]</text></g><g class="legend" transform="translate(216,22)"><rect width="18" height="18" style="fill:rgb(133, 195, 222);stroke:rgb(133, 195, 222)"/><text x="22" y="14">Iron [5]</text></g></g></svg>
