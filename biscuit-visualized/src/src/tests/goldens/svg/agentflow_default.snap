<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="agentflow" style="max-width:296px" viewBox="0 0 296 84" role="graphics-document document" aria-roledescription="agentflow"><rect x="0" y="0" width="296" height="84" fill="#ffffff" style="fill:#ffffff;stroke:none"/><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#333333;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:#e2e2e2;}#bv-ID .error-text{fill:#1d1d1d;stroke:#1d1d1d;}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#333333;stroke:#333333;}#bv-ID .marker.cross{stroke:#333333;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .label{font-family:"trebuchet ms",verdana,arial,sans-serif;color:#333333;}#bv-ID .cluster-label text{fill:#333333;}#bv-ID .cluster-label span{color:#333333;}#bv-ID .cluster-label span p{background-color:transparent;}#bv-ID .label text,#bv-ID span{fill:#333333;color:#333333;}#bv-ID .node rect,#bv-ID .node circle,#bv-ID .node ellipse,#bv-ID .node polygon,#bv-ID .node path{fill:#ececff;stroke:#9370db;stroke-width:1px;}#bv-ID .rough-node .label text,#bv-ID .node .label text,#bv-ID .image-shape .label,#bv-ID .icon-shape .label{text-anchor:middle;}#bv-ID .node .katex path{fill:#000;stroke:#000;stroke-width:1px;}#bv-ID .rough-node .label,#bv-ID .node .label,#bv-ID .image-shape .label,#bv-ID .icon-shape .label{text-align:center;}#bv-ID .node.clickable{cursor:pointer;}#bv-ID .root .anchor path{fill:#333333!important;stroke-width:0;stroke:#333333;}#bv-ID .arrowheadPath{fill:#000000;}#bv-ID .edgePaths .path{stroke:#333333;stroke-width:1px;}#bv-ID .flowchart-link{stroke:#333333;fill:none;}#bv-ID .edgeLabel{background-color:#e2e2e2;text-align:center;}#bv-ID .edgeLabel p{background-color:#e2e2e2;}#bv-ID .edgeLabel rect{opacity:0.5;background-color:#e2e2e2;fill:#e2e2e2;}#bv-ID .labelBkg{background-color:rgba(226, 226, 226, 0.5);}#bv-ID .cluster rect{fill:#e2e2e2;stroke:hsl(0, 0%, 78.6274509804%);stroke-width:1px;}#bv-ID .cluster text{fill:#333333;}#bv-ID .cluster span{color:#333333;}#bv-ID .node .collapsed-indicator{fill:hsl(0, 0%, 78.6274509804%);stroke:none;opacity:0.6;}#bv-ID .node .collapsed-separator{stroke:hsl(0, 0%, 78.6274509804%);stroke-width:0.75px;}#bv-ID div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:12px;background:#e2e2e2;border:1px solid hsl(0, 0%, 78.6274509804%);border-radius:2px;pointer-events:none;z-index:100;}#bv-ID .agentflowTitleText{text-anchor:middle;font-size:18px;fill:#333333;}#bv-ID rect.text{fill:none;stroke-width:0;}#bv-ID .icon-shape,#bv-ID .image-shape{background-color:#e2e2e2;text-align:center;}#bv-ID .icon-shape p,#bv-ID .image-shape p{background-color:#e2e2e2;padding:2px;}#bv-ID .icon-shape .label rect,#bv-ID .image-shape .label rect{opacity:0.5;background-color:#e2e2e2;fill:#e2e2e2;}#bv-ID .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#bv-ID .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#bv-ID .node .neo-node{stroke:#9370db;}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:#9370db;filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:#9370db;stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:#9370db;filter:none;}#bv-ID [data-look="neo"].node circle{stroke:#9370db;filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-merman-flowchart-document-gradient-root);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:#9370db;filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID .flow-cluster rect{fill:none;stroke-width:0.75px;}</style><defs><filter id="bv-ID-merman-flowchart-document-filter-drop-shadow" height="130%" width="130%"><feDropShadow dx="4" dy="4" stdDeviation="0" flood-opacity="0.06" flood-color="#000000"/></filter></defs><defs><filter id="bv-ID-merman-flowchart-document-filter-drop-shadow-small" height="150%" width="150%"><feDropShadow dx="2" dy="2" stdDeviation="0" flood-opacity="0.06" flood-color="#000000"/></filter></defs><g><marker id="bv-ID-merman-flowchart-document_agentflow-pointEnd" class="marker agentflow" viewBox="0 0 10 10" refX="5" refY="5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" class="arrowMarkerPath" style="stroke-width:1;stroke-dasharray:1, 0"/></marker><marker id="bv-ID-merman-flowchart-document_agentflow-pointStart" class="marker agentflow" viewBox="0 0 10 10" refX="4.5" refY="5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 5 L 10 10 L 10 0 z" class="arrowMarkerPath" style="stroke-width:1;stroke-dasharray:1, 0"/></marker><marker id="bv-ID-merman-flowchart-document_agentflow-pointEnd-margin" class="marker agentflow" viewBox="0 0 11.5 14" refX="11.5" refY="7" markerUnits="userSpaceOnUse" markerWidth="10.5" markerHeight="14" orient="auto"><path d="M 0 0 L 11.5 7 L 0 14 z" class="arrowMarkerPath" style="stroke-width:0;stroke-dasharray:1, 0"