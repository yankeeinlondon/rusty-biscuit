<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="max-width:880px" viewBox="0 0 880 680" role="graphics-document document" aria-roledescription="cynefin"><rect x="0" y="0" width="880" height="680" fill="#333333" style="fill:#333333;stroke:none"/><style>#bv-ID{font-family:courier;font-size:16px;fill:#cccccc;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:#484848;}#bv-ID .error-text{fill:#b7b7b7;stroke:#b7b7b7;}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#d3d3d3;stroke:#d3d3d3;}#bv-ID .marker.cross{stroke:#d3d3d3;}#bv-ID svg{font-family:courier;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .cynefinDomain{stroke:none;}#bv-ID .cynefinDomainLabel{font-size:16px;font-weight:bold;fill:#cccccc;}#bv-ID .cynefinSubtitle{font-size:11px;fill:#cccccc;font-style:italic;}#bv-ID .cynefinItem{fill-opacity:0.95;stroke:#d3d3d3;stroke-width:1;}#bv-ID .cynefinItemText{font-size:12px;fill:#cccccc;}#bv-ID .cynefinItemOverflow{fill-opacity:0.6;stroke:#d3d3d3;stroke-width:1;stroke-dasharray:3 2;}#bv-ID .cynefinBoundary{stroke:#d3d3d3;stroke-width:2;stroke-dasharray:6 3;}#bv-ID .cynefinCliff{stroke:#8B0000;stroke-width:4;}#bv-ID .cynefinConfusion{stroke:#d3d3d3;stroke-width:1.5;stroke-dasharray:4 2;}#bv-ID .cynefinArrowLine{stroke:#d3d3d3;stroke-width:2;fill:none;}#bv-ID .cynefinArrowHead{fill:#d3d3d3;stroke:none;}#bv-ID .cynefinArrowLabel{font-size:11px;fill:#cccccc;}#bv-ID .cynefinTitle{font-size:18px;font-weight:bold;fill:#cccccc;}#bv-ID .node .neo-node{stroke:#cccccc;}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:url(#bv-ID-gradient);stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:#cccccc;filter:none;}#bv-ID [data-look="neo"].node circle{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}</style><g/><g transform="translate(40, 40)"><g class="cynefin-backgrounds"><rect class="cynefinDomain" x="0" y="0" width="400" height="300" fill="#334c2b" fill-opacity="0.4" stroke="none"></rect><rect class="cynefinDomain" x="400" y="0" width="400" height="300" fill="#3f4648" fill-opacity="0.4" stroke="none"></rect><rect class="cynefinDomain" x="0" y="300" width="400" height="300" fill="#5c3232" fill-opacity="0.4" stroke="none"></rect><rect class="cynefinDomain" x="400" y="300" width="400" height="300" fill="#554228" fill-opacity="0.4" stroke="none"></rect></g><g class="cynefin-boundaries"><path class="cynefinBoundary" d="M402.033,0 C403.909,42.857 396.495,42.857 398.371,85.714 C397.472,128.571 393.018,128.571 392.119,171.429 C401.406,214.286 386.14,214.286 395.427,257.143 C393.799,300 406.37,300 404.743,342.857 C408.938,385.714 388.338,385.714 392.533,428.571 C386.718,471.429 402.398,471.429 396.582,514.286 C406.216,557.143 397.49,557.143 407.124,600" fill="none"></path><path class="cynefinBoundary" d="M0,294.17 C57.143,301.55 57.143,296.799 114.286,304.178 C171.429,298.559 171.429,303.787 228.571,298.168 C285.714,305.532 285.714,300.446 342.857,307.81 C400,300.392 400,311.18 457.143,303.761 C514.286,312.955 514.286,285.951 571.429,295.146 C628.571,291.62 628.571,297.217 685.714,293.691 C742.857,299.997 742.857,294.823 800,301.13" fill="none"></path><path class="cynefinCliff" d="M400,300 C424,360 364,465 412,525 C376,555 407.2,585 400,600" fill="none"></path></g><path class="cynefinConfusion" d="M280,300 A120,90 0 1,1 520,300 A120,90 0 1,1 280,300 Z" fill="#57354b" fill-opacity="0.5"></path><g class="cynefin-labels"><text class="cynefinDomainLabel" x="200" y="150" text-anchor="middle" dominant-baseline="middle">Complex</text><text class="cynefinDomainLabel" x="600" y="150" text-anchor="middle" dominant-baseline="middle">Complicated</text><text class="cynefinDomainLabel" x="200" y="450" text-anchor="middle" dominant-baseline="middle">Chaotic</text><text class="cynefinDomainLabel" x="600" y="450" text-anchor="middle" dominant-baseline="middle">Clear</text><text class="cynefinDomainLabel" x="400" y="300" text-anchor="middle" dominant-baseline="middle">Confusion</text></g><g class="cynefin-items"><g transform="translate(171.8154296875, 165)"><rect class="cynefinItem" x="0" y="0" width="56.369140625" height="26" rx="4" ry="4" fill="#334c2b" fill-opacity="0.95"></rect><text class="cynefinItemText" x="28.1845703125" y="13" text-anchor="middle" dominant-baseline="central">Item A</text></g><g transform="translate(572.029296875, 465)"><rect class="cynefinItem" x="0" y="0" width="55.94140625" height="26" rx="4" ry="4" fill="#554228" fill-opacity="0.95"></rect><text class="cynefinItemText" x="27.970703125" y="13" text-anchor="middle" dominant-baseline="central">Item B</text></g></g><text class="cynefinTitle" x="400" y="-20" text-anchor="middle" dominant-baseline="middle">Minimal Labels</text></g></svg>
