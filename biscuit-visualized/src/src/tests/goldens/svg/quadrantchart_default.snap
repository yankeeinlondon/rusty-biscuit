<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 500 500" style="max-width:500px" role="graphics-document document" aria-roledescription="quadrantChart"><rect x="0" y="0" width="500" height="500" fill="#ffffff" style="fill:#ffffff;stroke:none"/><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#333333;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:#e2e2e2;}#bv-ID .error-text{fill:#1d1d1d;stroke:#1d1d1d;}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#333333;stroke:#333333;}#bv-ID .marker.cross{stroke:#333333;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .node .neo-node{stroke:#9370db;}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:url(#bv-ID-gradient);stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:#9370db;filter:none;}#bv-ID [data-look="neo"].node circle{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}</style><g/><g class="main"><g class="quadrants"><g class="quadrant"><rect x="263" y="45" width="232" height="212" fill="#ececff"/><text x="0" y="0" fill="#333333" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(379, 50) rotate(0)">We should expand</text></g><g class="quadrant"><rect x="31" y="45" width="232" height="212" fill="#f1f1ff"/><text x="0" y="0" fill="#2e2e2e" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(147, 50) rotate(0)">Need to promote</text></g><g class="quadrant"><rect x="31" y="257" width="232" height="212" fill="#f6f6ff"/><text x="0" y="0" fill="#292929" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(147, 262) rotate(0)">Re-evaluate</text></g><g class="quadrant"><rect x="263" y="257" width="232" height="212" fill="#fbfbff"/><text x="0" y="0" fill="#242424" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(379, 262) rotate(0)">May be improved</text></g></g><g class="border"><line x1="30" y1="45" x2="496" y2="45" style="stroke:#9370db;stroke-width:2"/><line x1="495" y1="46" x2="495" y2="468" style="stroke:#9370db;stroke-width:2"/><line x1="30" y1="469" x2="496" y2="469" style="stroke:#9370db;stroke-width:2"/><line x1="31" y1="46" x2="31" y2="468" style="stroke:#9370db;stroke-width:2"/><line x1="263" y1="46" x2="263" y2="468" style="stroke:#9370db;stroke-width:1"/><line x1="32" y1="257" x2="494" y2="257" style="stroke:#9370db;stroke-width:1"/></g><g class="data-points"><g class="data-point"><circle cx="193.39999999999998" cy="138.27999999999997" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(193.39999999999998, 143.27999999999997) rotate(0)">Campaign F</text></g><g class="data-point"><circle cx="216.60000000000002" cy="324.84000000000003" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(216.60000000000002, 329.84000000000003) rotate(0)">Campaign E</text></g><g class="data-point"><circle cx="392.92" cy="324.84000000000003" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(392.92, 329.84000000000003) rotate(0)">Campaign D</text></g><g class="data-point"><circle cx="295.47999999999996" cy="176.44" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(295.47999999999996, 181.44) rotate(0)">Campaign C</text></g><g class="data-point"><circle cx="239.8" cy="371.48" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(239.8, 376.48) rotate(0)">Campaign B</text></g><g class="data-point"><circle cx="170.2" cy="214.60000000000002" r="5" fill="#000000" stroke="none" stroke-width="0"/><text x="0" y="0" fill="#333333" font-size="12" dominant-baseline="hanging" text-anchor="middle" transform="translate(170.2, 219.60000000000002) rotate(0)">Campaign A</text></g></g><g class="labels"><g class="label"><text x="0" y="0" fill="#333333" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(147, 479) rotate(0)">Low Reach</text></g><g class="label"><text x="0" y="0" fill="#333333" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(379, 479) rotate(0)">High Reach</text></g><g class="label"><text x="0" y="0" fill="#333333" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(5, 363) rotate(-90)">Low Engagement</text></g><g class="label"><text x="0" y="0" fill="#333333" font-size="16" dominant-baseline="hanging" text-anchor="middle" transform="translate(5, 151) rotate(-90)">High Engagement</text></g></g><g class="title"><text x="0" y="0" fill="#333333" font-size="20" dominant-baseline="hanging" text-anchor="middle" transform="translate(250, 10) rotate(0)">Reach and engagement of campaigns</text></g></g></svg>
