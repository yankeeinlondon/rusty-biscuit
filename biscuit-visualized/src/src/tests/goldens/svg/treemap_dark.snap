<svg id="bv-ID" width="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="2 27 996 371" style="max-width:996px" class="flowchart" role="graphics-document document" aria-roledescription="treemap"><rect x="2" y="27" width="996" height="371" fill="#333333" style="fill:#333333;stroke:none"/><style>#bv-ID{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;fill:#cccccc;}#bv-ID .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;stroke-linecap:round;}#bv-ID .error-icon{fill:#484848;}#bv-ID .error-text{fill:#b7b7b7;stroke:#b7b7b7;}#bv-ID .edge-thickness-normal{stroke-width:1px;}#bv-ID .edge-thickness-thick{stroke-width:3.5px;}#bv-ID .edge-pattern-solid{stroke-dasharray:0;}#bv-ID .edge-thickness-invisible{stroke-width:0;fill:none;}#bv-ID .edge-pattern-dashed{stroke-dasharray:3;}#bv-ID .edge-pattern-dotted{stroke-dasharray:2;}#bv-ID .marker{fill:#d3d3d3;stroke:#d3d3d3;}#bv-ID .marker.cross{stroke:#d3d3d3;}#bv-ID svg{font-family:"trebuchet ms",verdana,arial,sans-serif;font-size:16px;}#bv-ID p{margin:0;}#bv-ID .treemapNode.section{stroke:black;stroke-width:1;fill:#efefef;}#bv-ID .treemapNode.leaf{stroke:black;stroke-width:1;fill:#efefef;}#bv-ID .treemapLabel{fill:#cccccc;font-size:14;}#bv-ID .treemapValue{fill:#cccccc;font-size:12;}#bv-ID .treemapTitle{fill:#cccccc;font-size:14px;}#bv-ID .node .neo-node{stroke:#cccccc;}#bv-ID [data-look="neo"].node rect,#bv-ID [data-look="neo"].cluster rect,#bv-ID [data-look="neo"].node polygon{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].swimlane.cluster rect{filter:none;}#bv-ID [data-look="neo"].node path{stroke:url(#bv-ID-gradient);stroke-width:1px;}#bv-ID [data-look="neo"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node .neo-line path{stroke:#cccccc;filter:none;}#bv-ID [data-look="neo"].node circle{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].node circle .state-start{fill:#000000;}#bv-ID [data-look="neo"].icon-shape .icon{fill:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#bv-ID [data-look="neo"].icon-shape .icon-neo path{stroke:url(#bv-ID-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}</style><g/><g transform="translate(0, 0)" class="treemapContainer"><g class="treemapSection" transform="translate(0,0)"><rect width="1000" height="25" class="treemapSectionHeader" fill="none" fill-opacity="0.6" stroke-width="0.6" style="display:none"/><clipPath id="clip-section-bv-ID-0"><rect width="988" height="25"/></clipPath><rect width="1000" height="400" class="treemapSection section0" fill="transparent" fill-opacity="0.6" stroke="transparent" stroke-width="2" stroke-opacity="0.4" style="display:none"/><text class="treemapSectionLabel" x="6" y="12.5" dominant-baseline="middle" font-weight="bold" clip-path="url(#clip-section-bv-ID-0)" style="display:none"/><text class="treemapSectionValue" x="990" y="12.5" text-anchor="end" dominant-baseline="middle" font-style="italic" style="display:none">155</text></g><g class="treemapSection" transform="translate(10,35)"><rect width="980" height="25" class="treemapSectionHeader" fill="none" fill-opacity="0.6" stroke-width="0.6"/><clipPath id="clip-section-bv-ID-1"><rect width="968" height="25"/></clipPath><rect width="980" height="355" class="treemapSection section1" fill="hsl(180, 1.5873015873%, 0%)" fill-opacity="0.6" stroke="hsl(180, 1.5873015873%, 10%)" stroke-width="2" stroke-opacity="0.4"/><text class="treemapSectionLabel" x="6" y="12.5" dominant-baseline="middle" font-weight="bold" clip-path="url(#clip-section-bv-ID-1)" style="dominant-baseline:middle;font-size:12px;fill:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Products</text><text class="treemapSectionValue" x="970" y="12.5" text-anchor="end" dominant-baseline="middle" font-style="italic" style="text-anchor:end;dominant-baseline:middle;font-size:10px;fill:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">155</text></g><g class="treemapSection" transform="translate(20,70)"><rect width="616" height="25" class="treemapSectionHeader" fill="none" fill-opacity="0.6" stroke-width="0.6"/><clipPath id="clip-section-bv-ID-2"><rect width="604" height="25"/></clipPath><rect width="616" height="310" class="treemapSection section2" fill="hsl(0, 0%, 0%)" fill-opacity="0.6" stroke="hsl(0, 0%, 10%)" stroke-width="2" stroke-opacity="0.4"/><text class="treemapSectionLabel" x="6" y="12.5" dominant-baseline="middle" font-weight="bold" clip-path="url(#clip-section-bv-ID-2)" style="dominant-baseline:middle;font-size:12px;fill:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Electronics</text><text class="treemapSectionValue" x="606" y="12.5" text-anchor="end" dominant-baseline="middle" font-style="italic" style="text-anchor:end;dominant-baseline:middle;font-size:10px;fill:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">100</text></g><g class="treemapSection" transform="translate(646,70)"><rect width="334" height="25" class="treemapSectionHeader" fill="none" fill-opacity="0.6" stroke-width="0.6"/><clipPath id="clip-section-bv-ID-3"><rect width="322" height="25"/></clipPath><rect width="334" height="310" class="treemapSection section3" fill="hsl(0, 0%, 0%)" fill-opacity="0.6" stroke="hsl(0, 0%, 10%)" stroke-width="2" stroke-opacity="0.4"/><text class="treemapSectionLabel" x="6" y="12.5" dominant-baseline="middle" font-weight="bold" clip-path="url(#clip-section-bv-ID-3)" style="dominant-baseline:middle;font-size:12px;fill:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Clothing</text><text class="treemapSectionValue" x="324" y="12.5" text-anchor="end" dominant-baseline="middle" font-style="italic" style="text-a