:#cccccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">25</text></g><g class="treemapNode treemapLeafGroup leaf0x" transform="translate(30,105)"><rect width="293" height="265" class="treemapLeaf" fill="hsl(0, 0%, 0%)" fill-opacity="0.3" stroke="hsl(0, 0%, 0%)" stroke-width="3"/><clipPath id="clip-bv-ID-0"><rect width="289" height="261"/></clipPath><text class="treemapLabel" x="146.5" y="132.5" style="text-anchor:middle;dominant-baseline:middle;font-size:38px;fill:rgb(204, 204, 204)" clip-path="url(#clip-bv-ID-0)">Phones</text><text class="treemapValue" x="146.5" y="153.5" style="text-anchor:middle;dominant-baseline:hanging;font-size:23px;fill:rgb(204, 204, 204)" clip-path="url(#clip-bv-ID-0)">50</text></g><g class="treemapNode treemapLeafGroup leaf1x" transform="translate(333,105)"><rect width="293" height="155" class="treemapLeaf" fill="hsl(0, 0%, 0%)" fill-opacity="0.3" stroke="hsl(0, 0%, 0%)" stroke-width="3"/><clipPath id="clip-bv-ID-1"><rect width="289" height="151"/></clipPath><text class="treemapLabel" x="146.5" y="77.5" style="text-anchor:middle;dominant-baseline:middle;font-size:38px;fill:rgb(204, 204, 204)" clip-path="url(#clip-bv-ID-1)">Computers</text><text class="treemapValue" x="146.5" y="98.5" style="text-anchor:middle;dominant-baseline:hanging;font-size:23px;fill:rgb(204, 204, 204)" clip-path="url(#clip-bv-ID-1)">30</text></g><g class="treemapNode treemapLeafGroup leaf2x" transform="translate(333,270)"><rect width="293" height="100" class="treemapLeaf" fill="hsl(0, 0%, 0%)" fill-opacity="0.3" stroke="hsl(0, 0%, 0%)" stroke-width="3"/><clipPath id="clip-bv-ID-2"><rect width="289" height="96"/></clipPath><text class="treemapLabel" x="146.5" y="50" style="text-anchor:middle;dominant-baseline:middle;font-size:38px;fill:rgb(204, 204, 204)" clip-path="url(#clip-bv-ID-2)">Accessories</text><text class="treemapValue" x="146.5" y="71" style="text-anchor:middle;dominant-baseline:hanging;font-size:23px;fill:rgb(204, 204, 204)" clip-path="url(#clip-