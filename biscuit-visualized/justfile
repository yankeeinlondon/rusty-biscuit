set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Biscuit Visualized"
LIBRARY := "biscuit-visualized"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null && [ -f just.md ]; then
        md just.md
    else
        echo
        echo -e "{{ BOLD }}{{ PACKAGE }}{{ RESET }} (diagram & graph rendering library)"
        echo "======================================================================================"
        echo
    fi

    just --list | grep -v 'default'
    echo

# build library
build *args="":
    @just _build {{ LIBRARY }} "Biscuit Visualized" --all-features {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
#
# `--all-features` throughout this file: `image` (resvg + Mermaid) gates 56 of
# the 71 tests, and `clap` gates the CLI-facing argument types. Its only
# consumer, biscuit-terminal, enables both, so the default feature set is a
# configuration nobody ships — gating it would run 15 tests and call it 71.
# Same reasoning as messenger's `--features desktop`.
sanity:
    @just _sanity {{ LIBRARY }} --all-features

# Level-1 tests for the library.
test *args="":
    @just _test {{ LIBRARY }} --all-features {{ args }}

# not applicable: biscuit-visualized has no real-terminal (Level-2) tests —
# biscuit-terminal owns the terminal rendering of the artifacts produced here.
test-l2:
    @echo "test-l2: not applicable for biscuit-visualized"

# not applicable: biscuit-visualized has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-visualized"

# not applicable: biscuit-visualized renders SVG/PNG artifacts directly and owns
# no `browser_*` tests; the browser tier lives with its consumers.
test-browser:
    @echo "test-browser: not applicable for biscuit-visualized"

# not applicable: biscuit-visualized has no real-resource tier
test-real:
    @echo "test-real: not applicable for biscuit-visualized"

# Clippy for the library. `_lint` takes no feature flags, so the `--all-features`
# form is spelled out here (same shape as messenger's desktop-feature lint).
lint:
    @echo -e "Linting {{ BOLD }}{{ LIBRARY }}{{ RESET }} (--all-features)"
    @cargo clippy -p {{ LIBRARY }} --all-features --all-targets -- -D warnings

# not applicable: biscuit-visualized has no criterion benches
bench:
    @echo "bench: not applicable for biscuit-visualized"

# Per-package LCOV coverage for the library.
coverage *args="":
    @just _coverage {{ LIBRARY }} --all-features {{ args }}

# Doctests for the library.
doctest *args="":
    @just _doctest {{ LIBRARY }} --all-features {{ args }}

# not applicable: biscuit-visualized has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for biscuit-visualized"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} --all-features

# build and show the docs for the library code
docs:
    @cargo doc -p {{ LIBRARY }} --open

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ RED }} {{ DIM }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ GREEN }} >/dev/null || true
