+/// The branch name at the start of a `branch`, `checkout`, `switch`, or
+/// `merge` argument: a quoted string, or the first whitespace-separated token.
+/// Attributes that follow (`order: 1`, `id: "m"`, `tag: "v1"`, `type: ...`)
+/// are not part of the name.
+fn gitgraph_branch_name(rest: &str) -> &str {
+    let rest = rest.trim();
+    if let Some(quote) = rest.chars().next().filter(|c| *c == '"' || *c == '\'') {
+        let inner = &rest[1..];
+        return inner.find(quote).map_or(inner, |end| &inner[..end]);
+    }
+    rest.split_whitespace().next().unwrap_or("")
+}
