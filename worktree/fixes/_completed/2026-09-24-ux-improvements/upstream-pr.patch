+    #[test]
+    fn parse_gitgraph_branch_attributes_are_not_part_of_the_name() {
+        let input = "gitGraph\n  commit id: \"A\"\n  branch feat order: 1\n  checkout feat\n  commit id: \"B\"\n  checkout main\n  merge feat id: \"M\" tag: \"v1\"";
+        let parsed = parse_mermaid(input).unwrap();
+        let gitgraph = &parsed.graph.gitgraph;
+        let names: Vec<&str> = gitgraph.branches.iter().map(|b| b.name.as_str()).collect();
+        assert_eq!(names, vec!["main", "feat"]);
+        assert_eq!(gitgraph.branches[1].order, Some(1.0));
+        let feat_commit = gitgraph.commits.iter().find(|c| c.id == "B").unwrap();
+        assert_eq!(feat_commit.branch, "feat");
+        let merge = gitgraph.commits.iter().find(|c| c.id == "M").unwrap();
+        assert_eq!(merge.parents, vec!["A".to_string(), "B".to_string()]);
+        assert_eq!(merge.tags, vec!["v1".to_string()]);
+    }
+
+    #[test]
+    fn parse_gitgraph_quoted_branch_names() {
+        let input = "gitGraph\n  commit id: \"A\"\n  branch \"feat/x y\" order: 2\n  checkout \"feat/x y\"\n  commit id: \"B\"\n  checkout main\n  merge \"feat/x y\"";
+        let parsed = parse_mermaid(input).unwrap();
+        let gitgraph = &parsed.graph.gitgraph;
+        assert_eq!(gitgraph.branches.len(), 2);
+        assert_eq!(gitgraph.branches[1].name, "feat/x y");
+        let merge = gitgraph.commits.last().unwrap();
+        assert_eq!(merge.parents, vec!["A".to_string(), "B".to_string()]);
+    }
