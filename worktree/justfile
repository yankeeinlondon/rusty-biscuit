set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Worktree"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
DOCS := ""
TODAY := `date +%F`

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
# Build the library and CLI
build *args="":
    @just _build worktree "Worktree Library" {{ args }}
    @just _build worktree-cli "Worktree CLI" {{ args }}

# Test both library and CLI.
test:
    @just _test worktree
    @just _test worktree-cli --no-tests=pass

# Lint both the library and CLI

lint:
    @just _lint worktree
    @just _lint worktree-cli

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint worktree || just _fix_lint worktree
    @just _lint worktree-cli || just _fix_lint worktree-cli

# install the worktree CLI binary (wt)
install:
    @just build --release
    @just _install "./cli" "Worktree (wt)"

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{ LIBRARY }}*:"

# Build and open rustdoc
docs:
    @cargo doc -p {{ LIBRARY }} --open

# No-op recipe: reference color vars so linters won't report them as unused.
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ DIM }} {{ TODAY }} {{ DOCS }} >/dev/null || true
