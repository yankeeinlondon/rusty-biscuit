+/// SPIKE S1: lexically joins `reference` onto `base` (no filesystem access).
+/// Returns `None` when `..` climbs above the virtual root.
+fn lexical_join(base: &Path, reference: &str) -> Option<PathBuf> {
+    let mut out: Vec<std::ffi::OsString> = Vec::new();
+    for component in base.join(reference).components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop()?;
+            }
+            Component::Normal(part) => out.push(part.to_os_string()),
+            _ => return None,
+        }
+    }
+    Some(out.iter().collect())
+}
