set dotenv-load
set positional-arguments

# set allow-duplicate-recipes

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/spec.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
PACKAGE := "Biscuit Terminal"
LIBRARY := replace(lowercase(PACKAGE), " ", "-")
CLI := replace(lowercase(PACKAGE) + "-cli", " ", "-")

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    else
      echo
      echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
      echo "======================================================================================"
      echo ""
    fi

    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build biscuit-terminal "Biscuit Terminal Library" {{ args }}
    @just _build biscuit-terminal-cli "Biscuit Terminal CLI" {{ args }}

# Install the CLI
install *args="":
    @just build --release
    @just _install "./cli" "biscuit-terminal" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# `--features image` on the library throughout: biscuit-terminal declares no
# `default` feature set, and `image` gates 137 of its 3004 tests (the resvg
# rasterization path plus the mermaid / graph-expression / horizontal-rule
# parity suites). Every consumer that renders artifacts enables it —
# biscuit-terminal-cli, darkmatter, worktree-cli, sniff-cli — so the
# no-feature build is a configuration nobody ships.
#
# NOT `--all-features`: the `serde` feature's test module does not compile
# (its `renderable::tree::graphics::horizontal_rule_svg` calls are one
# argument behind that function's signature), and `clap` gates no tests.

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "{{ LIBRARY }} --features image; {{ CLI }}"

# Test both library and CLI (Level-1 only — `test-l2` runs real-terminal tests).
test *args="":
    @just _test_all "{{ LIBRARY }} --features image; {{ CLI }}" {{ args }}

# Level-2 real-terminal tests. Skips cleanly if the harness is unavailable
# unless `BISCUIT_TEST_LEVEL_REQUIRED=2` is set in the environment.
test-l2 *args="":
    @just _test_l2_all "{{ LIBRARY }} --features terminal-tests; {{ CLI }} --features terminal-tests" {{ args }}

# not applicable: biscuit-terminal has no OS-keyboard-injection (Level-3) tests
test-l3 *args="":
    @just _test_l3 {{ LIBRARY }} {{ args }}
    @just _test_l3 {{ CLI }} {{ args }}

# Headless-browser tests (computed-style parity for BrowserRenderable output).
test-browser:
    @just _test_browser {{ LIBRARY }} --features browser-tests

# not applicable: biscuit-terminal has no real-resource tier
test-real:
    @echo "test-real: not applicable for biscuit-terminal"

# Lint both the library and CLI
lint:
    @just _lint {{ LIBRARY }}
    @just _lint {{ CLI }}

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage {{ LIBRARY }} --features image {{ args }}
    @just _coverage {{ CLI }} {{ args }}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest {{ LIBRARY }} --features image {{ args }}
    @just _doctest {{ CLI }} {{ args }}

# not applicable: biscuit-terminal has no cargo-fuzz targets (Phase 5 scope)
fuzz:
    @echo "fuzz: not applicable for biscuit-terminal (planned Phase 5)"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Outdated packages
outdated:
    @cargo outdated --root-deps-only

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }}

# ---------- benchmarking + profiling ----------

# run the full Criterion bench suite for biscuit-terminal
bench *args="":
    @echo -e "Running Criterion benches for {{ BOLD }}{{ PACKAGE }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} -- {{ args }}

# run only the rendering benches (escape codes, prose, word-wrap, layout, components)
bench-rendering *args="":
    @cargo bench -p {{ LIBRARY }} --bench rendering -- {{ args }}

# capture a saved baseline for trend tracking (usage: `just bench-baseline main`)
bench-baseline name:
    @echo -e "Saving Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} -- --save-baseline {{ name }}

# compare current bench timings against a saved baseline
bench-compare name:
    @echo -e "Comparing against Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} -- --baseline {{ name }}

# Run the latest debug build of the CLI
cli *args="":
    @cargo run -p {{ CLI }} {{ args }}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{ LIBRARY }}*:"

readme:
    _readme_files claudine

# produce documentation for biscuit-terminal (without dependencies)
doc open="false":
    @just _doc biscuit-terminal "{{ open }}"
    @just _doc biscuit-terminal-cli "{{ open }}"

parity:
    cargo run -p biscuit-terminal --example render_tree_parity
    cargo run -p darkmatter --example render_tree_parity

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
