set dotenv-load := true
set positional-arguments := true
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../../just/lifecycle.just"
import "../../just/plan.just"
import "../../just/review.just"
import "../../just/notify.just"
import "../../just/ai.just"
import "../../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

CORE := "rendezvous-core"
DAEMON := "rendezvous-daemon"
CLIENT := "rendezvous-client"

default:
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    echo -e "{{ BOLD }}Rendezvous ({{ RESET }}core / daemon / test-client{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build all three rendezvous crates.
build *args="":
    @just _build {{ CORE }} "Rendezvous Core" {{ args }}
    @just _build {{ DAEMON }} "Rendezvous Daemon" {{ args }}
    @just _build {{ CLIENT }} "Rendezvous Test Client" {{ args }}

# Fast confidence subset (lib + bins, !slow) across all three crates.
sanity:
    @just _sanity_all "{{ CORE }} {{ DAEMON }} {{ CLIENT }}"

# Test all three rendezvous crates.
test *args="":
    @just _test_all "{{ CORE }} {{ DAEMON }} {{ CLIENT }}" {{ args }}

# Level-2 (real-terminal) tests are not applicable to rendezvous.
test-l2 *args="":
    @echo "test-l2: not applicable for rendezvous"

# not applicable: rendezvous injects no OS keyboard or mouse input.
test-l3:
    @echo "test-l3: not applicable for rendezvous"

# not applicable: rendezvous serves gRPC over a local endpoint, not HTML.
test-browser:
    @echo "test-browser: not applicable for rendezvous"

# opt-in real_ tier: `rendezvous-daemon::peer_discovery`'s two mDNS identities
# bind a real multicast responder to this host's network and discover a second
# daemon over it. They are named `real_*`, so every other recipe's tier filter
# excludes them — before this recipe existed they compiled on every run and
# executed on none.
test-real *args="":
    @just _test_real {{ DAEMON }} {{ args }}

# Doctests for all three rendezvous crates.
doctest *args="":
    @just _doctest {{ CORE }} {{ args }}
    @just _doctest {{ DAEMON }} {{ args }}
    @just _doctest {{ CLIENT }} {{ args }}

# not applicable: rendezvous declares no criterion benchmark targets.
bench:
    @echo "bench: not applicable for rendezvous"

# Per-crate LCOV coverage.
coverage *args="":
    @just _coverage {{ CORE }} {{ args }}
    @just _coverage {{ DAEMON }} {{ args }}
    @just _coverage {{ CLIENT }} {{ args }}

# not applicable: rendezvous has no cargo-fuzz targets.
fuzz:
    @echo "fuzz: not applicable for rendezvous"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# Lint all three rendezvous crates.
lint:
    @just _lint {{ CORE }}
    @just _lint {{ DAEMON }}
    @just _lint {{ CLIENT }}

# Lint (and fix) all three rendezvous crates.
lint-fix:
    @just _lint {{ CORE }} || just _fix_lint {{ CORE }}
    @just _lint {{ DAEMON }} || just _fix_lint {{ DAEMON }}
    @just _lint {{ CLIENT }} || just _fix_lint {{ CLIENT }}

# Validate the source code without doing a full build.
check:
    @cargo check -p {{ CORE }} -p {{ DAEMON }} -p {{ CLIENT }}

# Install the daemon and test-client binaries.
install:
    @just build --release
    @just _install "./daemon" "Rendezvous Daemon"
    @just _install "./client" "Rendezvous Test Client"

# Run the Phase-6 POC demo script (multi-node pair + sync flow).
poc-demo:
    @just build
    @bash {{ justfile_directory() }}/scripts/poc-demo.sh

# Reference the colour variables so the linter doesn't complain.
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ DIM }} >/dev/null || true
