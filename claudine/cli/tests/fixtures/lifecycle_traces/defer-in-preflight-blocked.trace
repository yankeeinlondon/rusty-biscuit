# scenario: defer-in-preflight-blocked
# doc: defer-in-preflight-blocked.md
# given: invoked as `claudine compose --claude defer-in-preflight-blocked.md` from the directory holding the fixture documents
# given: the start shell is not approved (no --yolo, no whitelist, no terminal), so the shell audit denies it during preflight
# given: blocked returns defer
# given: finalize runs with the blocked error; afterwards the defer raises LifecycleDeferNotImplemented, which replaces the reported error
# given: the provider never launches
event initialize
event blocked
err composition.shell_approval
event finalize
err composition.shell_approval
exit 1
