set dotenv-load := true
set positional-arguments := true

# set allow-duplicate-recipes

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"
import "../just/flow.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}Claudine ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build claudine "Claudine Library" {{ args }}
    @just _build claudine-cli "Claudine CLI" {{ args }}

# Install the CLI
install *args="":
    @just _build biscuit-terminal "biscuit-terminal Library" --release {{ args }}
    @just _build darkmatter "Darkmatter Library" --release {{ args }}
    @just build --release
    @just _install "./cli" "Claudine" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity claudine
    @just _sanity claudine-cli

# Test both library and CLI.
test *args="":
    @just _test claudine {{ args }}
    @just _test claudine-cli {{ args }}

# Level-2 PTY tests. Gated by `require_level!(Level::L2, pty_available(), ...)`;
# skip cleanly when /dev/ptmx is unavailable, hard-fail when
# BISCUIT_TEST_LEVEL_REQUIRED=2 is set.
test-l2 *args="":
    @just _test_l2 claudine-cli {{ args }}

# not applicable: claudine has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for claudine"

# not applicable: claudine emits terminal/CLI output, not HTML
test-browser:
    @echo "test-browser: not applicable for claudine"

# not applicable: claudine has no real-resource integration tier
test-real:
    @echo "test-real: not applicable for claudine"

# Lint both the library and CLI
lint:
    @just _lint claudine
    @just _lint claudine-cli

# Criterion benches for the runtime hot paths.
bench *args="":
    @just _bench claudine {{ args }}

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage claudine {{ args }}
    @just _coverage claudine-cli {{ args }}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest claudine {{ args }}
    @just _doctest claudine-cli {{ args }}

# not applicable: claudine has no cargo-fuzz targets (Phase 5 scope)
fuzz:
    @echo "fuzz: not applicable for claudine (planned Phase 5)"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint claudine || just _fix_lint claudine
    @just _lint claudine-cli || just _fix_lint claudine-cli

# Validate the source code without doing a full build
check:
    @cargo check -p claudine -p claudine-cli

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p claudine-cli {{ args }}

git-conflict:
    #!/usr/bin/env bash
    base=$(git merge-base HEAD main)
    echo "=== commits on each side ==="
    git log --oneline --left-right --graph HEAD...main

    echo
    echo "=== files changed on both sides ==="
    comm -12 \
    <(git diff --name-only $base..HEAD | sort) \
    <(git diff --name-only $base..main | sort)

    echo
    echo "=== dry-run merge preview ==="
    git merge-tree $base HEAD main

readme:
    _readme_files claudine

# the directory structure of both CLI and Library
structure:
    @echo
    @echo "{{BOLD}}{{GREEN}}Claudine CLI{{RESET}}"
    @echo
    @just _structure cli/src
    @echo
    @echo "{{BOLD}}{{GREEN}}Claudine Library{{RESET}}"
    @echo
    @just _structure lib/src
    @echo


# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
