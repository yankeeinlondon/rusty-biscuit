set dotenv-load := true
set positional-arguments := true

# set allow-duplicate-recipes

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"
import "../just/flow.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}Claudine ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build claudine "Claudine Library" {{ args }}
    @just _build claudine-cli "Claudine CLI" {{ args }}

# Install the CLI
install *args="":
    @just _build biscuit-terminal "biscuit-terminal Library" --release {{ args }}
    @just _build darkmatter "Darkmatter Library" --release {{ args }}
    @just build --release
    @just _install "./cli" "Claudine" {{ args }}

# Test both library and CLI.
test *args="":
    @just _test claudine {{ args }}
    @just _test claudine-cli {{ args }}

# Lint both the library and CLI
lint:
    @just _lint claudine
    @just _lint claudine-cli

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint claudine || just _fix_lint claudine
    @just _lint claudine-cli || just _fix_lint claudine-cli

# Validate the source code without doing a full build
check:
    @cargo check -p claudine -p claudine-cli

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p claudine-cli {{ args }}

git-conflict:
    #!/usr/bin/env bash
    base=$(git merge-base HEAD main)
    echo "=== commits on each side ==="
    git log --oneline --left-right --graph HEAD...main

    echo
    echo "=== files changed on both sides ==="
    comm -12 \
    <(git diff --name-only $base..HEAD | sort) \
    <(git diff --name-only $base..main | sort)

    echo
    echo "=== dry-run merge preview ==="
    git merge-tree $base HEAD main

readme:
    _readme_files claudine

# the directory structure of both CLI and Library
structure:
    @echo
    @echo "{{BOLD}}{{GREEN}}Claudine CLI{{RESET}}"
    @echo
    @just _structure cli/src
    @echo
    @echo "{{BOLD}}{{GREEN}}Claudine Library{{RESET}}"
    @echo
    @just _structure lib/src
    @echo


# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
