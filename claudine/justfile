set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
RESET := '\033[0m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo "Claudine (Library & CLI)"
    echo "========================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    cargo build -p claudine -p claudine-cli {{args}}

# Test both library and CLI
test:
    cargo test -p claudine -p claudine-cli

# Lint both the library and CLI
lint:
    cargo clippy -p claudine -p claudine-cli

# Lint (and fix) both the library and CLI
lint-fix *args="":
    cargo clippy --fix -p claudine -p claudine-cli {{args}}

# commits all the staged changes using GPT 5.2 (via Opencode)
commit:
    @echo "Committing staged changes in the Rusty Biscuit monorepo to git"
    @echo ""
    @opencode run commit "-f" --model "openai/gpt-5.2"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# Install the Claudine CLI
install:
    @echo ""
    @echo -e "{{BOLD}}Building Claudine Library{{RESET}}"
    @echo ""
    @cargo build -p claudine --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{YELLOW}}Installing Claudine CLI{{RESET}}"
    @cargo install --path ./cli  || ( playa effect error-2 2>/dev/null && exit 1 )

# Validate the source code without doing a full build
check:
    @cargo check -p claudine -p claudine-cli

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p claudine-cli {{args}}

# Open Claude Code in yolo mode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && opencode {{args}}

# Open Opencode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Open Codex CLI
codex *args="":
    @clear
    @echo "Loading {{BOLD}}Codex CLI{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && codex --dangerously-bypass-approvals-and-sandbox {{args}}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "claudine"

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}Claudine{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the Claudine package; use the rust, claudine, biscuit-terminal, and clap skills during the review. Write your findings to the file '@claudine/docs/{YYYY}-{MM}. claudine-review.md' (where YYYY is the current year, and MM is the current month)." "$(just deps)" {{args}} || ( so-you-say "There was a problem running the code review in the claudine package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the claudine review."  && exit 1 )
    @so-you-say "Review for claudine package has completed." >/dev/null 2>&1 || exit 0


