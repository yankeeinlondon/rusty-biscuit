set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
RESET := '\033[0m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo "Claudine (Library & CLI)"
    echo "========================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    cargo build -p claudine -p claudine-cli {{args}}

# Test both library and CLI
test:
    cargo test -p claudine -p claudine-cli

# Lint both the library and CLI
lint:
    cargo clippy -p claudine -p claudine-cli

# Lint (and fix) both the library and CLI
lint-fix *args="":
    cargo clippy --fix -p claudine -p claudine-cli {{args}}

# commits all the staged changes using GPT 5.2 (via Opencode)
commit:
    @echo "Committing staged changes in the Rusty Biscuit monorepo to git"
    @echo ""
    @opencode run commit "-f" --model "openai/gpt-5.2"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# Install the Claudine CLI
install:
    @echo -e "{{BOLD}}Building Claudine Library{{RESET}}"
    @echo ""
    @cargo build -p claudine --release
    @echo ""
    @echo ""
    @cargo install --path ./cli

# Validate the source code without doing a full build
check:
    @cargo check -p claudine -p claudine-cli
