set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Claudine"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
CLI_PATH := "./cli"
TODAY := `date +%F`


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

# play a sound effect if `playa` CLI is installed (never errors)
_play effect background="":
    @playa "{{effect}}" "{{background}}" >/dev/null 2>&1 || exit 0

_notify message title=PACKAGE:
    #!/usr/bin/env bash
    if command -v osascript &> /dev/null; then
        osascript -e 'display notification "message" with title "{{title}}"'
    elif command -v notify-send &> /dev/null; then
        notify-send '{{message}}'
    fi

_ask_opencode prompt:
    #!/usr/bin/env bash
    if command -v opencode &> /dev/null; then
        local MODEL
        MODEL="${MODEL:-minimax/MiniMax-M2.5-highspeed}"
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}using the {{BOLD}}${MODEL}{{DIM}} model with {{BOLD}}OpenCode CLI{{DIM}}.{{RESET}}"
        echo -e "{{DIM}}{{ITALIC}}- you can choose a different model by setting the {{BOLD}}MODEL{{DIM}} env variable"
        echo
        opencode run "{{prompt}}" --model "$MODEL"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}OpenCode{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}OpenCode{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_claude prompt:
    #!/usr/bin/env bash
    if command -v claude &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Claude Code{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        unset ANTHROPIC_API_KEY && claude -p "{{prompt}}"
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Claude{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_codex prompt:
    #!/usr/bin/env bash
    if command -v codex &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Codex CLI{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        codex exec "{{prompt}}"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}Codex CLI{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Codex{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi


# use an AI agent to respond to a question (uses `AGENT`)
ask prompt:
    #!/usr/bin/env bash
    if [[ "${AGENT,,}" == "opencode" ]]; then
        just _ask_opencode "{{prompt}}" || ( echo -e "- OpenCode failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    elif [[ "${AGENT,,}" == "codex"  ]]; then
        just _ask_codex "{{prompt}}" || ( echo -e "- Codex failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    else
        just _ask_claude "{{prompt}}" || ( echo -e "- will try using Opencode instead ..." && just _ask_opencode "{{prompt}}" || exit 1 )
    fi

# Ask Claude Code via a prompt file in a non-interactive session
# NOTE: just hangs when large multi-line strings are passed via {{PROMPT}} parameters.
# All callers should write their prompt to a temp file and call this recipe instead.
_claude_file PROMPT_FILE:
    #!/usr/bin/env bash
    set -euo pipefail
    echo -e "\033[2m⏳ claude is working (max 30 turns)...\033[0m" >&2
    (while true; do sleep 30; printf "." >&2; done) &
    DOTS_PID=$!
    trap 'kill $DOTS_PID 2>/dev/null || true' EXIT
    unset ANTHROPIC_API_KEY
    PROMPT_CONTENT="$(cat "{{PROMPT_FILE}}")"
    cd .. && claude --dangerously-skip-permissions --max-turns 30 -p "$PROMPT_CONTENT"
    echo -e "\n\033[2m✓ claude finished\033[0m" >&2



# Build the library and CLI
build *args="":
    @echo -e "Building {{LIB_NAME}}"
    @echo
    @cargo build -p {{LIBRARY}} {{args}} || ( just _speak "The {{LIB_NAME}} build failed!" && echo -e "\n❌ The {{LIB_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{LIB_NAME}}{{RESET}} built successfully"
    @echo
    @echo -e "Building {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{CLI}} {{args}} || ( just _speak "The {{CLI_NAME}} build failed!" && echo -e "\n❌ The {{CLI_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{CLI_NAME}}{{RESET}} built successfully"
    @echo

# Test both library and CLI
test:
    @echo
    @echo -e "🏃 Testing {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo test -p {{LIBRARY}} || ( just _speak "The {{LIB_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing tests!" && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{LIB_NAME}} has passed all tests{{RESET}}"
    @echo
    @echo -e "Testing {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo test -p "{{CLI}}" || ( just _speak "The {{CLI_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing tests!" && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{CLI_NAME}} has passed all tests{{RESET}}"

# Lint both the library and CLI
lint:
    @echo
    @echo -e "Linting {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo clippy -p {{LIBRARY}} -- -D warnings || ( just _speak "The {{LIB_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing lints!" && exit 1 )
    @echo
    @echo -e "Linting {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo clippy -p {{CLI}} -- -D warnings || ( just _speak "The {{CLI_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing lints!" && exit 1)

# Lint (and fix) both the library and CLI
lint-fix:
    @echo
    @echo -e "Linting ({{ITALIC}}with fixes{{RESET}}) {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo clippy --fix -p {{LIBRARY}} -- -D warnings || ( just _speak "The {{LIB_NAME}} has failing lints even after attempt to autofix" && @echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing lints!" && exit 1 )
    @echo
    @echo -e "Linting ({{ITALIC}}with fixes{{RESET}}) {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    cargo clippy --fix -p {{CLI}} -- -D warnings || ( just _speak "The {{CLI_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing lints!" && exit 1)

_lint_fix_library ERR_FILE:
    @echo -e "❌ {{RED}}Errors{{RESET}} {{ITALIC}}were{{RESET}} found in {{BOLD}}{{LIB_NAME}}{{RESET}}; kicking off AI to fix.\n"
    @echo "{{LIBRARY}} Fix the lint errors in {{LIB_NAME}}:" > "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @echo "" >> "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @cat {{ERR_FILE}} >> "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @just _claude_file "/tmp/{{LIBRARY}}_claude_prompt.txt" || ( so-you-say "claude code was unable to fix the lint errors" | exit 1 )
    @echo -e "\n🎉 Claude Code believes all lint errors in {{BOLD}}{{LIB_NAME}}{{RESET}} are now fixed"
    @just _speak "Claude Code believes it has fixed all lint errors in {{LIB_NAME}}"
    @cargo clippy -p {{LIBRARY}} -- -D warnings 2> "/tmp/{{LIBRARY}}_clippy_errors.txt" || ( so-you-say "it appears that claude code did NOT remove all the lint errors in {{LIB_NAME}}" && exit 1)

_lint_fix_cli ERR_FILE:
    @echo -e "❌ {{RED}}Errors{{RESET}} {{ITALIC}}were{{RESET}} found in {{BOLD}}{{CLI_NAME}}{{RESET}}; kicking off AI to fix.\n"
    @echo "/{{CLI}} Fix the lint errors in {{CLI_NAME}}:" > "/tmp/{{CLI}}_claude_prompt.txt"
    @echo "" >> "/tmp/{{CLI}}_claude_prompt.txt"
    @cat {{ERR_FILE}} >> "/tmp/{{CLI}}_claude_prompt.txt"
    @just _claude_file "/tmp/{{CLI}}_claude_prompt.txt" || ( so-you-say "claude code was unable to fix the lint errors" | exit 1 )
    @echo -e "\n🎉 Claude Code believes all lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}} are now fixed"
    @just _speak "Claude Code believes it has fixed all lint errors in {{CLI_NAME}}"
    @cargo clippy -p {{CLI}} -- -D warnings 2> "/tmp/{{CLI}}_clippy_errors.txt" || ( so-you-say "it appears that claude code did NOT remove all the lint errors in {{LIB_NAME}}" && exit 1)
    @echo -e "✅ It has been confirmed that all lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}} have been fixed"

# Fix lint errors with AI
lint-fix-ai:
    @echo
    @echo -e "Checking {{BOLD}}{{LIB_NAME}}{{RESET}} for lint errors"
    @cargo clippy -p {{LIBRARY}} -- -D warnings 2> "/tmp/{{LIBRARY}}_clippy_errors.txt" || just _lint_fix_library "/tmp/{{LIBRARY}}_clippy_errors.txt"
    @echo -e "✅ No lint errors in {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @echo -e "Checking {{BOLD}}{{CLI_NAME}}{{RESET}} for lint errors"
    @cargo clippy -p {{CLI}} -- -D warnings 2> "/tmp/{{CLI}}_clippy_errors.txt" || just _lint_fix_cli "/tmp/{{CLI}}_clippy_errors.txt"
    @echo -e "✅ No lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @just _speak "No lint errors were found in {{PACKAGE}}"

# commits all the staged changes using model from MODEL or COMMIT_MODEL in OpenCode
commit *args="":
    @echo ""
    @echo -e "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo -e "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.7-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Staged Files:{{RESET}}"
    @sniff repo staged-files || ( echo "No Staged Files! Nothing to do ..." && exit 1 )
    @claudine compose --opencode "@prompts/commit.md" --op "commit" --quiet --model "${COMMIT_MODEL:-${MODEL:-minimax/MiniMax-M2.7-highspeed}}" -y {{args}}
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff repo git-status 2>/dev/null || exit 0
    @echo

# Install the CLI
install *args="":
    @echo
    @echo -e "Building {{BOLD}}biscuit-terminal{{RESET}} Library"
    @cargo build -p biscuit-terminal --release || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo -e "Building {{BOLD}}darkmatter{{RESET}} Library"
    @cargo build -p darkmatter --release || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "{{BOLD}}Building {{LIB_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{LIBRARY}} --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "{{BOLD}}{{YELLOW}}Installing {{CLI_NAME}}{{RESET}}"
    @echo
    @cargo install --path {{CLI_PATH}} {{args}} || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{CLI_NAME}} installed{{RESET}}"
    @echo
    @playa effect drop-4 2>/dev/null || exit 0

# Validate the source code without doing a full build
check:
    @cargo check -p {{LIBRARY}} -p {{CLI}}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{CLI}} {{args}}

# Open Opencode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{args}}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{args}}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{args}}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{args}}


git-conflict:
    #!/usr/bin/env bash
    base=$(git merge-base HEAD main)
    echo "=== commits on each side ==="
    git log --oneline --left-right --graph HEAD...main

    echo
    echo "=== files changed on both sides ==="
    comm -12 \
    <(git diff --name-only $base..HEAD | sort) \
    <(git diff --name-only $base..main | sort)

    echo
    echo "=== dry-run merge preview ==="
    git merge-tree $base HEAD main


# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{LIBRARY}}*:"

prompt:
    #!/usr/bin/env bash
    FILE="./prompts/$(date +%F-%H.%M.%S-prompt.md)"
    md edit "${FILE}"
    claudine compose "${FILE}" --opencode --model zai-coding-plan/glm-5.1 --op "prompt"
    just _speak "Prompt was completed"
    if confirm "Keep prompt file?"; then
        echo -e "prompt saved as {{BLUE}}${FILE}{{RESET}}"
        echo
    else
        rm "${FILE}"
        echo -e "prompt file {{RED}}removed{{RESET}} ({{DIM}}${FILE}{{RESET}})"
    fi

# Show all README.md files in the package
readme_files:
    @sniff docs --readme --json | jq -r '[.[] | select(.relative | startswith("{{LIBRARY}}")) | "@" + .relative ] | join(" ")'

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}{{LIB_NAME}}{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the {{LIB_NAME}} package (along with the accompanying CLI package {{CLI}}); use the rust, {{LIBRARY}}, biscuit-terminal, and clap skills during the review. Write your findings to the file '@{{LIBRARY}}/docs/{YYYY}-{MM}. {{LIBRARY}}-review.md' (where YYYY is the current year, and MM is the current month).\n\n$(just deps)\n\n{{args}}"  || ( so-you-say "There was a problem running the code review in the {{LIB_NAME}} package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the {{LIB_NAME}} review."  && exit 1 )
    @echo
    @echo -e "Code Review for the {{BLUE}}{{LIB_NAME}}{{RESET}} package has completed"
    @just _speak "Review for {{LIB_NAME}} package has completed."

implement:
    @claudine compose @prompts/implement-review.md --claude -y --set '{ dir: "@claudine/features/2026-04-7-refactor-config", iteration: 1, spec: "spec.md", design: "tech-design.md", }'
    @git add . && just commit
    @claudine compose @prompts/review-feature.md --codex -y --set '{ dir: "@claudine/features/2026-04-7-refactor-config", spec: "spec.md", design: "tech-design.md", iteration: 2 }'
    @claudine compose @prompts/implement-review.md --claude -y --set '{ dir: "@claudine/features/2026-04-7-refactor-config", iteration: 2, spec: "spec.md", design: "tech-design.md" }'
    @git add . && just commit || exit 0
    @claudine compose @prompts/review-feature.md --codex -y --set '{ dir: "@claudine/features/2026-04-7-refactor-config", spec: "spec.md", design: "tech-design.md", iteration: 3 }'
    @claudine compose @prompts/implement-review.md --claude -y --set '{ dir: "@claudine/features/2026-04-7-refactor-config", iteration: 3, spec: "spec.md", design: "tech-design.md" }'
    @git add . && just commit || exit 0

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
