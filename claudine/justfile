# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity: _ensure-ctx-launch-anchor-provider-fixture
    @just _sanity_all "claudine-catalog-types claudine claudine-contract claudine-cli claudine-gen"

# test just the CLI in Claudine
test-cli *args="": _ensure-md _ensure-ctx-launch-anchor-provider-fixture
    @just _test claudine-cli {{ args }}

# test just the Claudine Library
test-library *args="":
    @just _test claudine {{ args }}

# test the rendezvous core, daemon, and test-client crates
test-rendezvous *args:
    @just _test rendezvous-core {{ args }}
    @just _test rendezvous-daemon {{ args }}
    @just _test rendezvous-client {{ args }}

# Build darkmatter's `md` into the workspace target dir, where
# `inline_compose_hash` looks for it before falling back to PATH.
#
# claudine writes a Darkmatter content hash and then verifies it round-trips by
# shelling out to `md diff`, so `md` is a test *fixture* for this area, not an
# optional convenience. CI builds only claudine's own crates, which is why
# `inline_compose_writes_hash_that_passes_md_diff` failed identically on macOS,
# Ubuntu and Windows while passing for anyone whose target dir happened to
# carry a previous build. Wiring it into the canonical recipe fixes CI and the
# clean-checkout developer with one change, the same way `_ensure-native-libs`
# serves both.
#
# Guarded on cargo's presence, not just on `md`'s absence: the `wsl2-ubuntu` leg
# runs this same recipe against a prebuilt nextest archive in a guest that has
# no Cargo and no rustc, so an unconditional build would turn every WSL2 claudine
# leg red. There it warns and leaves the one affected test to fail as it already
# does, rather than taking the whole area down with it.
_ensure-md:
    @if ! command -v md >/dev/null 2>&1 && [ ! -x ../target/debug/md ]; then \
        if command -v cargo >/dev/null 2>&1; then \
            cargo build -q -p darkmatter-cli --bin md; \
        else \
            echo "warning: 'md' not found and cargo is unavailable (prebuilt-archive run);" >&2; \
            echo "         inline_compose_writes_hash_that_passes_md_diff will fail." >&2; \
        fi; \
    fi

_ensure-ctx-launch-anchor-provider-fixture:
    @if command -v cargo >/dev/null 2>&1; then \
        cargo build -q -p claudine-cli --example ctx_launch_anchor_provider_fixture; \
    elif [ -n "${CLAUDINE_PROVIDER_FIXTURE_EXE:-}" ] && [ -f "$CLAUDINE_PROVIDER_FIXTURE_EXE" ]; then \
        :; \
    else \
        echo "warning: native provider fixture is unavailable without Cargo; Windows ctx launch-anchor tests require CLAUDINE_PROVIDER_FIXTURE_EXE" >&2; \
    fi

# Test the catalog types, library, contract adapter, CLI, and generator.
test *args="": _ensure-md _ensure-ctx-launch-anchor-provider-fixture
    @just _test_all "claudine-catalog-types claudine claudine-contract claudine-cli claudine-gen" {{ args }}

# test just the contract adapter library
test-contract *args="":
    @just _test claudine-contract {{ args }}

# Replay signal evidence fixtures through the production detection engine (requires this checkout)
signals-check:
    @cargo run -q -p claudine-cli -- signals check

# Generator suite + signal fixture replay (the corpus ↔ generated-tables CI gate)
test-gen *args="":
    @just _test claudine-gen {{ args }}
    @just signals-check

# Level-2 PTY tests. Gated by `require_level!(Level::L2, pty_available(), ...)`;
# skip cleanly when /dev/ptmx is unavailable, hard-fail when
# BISCUIT_TEST_LEVEL_REQUIRED=2 is set.
#
# claudine's L2 suite is dominated by self-isolating tests (each spawns its
# own tmux session / PTY), so it runs in `_test_l2`'s parallel self-spawn
# mode rather than the shared-pane `-j 1` path: no broker, no shared pane,
# every `shared_or_spawn()` falls back to an owned, Drop-cleaned pane. Cap
# concurrency at `min(cores, 8)` so concurrent claudine+git+tmux children
# don't saturate the host and trip nextest's slow/leak timeouts. Force the
# old serial path with `BISCUIT_L2_THREADS=1 just test-l2`.
test-l2 *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null \
        || sysctl -n hw.ncpu 2>/dev/null \
        || nproc 2>/dev/null \
        || echo 4)"
    threads=$(( cores < 8 ? cores : 8 ))
    BISCUIT_L2_THREADS="${BISCUIT_L2_THREADS:-${threads}}" just _test_l2 claudine-cli {{ args }}
    # claudine-gen owns the report-rendering L2 tests (declared in its
    # manifest). They self-isolate per test but are `#[serial]`-chained, so
    # the plain serial path — not the self-spawn mode above — is the right fit.
    just _test_l2 claudine-gen {{ args }}

# Level-3 OS-keyboard-injection tests. Gated by `require_level!(Level::L3, ...)`;
# the recipe exports RUN_LEVEL3=1, and each test also skips cleanly when its
# backend is absent (WezTerm plus the per-OS injector: cliclick on macOS,
# xdotool on Linux/X11, PowerShell SendKeys on Windows). Covers genuine OS
# Ctrl+C keystroke delivery into a real WezTerm window (signal-handling.md).
# The tmux multiplexer Ctrl+C coverage lives at L2 (`just test-l2`).
test-l3 *args="":
    @just _test_l3 claudine-cli {{ args }}

# not applicable: claudine emits terminal/CLI output, not HTML
test-browser:
    @echo "test-browser: not applicable for claudine"

# opt-in real_ tier: drive installed+authenticated providers end-to-end. Gated
# by CLAUDINE_CONTRACT_REAL=1 and the provider binary on PATH; each test skips
# cleanly when its provider/model is unavailable.
#   - contract adapter against an enabled provider (claude/codex)
# - the OpenCode YOLO subagent external-directory regression (compose CLI)
test-real *args="":
    #!/usr/bin/env bash
    # Run both real-tier binaries independently: one provider being unavailable
    # in this environment must not mask the other's result. Aggregate the exit
    # code so a genuine failure still fails the recipe.
    set -uo pipefail
    rc=0
    CLAUDINE_CONTRACT_REAL=1 cargo test -p claudine-contract --test real_provider {{ args }} || rc=$?
    CLAUDINE_CONTRACT_REAL=1 cargo test -p claudine-cli --test real_opencode_yolo_subagent {{ args }} || rc=$?
    exit $rc

# Guard against typed errors collapsing to prose anywhere in lib/src, cli/src,
# or contract/src, and against the diagnostic registry and code catalog drifting
# from the sources (error-propagation Phase 6, D2/D7/D8).
#
# A `syn` scan, not a grep: a binding is only lossy when the syntax tree proves
# it is an error *and* proves the typed value does not survive alongside the
# prose. This needs cargo — the predecessor grep did not, but it also could not
# tell `eyre!("unknown server {id}")` from a real collapse.
#
# `just test` runs these too; the recipe exists so `just lint` fails on a
# transport regression without waiting for the full suite.
lint-transport:
    @just _test claudine-cli --test error_guards

# Guard new lifecycle docs onto the faceted `err.*` contract: the deprecated
# err.kind/err.variant aliases stay inside their documentation section, and
# `err.msg` is never a match target (rendering it is correct and unrestricted —
# it is the effective diagnostic's notification-safe projection, not an alias).
# Pure grep heuristic — no cargo — so it runs even when the toolchain is gated.
lint-lifecycle-doc-facets:
    @../scripts/check-lifecycle-doc-facets.sh

# Lint the library, contract adapter, and CLI
