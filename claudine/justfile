default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}Claudine ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library, contract adapter, and CLI
build *args="":
    @just _build claudine "Claudine Library" {{ args }}
    @just _build claudine-contract "Claudine Contract Library" {{ args }}
    @just _build claudine-cli "Claudine CLI" {{ args }}

# Install the CLI
install *args="":
    @just _build biscuit-terminal "biscuit-terminal Library" --release {{ args }}
    @just _build darkmatter "Darkmatter Library" --release {{ args }}
    @just build --release
    @just _install "./cli" "Claudine" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity claudine
    @just _sanity claudine-contract
    @just _sanity claudine-cli

# test just the CLI in Claudine
test-cli *args="":
    @just _test claudine-cli {{ args }}

# test just the Claudine Library
test-library *args="":
    @just _test claudine {{ args }}

# test the rendezvous core, daemon, and test-client crates
test-rendezvous *args:
    @just _test rendezvous-core {{ args }}
    @just _test rendezvous-daemon {{ args }}
    @just _test rendezvous-client {{ args }}

# Test the library, contract adapter, and CLI.
test *args="":
    @just _test claudine {{ args }}
    @just _test claudine-contract {{ args }}
    @just _test claudine-cli {{ args }}

# test just the contract adapter library
test-contract *args="":
    @just _test claudine-contract {{ args }}

# Level-2 PTY tests. Gated by `require_level!(Level::L2, pty_available(), ...)`;
# skip cleanly when /dev/ptmx is unavailable, hard-fail when
# BISCUIT_TEST_LEVEL_REQUIRED=2 is set.
#
# claudine's L2 suite is dominated by self-isolating tests (each spawns its
# own tmux session / PTY), so it runs in `_test_l2`'s parallel self-spawn
# mode rather than the shared-pane `-j 1` path: no broker, no shared pane,
# every `shared_or_spawn()` falls back to an owned, Drop-cleaned pane. Cap
# concurrency at `min(cores, 8)` so concurrent claudine+git+tmux children
# don't saturate the host and trip nextest's slow/leak timeouts. Force the
# old serial path with `BISCUIT_L2_THREADS=1 just test-l2`.
test-l2 *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null \
        || sysctl -n hw.ncpu 2>/dev/null \
        || nproc 2>/dev/null \
        || echo 4)"
    threads=$(( cores < 8 ? cores : 8 ))
    BISCUIT_L2_THREADS="${BISCUIT_L2_THREADS:-${threads}}" just _test_l2 claudine-cli {{ args }}

# Level-3 OS-keyboard-injection tests. Gated by `require_level!(Level::L3, ...)`;
# the recipe exports RUN_LEVEL3=1, and each test also skips cleanly when its
# backend (WezTerm + cliclick, macOS only) is absent. Covers genuine OS Ctrl+C
# keystroke delivery into a real WezTerm window (signal-handling.md). The tmux
# multiplexer Ctrl+C coverage lives at L2 (`just test-l2`).
test-l3 *args="":
    @just _test_l3 claudine-cli {{ args }}

# Windows-host runtime gate for console Ctrl+Break / Job-Object parity. This
# intentionally runs the ignored Windows integration test by exact name; it must
# execute on a Windows host with an attached console.
test-windows-ctrl-c:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "${OS:-}" != "Windows_NT" ]; then
        echo "test-windows-ctrl-c must run on a Windows host with an attached console" >&2
        exit 1
    fi
    cargo test -p claudine-cli --test level3_wrap_ctrl_c -- --ignored windows_ctrl_c_verification_record

# not applicable: claudine emits terminal/CLI output, not HTML
test-browser:
    @echo "test-browser: not applicable for claudine"

# opt-in real_ tier: drive installed+authenticated providers end-to-end. Gated
# by CLAUDINE_CONTRACT_REAL=1 and the provider binary on PATH; each test skips
# cleanly when its provider/model is unavailable.
#   - contract adapter against an enabled provider (claude/codex)
# - the OpenCode YOLO subagent external-directory regression (compose CLI)
test-real *args="":
    #!/usr/bin/env bash
    # Run both real-tier binaries independently: one provider being unavailable
    # in this environment must not mask the other's result. Aggregate the exit
    # code so a genuine failure still fails the recipe.
    set -uo pipefail
    rc=0
    CLAUDINE_CONTRACT_REAL=1 cargo test -p claudine-contract --test real_provider {{ args }} || rc=$?
    CLAUDINE_CONTRACT_REAL=1 cargo test -p claudine-cli --test real_opencode_yolo_subagent {{ args }} || rc=$?
    exit $rc

# Guard against typed lower-layer errors collapsing to strings at the
# Darkmatter→Claudine / BlockError transport boundary (real-errors Phase 6).
# Pure grep heuristic — no cargo — so it runs even when the toolchain is gated.
lint-transport:
    @../scripts/check-error-transport.sh

# Guard new lifecycle docs onto the faceted `err.*` contract, keeping the
# deprecated err.kind/err.variant/err.msg aliases out of fresh examples.
# Pure grep heuristic — no cargo — so it runs even when the toolchain is gated.
lint-lifecycle-doc-facets:
    @../scripts/check-lifecycle-doc-facets.sh

# Lint the library, contract adapter, and CLI
lint:
    @just lint-transport
    @just lint-lifecycle-doc-facets
    @just _lint claudine
    @just _lint claudine-contract
    @just _lint claudine-cli

