# Validate the source code without doing a full build
check:
    @cargo check -p claudine-catalog-types -p claudine -p claudine-contract -p claudine-cli -p claudine-gen

# Type-check the library and CLI *including test targets* for Windows.
#
# The only gate that compiles the Windows-only suites (`termination/windows.rs`
# and `sequence_ctrl_c_windows.rs`). Without it they are unverifiable
# dead source that merely looks like coverage. Requires the mingw-w64 toolchain
# and the `x86_64-pc-windows-gnu` rustup target.
#
# Two host workarounds are load-bearing, not incidental:
#   - `RUSTC_WRAPPER=""` — a `rustc-wrapper` in ~/.cargo/config.toml leaks into
#     cc-rs as a compiler launcher and breaks every C build for this target.
#   - `-Wa,-mbig-obj` — duckdb's unity build (reached via the `rendezvous-daemon`
#     dev-dependency) emits objects past COFF's 32767-section limit, which
#     mingw's assembler rejects until told to use the big-object format.
check-windows:
    #!/usr/bin/env bash
    set -euo pipefail
    export RUSTC_WRAPPER=""
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target/windows-check}"
    export CFLAGS_x86_64_pc_windows_gnu="-Wa,-mbig-obj"
    export CXXFLAGS_x86_64_pc_windows_gnu="-Wa,-mbig-obj"
    cargo check -p claudine -p claudine-cli --tests --target x86_64-pc-windows-gnu

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p claudine-cli {{ args }}

# Incrementally source topic research with the given provider, 3 topics in parallel
run-fleet-research agent="codex":
    #!/usr/bin/env bash
    set -uo pipefail
    # Each fleet's `initialize` gate skips any provider whose research is fresh
    # (<14d via date_delta), so a run only sources stale/missing docs — e.g. a
    # newly-rostered provider (Antigravity) across every live topic. `memory` is
    # excluded on purpose (no docs yet, deferred B2 topic — including it would fan
    # a full research run out to every provider, not just the new one).
    cargo build -q -p claudine-cli || exit 1
    topics=(acp agent-cli agent-logging agent-models agent-permissions hooks
            local_runners mcp model-config non-interactive-sessions plugins
            resume signals skills slash-commands subagents system-prompt usage)
    failed=()
    for ((i = 0; i < ${#topics[@]}; i += 3)); do
        batch=("${topics[@]:i:3}")
        echo "▶ batch: ${batch[*]} (--{{agent}})"
        pids=()
        for t in "${batch[@]}"; do
            cargo run -q -p claudine-cli -- sequence "docs/research/$t/_fleet.md" -y --{{agent}} &
            pids+=("$!:$t")
        done
        for entry in "${pids[@]}"; do
            if ! wait "${entry%%:*}"; then failed+=("${entry#*:}"); fi
        done
    done
    if ((${#failed[@]})); then echo "✗ fleets with failures: ${failed[*]}" >&2; exit 1; fi
    echo "✓ all topic fleets completed"

# generate model enumeration using the unchained-ai codebase
generate-models:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(sniff repo root)/unchained-ai"
    just generate-models
    echo
    cd -

git-conflict:
    #!/usr/bin/env bash
    base=$(git merge-base HEAD main)
    echo "=== commits on each side ==="
    git log --oneline --left-right --graph HEAD...main

    echo
    echo "=== files changed on both sides ==="
    comm -12 \
    <(git diff --name-only $base..HEAD | sort) \
    <(git diff --name-only $base..main | sort)

    echo
    echo "=== dry-run merge preview ==="
    git merge-tree $base HEAD main

readme:
    _readme_files claudine

# publish summary research to the claudine skill
publish-summary-research:
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    dest="../.claude/skills/claudine/summaries"
    mkdir -p "${dest}"
    for src in ./docs/research/summary/*.md; do
        name="$(basename "${src}")"
        out="$(md compose "${src}")"
        # a summary whose sequence has not run yet composes to an empty body
        if [ -z "${out//[[:space:]]/}" ]; then
            echo -e "{{ DIM }}skipped ${name} (no generated body yet){{ RESET }}"
            continue
        fi
        printf '%s\n' "${out}" > "${dest}/${name}"
        echo -e "{{ GREEN }}published{{ RESET }} ${name}"
    done

# No-op recipe: reference color vars so linters won't report them as unused.

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
