@@ -0,0 +1,84 @@
+//! SPIKE (2026-10-14-union-type-constraints, Phase 1): proves the
+//! array-of-union representation end to end. Not a production test.
+
+use std::path::PathBuf;
+
+use darkmatter::markdown::Markdown;
+use darkmatter::markdown::compose::ComposeSource;
+use darkmatter::markdown::schemas::resolve::resolve_yaml_schema;
+use darkmatter::markdown::schemas::{DarkmatterSchemas, PropertyDef, SimplifiedSchema, TypeExpr};
+use serde_json::json;
+
+use crate::request_support::context_at;
+
+const POLICY: &str = "kind: schema\ntypes:\n  short_form: [\"string(pattern(^Evergreen$))\", \"string(pattern(^ValidFor))\"]\n  long_form: \"{ rule: short_form(required), action: enum(refresh, archive; required) }\"\n  policy: [short_form, long_form]\n";
+
+fn root() -> (tempfile::TempDir, PathBuf) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let root = biscuit_file::canonicalize_simplified(dir.path()).expect("canonical");
+    std::fs::write(root.join("policy.yaml"), POLICY).expect("write policy");
+    (dir, root)
+}
+
+fn valid(root: &PathBuf, frontmatter: &str) -> bool {
+    let document = format!(
+        "---\n$schema:\n  content_policy: \"policy[](min(1))@./policy.yaml\"\n{frontmatter}---\nBody\n"
+    );
+    let path = root.join("doc.md");
+    std::fs::write(&path, &document).expect("write doc");
+    let markdown = Markdown::from(document.as_str()).with_source(ComposeSource::File(path));
+    let report = DarkmatterSchemas::new(context_at(root)).validate(&markdown).expect("resolves");
+    report.valid
+}
+
+#[test]
+fn spike_union_array_lowers_to_items_any_of_and_validates() {
+    let (_dir, root) = root();
+    let declaration: serde_yaml_ng::Value =
+        serde_yaml_ng::from_str("content_policy: \"policy[](min(1))@./policy.yaml\"\n").unwrap();
+    let resolved = resolve_yaml_schema(&declaration, &root, &context_at(&root))
+        .expect("resolves");
+    let property = &resolved.json_schema["properties"]["content_policy"];
+    println!("{}", serde_json::to_string_pretty(property).unwrap());
+    let array = &property["anyOf"][1];
+    assert_eq!(property["anyOf"][0], json!({ "type": "null" }));
+    assert_eq!(array["type"], "array");
+    assert_eq!(array["minItems"], 1);
+    let arms = array["items"]["anyOf"].as_array().expect("items.anyOf");
+    assert_eq!(arms.len(), 3, "short_form's two arms flatten beside long_form");
+    assert_eq!(arms[2]["required"], json!(["rule", "action"]), "inherited required hoists to the parent");
+    assert!(arms[2]["properties"]["rule"].get("anyOf").is_some());
+
+    let Some(SimplifiedSchema::Single(shape)) = &resolved.simplified else { panic!() };
+    let Some(PropertyDef::Single(atom)) = shape.properties.get("content_policy") else { panic!() };
+    assert!(atom.is_array);
+    assert!(matches!(&atom.ty, TypeExpr::Union(arms) if arms.len() == 3));
+
+    assert!(valid(&root, "content_policy: [ValidFor(3mo), {rule: Evergreen, action: archive}]\n"));
+    assert!(valid(&root, ""));
+    assert!(valid(&root, "content_policy: null\n"));
+    assert!(!valid(&root, "content_policy: [null]\n"));
+    assert!(!valid(&root, "content_policy: ValidFor(3mo)\n"));
+    assert!(!valid(&root, "content_policy: []\n"));
+    assert!(!valid(&root, "content_policy: [Duration(3mo)]\n"));
+    assert!(!valid(&root, "content_policy: [{action: archive}]\n"));
+    assert!(!valid(&root, "content_policy: [{rule: null, action: archive}]\n"));
+    assert!(!valid(&root, "content_policy: [{rule: ValidFor(3mo), action: delete}]\n"));
+}
+
+#[test]
+fn spike_inherited_marker_hoists_without_distributing_array_bounds() {
+    let (_dir, root) = root();
+    let declaration: serde_yaml_ng::Value = serde_yaml_ng::from_str(
+        "choice: [\"string(required; min(3))\", number]\nlist: choice[](max(2))\n",
+    )
+    .unwrap();
+    let resolved = resolve_yaml_schema(&declaration, &root, &context_at(&root)).expect("resolves");
+    println!("{}", serde_json::to_string_pretty(&resolved.json_schema).unwrap());
+    let list = &resolved.json_schema["properties"]["list"];
+    assert!(resolved.json_schema["required"].as_array().unwrap().contains(&json!("list")));
+    assert_eq!(list["type"], "array", "a required array has no null wrapper");
+    assert_eq!(list["maxItems"], 2);
+    assert!(list.get("minItems").is_none(), "the arm's string min stays on the arm");
+    assert_eq!(list["items"]["anyOf"][0]["minLength"], 3);
+}
