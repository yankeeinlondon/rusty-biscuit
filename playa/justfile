set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"
import "../just/spec.just"
import "../just/flow.just"

PACKAGE := "Playa"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
CLI_PATH := "./cli"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build playa "Playa Library" {{args}}
    @just _build playa-cli "Playa CLI" {{args}}

# Install the CLI
install *args="":
    @just build --release
    @just _install "./cli" "Playa CLI" {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity playa
    @just _sanity playa-cli

# Test both library and CLI.
test *args="":
    @just _test playa {{args}}
    @just _test playa-cli {{args}}

# not applicable: playa has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for playa"

# not applicable: playa has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for playa"

# not applicable: playa emits audio, not HTML
test-browser:
    @echo "test-browser: not applicable for playa"

# Real-device/audio-output tests. Skip-clean without audio sink.
test-real *args="":
    @just _test_real playa {{args}}
    @just _test_real playa-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint playa
    @just _lint playa-cli

# not applicable: no criterion benches yet
bench:
    @echo "bench: not applicable for playa"

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage playa {{args}}
    @just _coverage playa-cli {{args}}

# Doctests.
doctest *args="":
    @just _doctest playa {{args}}
    @just _doctest playa-cli {{args}}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for playa"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint playa || just _fix_lint playa
    @just _lint playa-cli || just _fix_lint playa-cli

# Install the CLI with OS-native event-audio support stated explicitly.
# `sfx-native-audio` is already a default feature, so this matches `just install`.
install-linux-native *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    echo -e "{{ BOLD }}Building {{ LIB_NAME }}{{ RESET }}"
    echo
    cargo build -p {{ LIBRARY }} --release || ( playa effect error-2 2>/dev/null; exit 1 )
    echo
    echo -e "{{ BOLD }}{{ YELLOW }}Installing {{ CLI_NAME }} with Linux native audio{{ RESET }}"
    echo
    cargo install --path {{ CLI_PATH }} --features sfx-native-audio {{ args }} || ( playa effect error-2 2>/dev/null; exit 1 )
    echo -e "{{ BOLD }}{{ BLUE }}{{ CLI_NAME }} installed{{ RESET }}"
    echo
    playa effect drop-4 2>/dev/null || true
    @echo

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{ CLI }} {{ args }}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{ LIBRARY }}*:"

# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
