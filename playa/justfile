# set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set dotenv-load
set positional-arguments


BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo "Playa (library & CLI)"
    echo "====================="
    echo ""
    just --list | grep -v 'default'
    echo


# build the library and CLI
build *args="":
    cargo build -p playa -p playa-cli {{args}}

# Test both Library and CLI
test:
    cargo test -p playa -p playa-cli

# Lint both the Library and CLI
lint:
    cargo clippy -p playa -p playa-cli

# Lint (and fix) both the Library and CLI
lint-fix:
    cargo clippy --fix -p playa -p playa-cli

# Install the Playa CLI
install:
    @echo
    @echo "{{BOLD}}Building Playa Library{{RESET}}"
    @echo ""
    @cargo build --release -p playa
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing the Playa CLI{{RESET}}"
    @echo ""
    @cargo install --path ./cli
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Playa CLI Installed!{{RESET}}"
    @echo ""
    @playa effect drop-4 2>/dev/null || return 0

# Validate the source code without doing a full build
check:
    cargo check -p playa -p playa-cli

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# Open Claude Code in yolo mode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && echo "Loading {{BOLD}}Opencode{{RESET}}" && opencode {{args}}

# Open Opencode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Open Codex CLI
codex *args="":
    @clear
    @echo "Loading {{BOLD}}Codex CLI{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && codex --dangerously-bypass-approvals-and-sandbox {{args}}

# review this package using the Codex CLI
review *args="":
    @clear
    @echo "Performing a code review with the {{BOLD}}Codex CLI{{RESET}}"
    @cd .. && codex review "review the code in the Playa package; use the rust, playa, and clap skills during the review. Write your findings to the file 'playa/docs/{YYYY}-{MM}. playa-review.md'" {{args}} || ( so-you-say "There was a problem running the code review in the Playa package" >/dev/null 2>&1 && exit 1 )
    @so-you-say "Review for Playa package has completed." >/dev/null 2>&1 || exit 0


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
