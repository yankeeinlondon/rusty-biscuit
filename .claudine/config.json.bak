{
  "version": "1.0",
  "settings": {
    "default_log_target": null,
    "tts": null,
    "linking": {
      "preference": [
        "claude",
        "codex",
        "open_code",
        "gemini",
        "kimi_code",
        "qwen_code"
      ],
      "canonical_provider": {
        "user_skill": null,
        "user_command": null,
        "user_agent": null,
        "user_script": null,
        "repo_skill": "claude",
        "repo_command": "claude",
        "repo_agent": "claude",
        "repo_script": null
      }
    },
    "protect": {
      "enabled": true,
      "posture": "balanced",
      "allow_repo_posture_downgrade": false,
      "yolo": {
        "allow_critical_blocking": true,
        "force_advisory_for_medium_risk": true,
        "collect_forensic_trail": true
      },
      "rules": {
        "blocked_command_patterns": [],
        "ask_command_patterns": [],
        "protected_paths": [],
        "secret_patterns": []
      },
      "completion": {
        "enabled": true,
        "max_retries": 3,
        "check_commands": [],
        "secret_scan": true
      },
      "mcp": {
        "allowlist": [],
        "denylist": [],
        "redact_patterns": [],
        "block_instruction_payloads": true
      },
      "subagents": {
        "enabled": true,
        "tighten_permissions": true,
        "default_profile": "read_mostly"
      },
      "privilege": {
        "deny_when_root_without_sandbox": true,
        "require_ask_for_network_writes": true,
        "require_ask_for_broad_fs_writes": true
      },
      "providers": {
        "qwen_code": {
          "enabled": null,
          "posture": "advisory",
          "yolo": null,
          "rules": null,
          "completion": {
            "enabled": false,
            "max_retries": null,
            "check_commands": null,
            "secret_scan": null
          },
          "mcp": null,
          "subagents": null,
          "privilege": null
        },
        "codex": {
          "enabled": null,
          "posture": "advisory",
          "yolo": null,
          "rules": null,
          "completion": {
            "enabled": false,
            "max_retries": null,
            "check_commands": null,
            "secret_scan": null
          },
          "mcp": null,
          "subagents": null,
          "privilege": null
        }
      },
      "max_recent_decisions": 256
    }
  },
