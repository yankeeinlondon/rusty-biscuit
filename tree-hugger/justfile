BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'


default:
    @echo "{{BOLD}}Tree Hugger{{RESET}} CLI and Library"
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @just _build tree-hugger "Tree Hugger Library" {{args}}
    @just _build tree-hugger-cli "Tree Hugger CLI" {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity tree-hugger
    @just _sanity tree-hugger-cli

# test library and CLI
test *args="":
    @just _test tree-hugger {{args}}
    @just _test tree-hugger-cli {{args}}

# real-terminal (Level-2) tests for the `hug god-files` styled report.
#
# tree-hugger is a *nested* workspace: `tree-hugger/Cargo.toml` declares its own
# `[workspace]` listing only `cli` and `lib`. The broker package
# `biscuit-test-harness` is a member of the *root* workspace, so building it from
# here requires an explicit `--manifest-path` (a bare `-p biscuit-test-harness`
# makes cargo panic on the cross-workspace resolve). We therefore run the
# canonical broker workflow ourselves — pointing the broker build + metadata at
# the root manifest while the nextest run stays in the nested workspace — to
# preserve the repository's required L2 invariants:
#
#   1. Spawn ONE shared pane per backend via `biscuit-harness-broker` so nextest
#      children attach instead of spawning fresh panes per test.
#   2. Run nextest with `-j 1` so the `#[serial]` L2 tests share that single pane
#      without racing on GUI / global terminal state.
#   3. Tear every spawned pane down in an EXIT trap (success or failure).
#
# Backends whose tooling is missing are skipped; their `BISCUIT_SHARED_*` var
# stays unset and tests fall back to per-process spawning (which itself skips
# cleanly via `require_level!`).
test-l2 *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    echo -e "🖥  Level-2 tests for {{BOLD}}tree-hugger-cli{{RESET}}"
    echo

    # Build the broker and resolve its target dir through the ROOT manifest,
    # since `biscuit-test-harness` is not a member of this nested workspace.
    root_manifest="../Cargo.toml"
    cargo build --manifest-path "${root_manifest}" -p biscuit-test-harness --bin biscuit-harness-broker --quiet
    meta_file="$(mktemp "${TMPDIR:-/tmp}/tree-hugger-l2-meta.XXXXXX")"
    cargo metadata --manifest-path "${root_manifest}" --no-deps --format-version 1 > "${meta_file}"
    target_dir="$(jq -r '.target_directory' "${meta_file}")"
    rm -f "${meta_file}"
    broker="${target_dir}/debug/biscuit-harness-broker"
    if [[ ! -x "${broker}" ]]; then
        echo -e "{{DIM}}warning: ${broker} not executable; falling back to per-test spawning{{RESET}}"
        cargo nextest run -p tree-hugger-cli -E 'test(/level2_/)' --no-tests=pass -j 1 {{args}}
        exit $?
    fi

    # Registry of (backend id) pairs the trap consumes on EXIT to tear down the
    # panes the broker spawned.
    SHARED_REGISTRY="$(mktemp "${TMPDIR:-/tmp}/tree-hugger-l2-shared.XXXXXX")"
    trap 'while read -r b i; do "${broker}" kill "${b}" "${i}" >/dev/null 2>&1 || true; done < "${SHARED_REGISTRY}"; rm -f "${SHARED_REGISTRY}"' EXIT

    # Spawn one shared pane per backend the L2 tests attach to (wezterm, kitty,
    # tmux). Missing tooling exits non-zero and is silently skipped.
    if id="$("${broker}" spawn wezterm 2>/dev/null)" && [[ -n "${id}" ]]; then
        export BISCUIT_SHARED_WEZTERM_PANE_ID="${id}"
        echo "wezterm ${id}" >> "${SHARED_REGISTRY}"
        echo -e "  {{DIM}}spawned wezterm pane ${id}{{RESET}}"
    fi
    if id="$("${broker}" spawn kitty 2>/dev/null)" && [[ -n "${id}" ]]; then
        export BISCUIT_SHARED_KITTY_WINDOW_ID="${id}"
        echo "kitty ${id}" >> "${SHARED_REGISTRY}"
        echo -e "  {{DIM}}spawned kitty window ${id}{{RESET}}"
    fi
    if id="$("${broker}" spawn tmux 2>/dev/null)" && [[ -n "${id}" ]]; then
        export BISCUIT_SHARED_TMUX_SESSION="${id}"
        echo "tmux ${id}" >> "${SHARED_REGISTRY}"
        echo -e "  {{DIM}}spawned tmux session ${id}{{RESET}}"
    fi

    cargo nextest run -p tree-hugger-cli -E 'test(/level2_/)' --no-tests=pass -j 1 {{args}}

# not applicable: tree-hugger has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for tree-hugger"

# not applicable: tree-hugger emits symbol data, not HTML
test-browser:
    @echo "test-browser: not applicable for tree-hugger"

# not applicable: tree-hugger has no real-resource tier
test-real:
    @echo "test-real: not applicable for tree-hugger"

# lint with clippy
lint:
    @just _lint tree-hugger
    @just _lint tree-hugger-cli

# Criterion benches for tree-hugger symbol extraction.
bench *args="":
    @just _bench tree-hugger {{ args }}

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage tree-hugger {{args}}
    @just _coverage tree-hugger-cli {{args}}

# Doctests.
doctest *args="":
    @just _doctest tree-hugger {{args}}
    @just _doctest tree-hugger-cli {{args}}

# not applicable: tree-hugger has no cargo-fuzz targets yet
fuzz:
    @echo "fuzz: not applicable for tree-hugger"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

lint-fix:
    @just _lint tree-hugger || just _fix_lint tree-hugger
    @just _lint tree-hugger-cli || just _fix_lint tree-hugger-cli

# install latest release version of CLI
install *args="":
    @just build --release
    @just _install "./cli" "Tree Hugger" {{args}}

# build and show the docs for the library code
docs:
    @echo "Building and then showing latest docs for the library code"
    @echo ""
    @cargo doc -p tree-hugger --open

# build and show the docs for the tree-hugger CLI
cli_docs:
    @echo "Building and then showing latest docs for the tree-hugger CLI"
    @echo ""
    @cargo doc -p tree-hugger --open

# run the latest debug build of the CLI
hug *args="":
    @cargo run -p tree-hugger-cli -- {{args}}



# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
