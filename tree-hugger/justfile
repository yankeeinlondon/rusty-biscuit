BOLD := '\033[1m'
RESET := '\033[0m'
DOCS := ""

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

default:
    @echo "{{BOLD}}Tree Hugger{{RESET}} CLI and Library"
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @echo "Building ..."
    @echo
    @cargo build -p tree-hugger -- {{args}}
    @cargo build -p tree-hugger-cli -- {{args}}
    @echo

# test library and CLI
test *args="":
    @echo "Testing {{BOLD}}Library{{RESET}} code"
    @echo ""
    @cargo test -p tree-hugger -- {{args}}
    @echo ""
    @echo "Testing {{BOLD}}CLI{{RESET}} code"
    @echo ""
    @cargo test -p tree-hugger-cli -- {{args}}

# lint with clippy
lint *args="":
    @cargo clippy -p tree-hugger -p tree-hugger-cli -- {{args}}

# install latest release version of CLI
install *args="":
    @echo ""
    @echo "{{BOLD}}Build Tree Hugger Library{{RESET}}"
    @cargo build --release -p tree-hugger-cli  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo "{{BOLD}}{{YELLOW}}Installing Tree Hugger CLI{{RESET}}"
    @cargo install --path cli -- {{args}}  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Tree Hugger CLI installed{{RESET}}"
    @echo ""

# build and show the docs for the library code
docs:
    @echo "Building and then showing latest docs for the library code"
    @echo ""
    @cargo doc -p tree-hugger --open

# build and show the docs for the tree-hugger CLI
cli_docs:
    @echo "Building and then showing latest docs for the tree-hugger CLI"
    @echo ""
    @cargo doc -p tree-hugger --open

# run the latest debug build of the CLI
hug *args="":
    @cargo run -p tree-hugger-cli -- {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}tree-hugger{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- tree-hugger {{DOCS}} {{args}}
    @_speak "the drift recipe for the tree-hugger package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."
