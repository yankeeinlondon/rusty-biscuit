BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
PACKAGE := "Darkmatter"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
CLI_PATH := "./cli"
DOCS := ""
TODAY := `date +%F`

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library and CLI
build *args="":
    @just _build darkmatter "{{ LIB_NAME }}" {{ args }}
    @just _build darkmatter-cli "CLI_NAME" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity {{ LIBRARY }}
    @just _sanity {{ CLI }}

# Test both library and CLI. Level-1 only: the slow tiers (real-terminal,
# headless-browser, real-resource) are excluded here and run via their own
# recipes (`test-l2`, `test-browser`). The `browser_render` and
# `level2_render_tree_terminal` binary names are themselves matched by the
# `browser_`/`level2_` filter terms, so the whole binary is skipped.
test *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    filter='!(test(/level2_/) + test(/level3_/) + test(/browser_/) + test(/real_/))'
    echo
    echo -e "Testing {{ BOLD }}{{ LIBRARY }}{{ RESET }} package"
    echo
    cargo nextest run -p {{ LIBRARY }} -E "$filter" {{ args }}
    echo
    echo -e "✅ {{ GREEN }} all tests passing in {{ BOLD }}{{ LIBRARY }}{{ RESET }}{{ GREEN }} package{{ RESET }}"
    echo
    echo
    echo -e "Testing {{ BOLD }}{{ CLI }}{{ RESET }} package"
    echo
    cargo nextest run -p {{ CLI }} -E "$filter" {{ args }}
    echo
    echo -e "✅ {{ GREEN }} all tests passing in {{ BOLD }}{{ CLI }}{{ RESET }}{{ GREEN }} package{{ RESET }}"
    echo
    echo -e "👀 {{ BOLD }}Note:{{ RESET }} {{ BLUE }}just test{{ RESET }} runs Level-1 only; use {{ BLUE }}just test-l2{{ RESET }} / {{ BLUE }}just test-browser{{ RESET }} for the slow tiers"
    echo

# Level-2 (real-terminal) render-tree tests for both crates.
#
# By default, missing harnesses (WezTerm / tmux) cause the suite to skip
# cleanly. Set `BISCUIT_TEST_LEVEL_REQUIRED=2` in the environment to convert
# missing harnesses into hard failures (CI use).
test-l2 *args="":
    @echo
    @echo -e "Running {{ BOLD }}Level-2{{ RESET }} render-tree terminal tests"
    @echo -e "{{ DIM }}- export BISCUIT_TEST_LEVEL_REQUIRED=2 to hard-fail on missing harness{{ RESET }}"
    @echo
    @just _test_l2 {{ LIBRARY }} {{ args }}
    @just _test_l2 {{ CLI }} {{ args }}

# darkmatter Level-3 tests
test-l3 *args="":
    @just _test_l3 {{ LIBRARY }} {{ args }}
    @just _test_l3 {{ CLI }} {{ args }}

# Headless-browser tests (chromiumoxide). Selects every `browser_*` test in
# the library crate. Skips cleanly when Chrome is absent unless
# `BISCUIT_BROWSER_REQUIRED=1` is set.
test-browser *args="":
    @just _test_browser {{ LIBRARY }} {{ args }}

# not applicable: darkmatter has no real-resource (device / network) tier
test-real:
    @echo "test-real: not applicable for darkmatter"

# Lint both the library and CLI
lint:
    @just _lint {{ LIBRARY }}
    @just _lint {{ CLI }}

# Report CLI source/test files over the ~500-line review soft cap.
#
# Files listed in `ACCEPTED_OVERCAP` below are documented exceptions
# (see `darkmatter/features/2026-06-17-cli-atheist/spec.md` § "Accepted
# over-cap exceptions"). They are single-responsibility modules that
# grew past the soft cap without becoming god-files — splitting them
# further would create artificial fragmentation rather than reduce
# coupling. The recipe still flags any *new* over-cap file so the
# exception list stays explicit and reviewed.
lint-files:
    #!/usr/bin/env bash
    set -uo pipefail
    limit=500
    roots=(./cli/src ./cli/tests)
    # Format: "relative/path: reason". Each path must live under one of
    # `roots` and stay single-responsibility; the reason must explain why
    # the file is not a god-file despite the line count.
    ACCEPTED_OVERCAP=(
        "./cli/src/commands/compose.rs:compose subcommand; split deferred to a separate feature (spec non-goals)"
        "./cli/src/commands/schema/about.rs:SchemaAboutReport builder; one command, one struct"
        "./cli/src/commands/schema/assignment.rs:assignment parsing + schema-aware coercion for md schema validate"
        "./cli/tests/code_block.rs:exhaustive per-flag coverage of the md code-block surface"
        "./cli/tests/schema_validate.rs:per-flag coverage of the md schema validate surface"
        "./cli/tests/common/level2.rs:shared Level 2 harness — shim creation/integrity, sentinel polling, fixture runners, frame/color helpers"
    )

    is_accepted() {
        local needle="$1"
        local entry
        for entry in "${ACCEPTED_OVERCAP[@]}"; do
            if [[ "${entry%%:*}" == "$needle" ]]; then
                return 0
            fi
        done
        return 1
    }

    accepted_reason() {
        local needle="$1"
        local entry
        for entry in "${ACCEPTED_OVERCAP[@]}"; do
            if [[ "${entry%%:*}" == "$needle" ]]; then
                printf '%s\n' "${entry#*:}"
                return 0
            fi
        done
    }

    found_unaccepted=0
    saw_accepted=0
    while IFS= read -r file; do
        lines=$(wc -l < "$file" | tr -d ' ')
        if [ "$lines" -gt "$limit" ]; then
            rel="${file#./}"
            if is_accepted "$file"; then
                saw_accepted=1
                printf 'darkmatter/%s:%s lines (accepted: %s)\n' "$rel" "$lines" "$(accepted_reason "$file")"
            else
                printf 'darkmatter/%s:%s lines\n' "$rel" "$lines"
                found_unaccepted=1
            fi
        fi
    done < <(find "${roots[@]}" -type f -name '*.rs' | sort)

    if [ "$found_unaccepted" -eq 0 ]; then
        if [ "$saw_accepted" -eq 0 ]; then
            echo "No darkmatter CLI source/test files exceed ${limit} lines."
        else
            echo
            echo "All over-cap files are explicitly accepted; see spec for rationale."
        fi
    fi

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage {{ LIBRARY }} {{ args }}
    @just _coverage {{ CLI }} {{ args }}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest {{ LIBRARY }} {{ args }}
    @just _doctest {{ CLI }} {{ args }}

# Fuzz target for darkmatter markdown parser.
fuzz *args="":
    @just _fuzz lib markdown_parser {{ args }}

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# commits all the staged changes using model from MODEL or COMMIT_MODEL in OpenCode
commit args="":
    @echo ""
    @echo -e "Committing staged changes in the {{ BOLD }}Rusty Biscuit{{ RESET }} monorepo to git"
    @echo -e "{{ DIM }}{{ ITALIC }}- using the {{ RESET }}{{ ITALIC }}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M3}} {{ DIM }}model{{ RESET }}"
    @echo ""
    @echo -e "{{ BOLD }}{{ BLUE }}Staged Files:{{ RESET }}"
    @sniff repo staged-files || ( echo "No Staged Files! Nothing to do ..." && exit 1 )
    @claudine compose "@prompts/commit.md" --opencode --op "commit" --quiet -y {{ args }}
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff repo git-status 2>/dev/null || exit 0
    @echo

# Install the CLI
install *args="":
    @echo -e "Building {{ BOLD }}biscuit-terminal{{ RESET }} library"
    @cargo build -p biscuit-terminal --release || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "Building {{ BOLD }}{{ LIB_NAME }}{{ RESET }}"
    @echo
    @cargo build -p {{ LIBRARY }} --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "{{ BOLD }}{{ YELLOW }}Installing {{ CLI_NAME }}{{ RESET }}"
    @echo
    @cargo install --path {{ CLI_PATH }} {{ args }} || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo -e "{{ BOLD }}{{ BLUE }}{{ CLI_NAME }} installed{{ RESET }}"
    @just _play drop4

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }}

# ---------- benchmarking + profiling ----------

# run the full Criterion bench suite for darkmatter
bench *args="":
    @echo -e "Running Criterion benches for {{ BOLD }}{{ LIB_NAME }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- {{ args }}

# run only the schema validation benches (1000-doc corpus, warm + cold cache)
bench-schema *args="":
    @cargo bench -p {{ LIBRARY }} --bench schema_validation -- {{ args }}

# run only the compose pipeline benches (per-stage isolation)
bench-compose *args="":
    @cargo bench -p {{ LIBRARY }} --bench compose_pipeline -- {{ args }}

# run only the render pipeline benches (parse, terminal, html, highlight)
bench-render *args="":
    @cargo bench -p {{ LIBRARY }} --bench render_pipeline -- {{ args }}

# capture a saved baseline for trend tracking (usage: `just bench-baseline main`)
bench-baseline name:
    @echo -e "Saving Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- --save-baseline {{ name }}

# compare current bench timings against a saved baseline
bench-compare name:
    @echo -e "Comparing against Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- --baseline {{ name }}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{ CLI }} {{ args }}

# update the CLI documents
docs_cli:
