import "../just/features.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Darkmatter"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
CLI_PATH := "./cli"
DOCS := ""
TODAY := `date +%F`


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo



# Build the library and CLI
build *args="":
    @just _build {{LIBRARY}} "{{LIB_NAME}}" {{args}}
    @just _build {{CLI}} "CLI_NAME" {{args}}

# Test both library and CLI
test:
    @echo
    @echo -e "Testing {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @echo -e "{{DIM}}Running unit and integration tests for {{BOLD}}{{LIB_NAME}}{{RESET}}{{DIM}}...{{RESET}}"
    @cargo test -p {{LIBRARY}} --lib --tests || ( just _speak "The {{LIB_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing tests!" && exit 1 )
    @echo
    @echo -e "{{DIM}}Running doctests for {{BOLD}}{{LIB_NAME}}{{RESET}}{{DIM}}. This phase can stay quiet while merged doctests compile.{{RESET}}"
    @cargo test -p {{LIBRARY}} --doc || ( just _speak "The {{LIB_NAME}} doctests have failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} doctests have failing tests!" && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{LIB_NAME}} has passed all tests{{RESET}}"
    @echo -e "Testing {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @echo -e "{{DIM}}Running unit, binary, and integration tests for {{BOLD}}{{CLI_NAME}}{{RESET}}{{DIM}}...{{RESET}}"
    @cargo test -p "{{CLI}}" --lib --bins --tests || ( just _speak "The {{CLI_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing tests!" && exit 1 )
    @echo
    @echo -e "{{DIM}}Running doctests for {{BOLD}}{{CLI_NAME}}{{RESET}}{{DIM}}. This phase can stay quiet while merged doctests compile.{{RESET}}"
    @cargo test -p "{{CLI}}" --doc || ( just _speak "The {{CLI_NAME}} doctests have failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} doctests have failing tests!" && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{CLI_NAME}} has passed all tests{{RESET}}"

# Lint both the library and CLI
lint:
    @just _lint {{LIBRARY}}
    @just _lint {{CLI}}

# commits all the staged changes using model from MODEL or COMMIT_MODEL in OpenCode
commit:
    @echo ""
    @echo -e "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo -e "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.7-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Staged Files:{{RESET}}"
    @sniff repo staged-files || ( echo "No Staged Files! Nothing to do ..." && exit 1 )
    @claudine compose --opencode "@prompts/commit.md" --op "commit" --quiet --model "${COMMIT_MODEL:-${MODEL:-minimax/MiniMax-M2.7-highspeed}}" -y
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff repo git-status 2>/dev/null || exit 0
    @echo


# Install the CLI
install *args="":
    @echo -e "Building {{BOLD}}biscuit-terminal{{RESET}} library"
    @cargo build -p biscuit-terminal --release || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "Building {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{LIBRARY}} --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "{{BOLD}}{{YELLOW}}Installing {{CLI_NAME}}{{RESET}}"
    @echo
    @cargo install --path {{CLI_PATH}} {{args}} || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo -e "{{BOLD}}{{BLUE}}{{CLI_NAME}} installed{{RESET}}"
    @just _play drop4

# Validate the source code without doing a full build
check:
    @cargo check -p {{LIBRARY}} -p {{CLI}}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{CLI}} {{args}}

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}{{LIB_NAME}}{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the {{LIB_NAME}} package; use the rust, {{LIBRARY}}, biscuit-terminal, and clap skills during the review. Write your findings to the file '@{{LIBRARY}}/docs/{YYYY}-{MM}. {{LIBRARY}}-review.md' (where YYYY is the current year, and MM is the current month).\n\n$(just deps)\n\n{{args}}"  || ( so-you-say "There was a problem running the code review in the {{LIB_NAME}} package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the {{LIB_NAME}} review."  && exit 1 )
    @echo
    @echo -e "Code Review for the {{BLUE}}{{LIB_NAME}}{{RESET}} package has completed"
    @just _play confirmation
    @just _speak "Review for {{LIB_NAME}} package has completed."


# update the CLI documents
docs_cli:
    @echo
    @echo -e "Updating the CLI documents for {{BOLD}}Darkmatter{{RESET}}"
    @echo
    @just _claude_file ./prompts/update-cli-docs.md || ( _speak "Ran into problems updating the CLI docs for Darkmatter!" && exit 1 )
    @just _play confirmation
    @echo
    @echo -e "{{BOLD}}Darkmatter {{GREEN}}CLI Docs{{RESET}} were updated!"

docs_library:
    @echo
    @echo -e "Updating the documentation for the {{BOLD}}Darkmatter Library{{RESET}}"
    @echo
    @just _claude_file ./prompts/update-library-docs.md || ( _speak "Ran into problems updating the CLI docs for Darkmatter!" && exit 1 )
    @just _play confirmation

readme:
    _readme_files darkmatter

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} {{TODAY}} {{DOCS}} >/dev/null || true
