    @just _play drop4

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }} -p {{ CLI }} -p {{ DMLS }}
    @just check-zed

# Check the Zed WASM extension (zed-dmls) compiles against its wasm target.
#
# The extension is workspace-excluded (it targets wasm32 and carries its own
# empty `[workspace]`), so it is checked standalone. `wasm32-wasip1` is the
# target Zed compiles extensions for. Skips cleanly when the target is not
# installed so the check never fails merely because the host lacks it; install
# it with `rustup target add wasm32-wasip1` to make the compile mandatory.
check-zed:
    #!/usr/bin/env bash
    set -euo pipefail
    target="wasm32-wasip1"
    if ! rustup target list --installed 2>/dev/null | grep -qx "$target"; then
        echo -e "{{ YELLOW }}skip{{ RESET }} check-zed: rust target {{ BOLD }}$target{{ RESET }} is not installed"
        echo -e "{{ DIM }}- install it with: rustup target add $target{{ RESET }}"
        exit 0
    fi
    echo -e "Checking the {{ BOLD }}Zed WASM extension{{ RESET }} (zed-dmls) against $target"
    cargo check --manifest-path ./dmls/zed-dmls/Cargo.toml --target "$target"
    echo -e "✅ {{ GREEN }}zed-dmls compiles for $target{{ RESET }}"

# Distribution matrix (the Zed extension downloads assets by these names):
#   macOS (universal) : dmls-<version>-macos-universal.tar.gz  (lipo aarch64+x86_64)
#   Linux x86_64      : dmls-<version>-linux-x86_64.tar.gz
#   Linux aarch64     : dmls-<version>-linux-aarch64.tar.gz
#   Windows x86_64    : dmls-<version>-windows-x86_64.zip
# CI wires the full per-target build; this recipe packages the host target.

# Build a release `dmls` archive for the host, named per the distribution matrix
dist:
    #!/usr/bin/env bash
    set -euo pipefail
    version=$(cargo metadata --no-deps --format-version 1 \
        | grep -o '"name":"dmls"[^}]*"version":"[^"]*"' \
        | grep -o '"version":"[^"]*"' | head -1 | cut -d'"' -f4)
    os=$(uname -s)
    arch=$(uname -m)
    out="./dmls/dist"
    mkdir -p "$out"
    case "$os" in
        Darwin)
            echo -e "Building {{ BOLD }}macOS universal{{ RESET }} dmls $version"
            cargo build -p {{ DMLS }} --release --target aarch64-apple-darwin
            cargo build -p {{ DMLS }} --release --target x86_64-apple-darwin
            lipo -create -output "$out/dmls" \
                ../target/aarch64-apple-darwin/release/dmls \
                ../target/x86_64-apple-darwin/release/dmls
            tar -C "$out" -czf "$out/dmls-$version-macos-universal.tar.gz" dmls
            rm -f "$out/dmls"
            echo -e "{{ GREEN }}wrote{{ RESET }} $out/dmls-$version-macos-universal.tar.gz"
            ;;
        Linux)
            case "$arch" in
                aarch64|arm64) triple="linux-aarch64" ;;
                *)             triple="linux-x86_64" ;;
            esac
            echo -e "Building {{ BOLD }}$triple{{ RESET }} dmls $version"
            cargo build -p {{ DMLS }} --release
            cp ../target/release/dmls "$out/dmls"
            tar -C "$out" -czf "$out/dmls-$version-$triple.tar.gz" dmls
            rm -f "$out/dmls"
            echo -e "{{ GREEN }}wrote{{ RESET }} $out/dmls-$version-$triple.tar.gz"
            ;;
        *)
            echo -e "Building {{ BOLD }}windows-x86_64{{ RESET }} dmls $version"
            cargo build -p {{ DMLS }} --release
            cp ../target/release/dmls.exe "$out/dmls.exe"
            ( cd "$out" && zip -q "dmls-$version-windows-x86_64.zip" dmls.exe )
            rm -f "$out/dmls.exe"
            echo -e "{{ GREEN }}wrote{{ RESET }} $out/dmls-$version-windows-x86_64.zip"
            ;;
    esac

# ---------- benchmarking + profiling ----------

# run the full Criterion bench suite for darkmatter
bench *args="":
    @echo -e "Running Criterion benches for {{ BOLD }}{{ LIB_NAME }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- {{ args }}

# run only the schema validation benches (1000-doc corpus, warm + cold cache)
bench-schema *args="":
    @cargo bench -p {{ LIBRARY }} --bench schema_validation -- {{ args }}

# run only the compose pipeline benches (per-stage isolation)
bench-compose *args="":
    @cargo bench -p {{ LIBRARY }} --bench compose_pipeline -- {{ args }}

# run only the render pipeline benches (parse, terminal, html, highlight)
bench-render *args="":
    @cargo bench -p {{ LIBRARY }} --bench render_pipeline -- {{ args }}

# capture a saved baseline for trend tracking (usage: `just bench-baseline main`)
bench-baseline name:
    @echo -e "Saving Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- --save-baseline {{ name }}

# compare current bench timings against a saved baseline
bench-compare name:
    @echo -e "Comparing against Criterion baseline {{ BOLD }}{{ name }}{{ RESET }}"
    @cargo bench -p {{ LIBRARY }} --benches -- --baseline {{ name }}

# bench the DMLS workspace indexer against a deterministic synthetic corpus.
# The tier is generated once under the gitignored root target/ and reused; the
# generator is seeded (byte-identical run to run), so `rm -rf` it to refresh.
# darkmatter-5k (default) is DSL-dense (directives/$schema/interpolation edges);
# bench vault-5k for a same-size plain-Markdown/wiki control to isolate DSL cost.
# Usage: `just bench-dmls [tier] [--json]`
# tiers: tiny-100 | small-1k | vault-5k | dense-5k | darkmatter-5k (default) | pathological-1k | large-20k
bench-dmls tier="darkmatter-5k" *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    corpus="../target/dmls-bench/{{ tier }}"
    echo -e "Building {{ BOLD }}{{ DMLS_NAME }}{{ RESET }} {{ DIM }}(release){{ RESET }}"
    cargo build -p {{ DMLS }} --release
    bin="../target/release/dmls"
    if [[ -d "$corpus" ]]; then
        echo -e "{{ DIM }}Reusing {{ tier }} corpus at $corpus (rm -rf to regenerate){{ RESET }}"
    else
        echo -e "Generating {{ BOLD }}{{ tier }}{{ RESET }} corpus → $corpus"
        "$bin" --gen-corpus "{{ tier }}" "$corpus"
    fi
    echo
    echo -e "Bench-indexing {{ BOLD }}{{ tier }}{{ RESET }}"
    "$bin" --bench-index "$corpus" {{ args }}

