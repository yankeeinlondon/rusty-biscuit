default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{ BOLD }}{{ PACKAGE }} ({{ RESET }}Library & CLI{{ BOLD }}){{ RESET }}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Build the library, CLI, and language server
build *args="":
    @just _build darkmatter "{{ LIB_NAME }}" {{ args }}
    @just _build darkmatter-cli "CLI_NAME" {{ args }}
    @just _build {{ DMLS }} "{{ DMLS_NAME }}" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "{{ LIBRARY }} {{ CLI }} {{ DMLS }}"

# Test both library and CLI. Level-1 only: the slow tiers (real-terminal,
# headless-browser, real-resource) are excluded here and run via their own
# recipes (`test-l2`, `test-browser`). The `browser_render` and
# `level2_render_tree_terminal` binary names are themselves matched by the
# `browser_`/`level2_` filter terms, so the whole binary is skipped.
test *args="":
    #!/usr/bin/env bash
    set -uo pipefail
    # Unlike the shared default, darkmatter's L1 contract keeps `slow_` tests.
    export BISCUIT_TEST_FILTER='!(test(/(^|::)level2_/) + test(/(^|::)level3_/) + test(/(^|::)browser_/) + test(/(^|::)real_/))'
    exit_code=0
    just _test_all "{{ LIBRARY }} {{ CLI }} {{ DMLS }}" {{ args }} || exit_code=$?
    if (( exit_code == 130 )); then
        exit 130
    fi
    echo -e "👀 {{ BOLD }}Note:{{ RESET }} {{ BLUE }}just test{{ RESET }} runs Level-1 only; use {{ BLUE }}just test-l2{{ RESET }} / {{ BLUE }}just test-browser{{ RESET }} for the slow tiers"
    echo
    exit "${exit_code}"

# Level-2 (real-terminal) render-tree tests for both crates.
#
# By default, missing harnesses (WezTerm / tmux) cause the suite to skip
# cleanly. Set `BISCUIT_TEST_LEVEL_REQUIRED=2` in the environment to convert
# missing harnesses into hard failures (CI use).
test-l2 *args="":
    @echo
    @echo -e "Running {{ BOLD }}Level-2{{ RESET }} render-tree terminal tests"
    @echo -e "{{ DIM }}- export BISCUIT_TEST_LEVEL_REQUIRED=2 to hard-fail on missing harness{{ RESET }}"
    @echo
    @just _test_l2_all "{{ LIBRARY }} {{ CLI }} {{ DMLS }}" {{ args }}

# darkmatter Level-3 tests
test-l3 *args="":
    @just _test_l3 {{ LIBRARY }} {{ args }}
    @just _test_l3 {{ CLI }} {{ args }}

# Headless-browser tests (chromiumoxide). Selects every `browser_*` test in
# the library crate. Skips cleanly when Chrome is absent unless
# `BISCUIT_BROWSER_REQUIRED=1` is set.
test-browser *args="":
    @just _test_browser {{ LIBRARY }} {{ args }}

# not applicable: darkmatter has no real-resource (device / network) tier
test-real:
    @echo "test-real: not applicable for darkmatter"

# Lint the library, CLI, and language server
lint:
    @just _lint {{ LIBRARY }}
    @just _lint {{ CLI }}
    @just _lint {{ DMLS }}

# installs the DMLS binary into binary path
install-dmls:
    @cargo install --path ./dmls --force

# Package the DMLS VSCode extension and (re)install it into VSCode.
#
# `npm install` runs first so a fresh clone bundles the runtime deps
# (node_modules is gitignored and has no lockfile — without this the
# packaged .vsix ships no `vscode-languageclient` and silently fails to
# activate). `--force` overwrites the same 0.0.1 build on re-runs, and the
# vsix name is resolved dynamically so a version bump does not install a
# stale file. A CLI install cannot refresh an already-open VSCode window,
# so the recipe prints the reload step.
install-vscode-package:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ./dmls/vscode-dmls
    echo
    echo "Installing extension runtime dependencies…"
    npm install --silent
    echo "Packaging extension…"
    npx @vscode/vsce package --allow-missing-repository
    vsix="$(ls -t ./*.vsix | head -1)"
    echo "Installing ${vsix##*/} into VSCode…"
    code --install-extension "$vsix" --force
    echo
    echo "Installed. If VSCode is already open, reload it to activate:"
    echo "  Cmd+Shift+P → Developer: Reload Window"
    echo

# Report CLI source/test files over the ~500-line review soft cap.
#
# Files listed in `ACCEPTED_OVERCAP` below are documented exceptions
# (see `darkmatter/features/2026-06-17-cli-atheist/spec.md` § "Accepted
# over-cap exceptions"). They are single-responsibility modules that
# grew past the soft cap without becoming god-files — splitting them
# further would create artificial fragmentation rather than reduce
# coupling. The recipe still flags any *new* over-cap file so the
# exception list stays explicit and reviewed.
lint-files:
    #!/usr/bin/env bash
    set -uo pipefail
    limit=500
    roots=(./cli/src ./cli/tests)
    # Format: "relative/path: reason". Each path must live under one of
    # `roots` and stay single-responsibility; the reason must explain why
    # the file is not a god-file despite the line count.
    ACCEPTED_OVERCAP=(
        "./cli/src/commands/compose.rs:compose subcommand; split deferred to a separate feature (spec non-goals)"
        "./cli/src/commands/schema/about.rs:SchemaAboutReport builder; one command, one struct"
        "./cli/src/commands/schema/assignment.rs:assignment parsing + schema-aware coercion for md schema validate"
        "./cli/tests/code_block.rs:exhaustive per-flag coverage of the md code-block surface"
        "./cli/tests/schema_validate.rs:per-flag coverage of the md schema validate surface"
        "./cli/tests/common/level2.rs:shared Level 2 harness — shim creation/integrity, sentinel polling, fixture runners, frame/color helpers"
    )

    is_accepted() {
        local needle="$1"
        local entry
        for entry in "${ACCEPTED_OVERCAP[@]}"; do
            if [[ "${entry%%:*}" == "$needle" ]]; then
                return 0
            fi
        done
        return 1
    }

    accepted_reason() {
        local needle="$1"
        local entry
        for entry in "${ACCEPTED_OVERCAP[@]}"; do
            if [[ "${entry%%:*}" == "$needle" ]]; then
                printf '%s\n' "${entry#*:}"
                return 0
            fi
        done
    }

    found_unaccepted=0
    saw_accepted=0
    while IFS= read -r file; do
        lines=$(wc -l < "$file" | tr -d ' ')
        if [ "$lines" -gt "$limit" ]; then
            rel="${file#./}"
            if is_accepted "$file"; then
                saw_accepted=1
                printf 'darkmatter/%s:%s lines (accepted: %s)\n' "$rel" "$lines" "$(accepted_reason "$file")"
            else
                printf 'darkmatter/%s:%s lines\n' "$rel" "$lines"
                found_unaccepted=1
            fi
        fi
    done < <(find "${roots[@]}" -type f -name '*.rs' | sort)

    if [ "$found_unaccepted" -eq 0 ]; then
        if [ "$saw_accepted" -eq 0 ]; then
            echo "No darkmatter CLI source/test files exceed ${limit} lines."
        else
            echo
            echo "All over-cap files are explicitly accepted; see spec for rationale."
        fi
    fi

