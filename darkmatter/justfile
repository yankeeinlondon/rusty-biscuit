set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'

PACKAGE := "Darkmatter"
LIB_NAME := PACKAGE + " Library"
CLI_NAME := PACKAGE + " CLI"
LIBRARY := lowercase(PACKAGE)
CLI := lowercase(PACKAGE) + "-cli"
CLI_PATH := "./cli"
DOCS := ""
TODAY := `date +%F`


default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi

    echo
    echo -e "{{BOLD}}{{PACKAGE}} ({{RESET}}Library & CLI{{BOLD}}){{RESET}}"
    echo "======================================================================================"
    echo ""
    just --list | grep -v 'default'
    echo

# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

# play a sound effect if `playa` CLI is installed (never errors)
_play effect background="":
    @playa "{{effect}}" "{{background}}" >/dev/null 2>&1 || exit 0

_sound_effect effect="drop4":
    @playa effect "{{effect}}" --background 2>/dev/null || exit 0

_notify message title=PACKAGE:
    #!/usr/bin/env bash
    if command -v osascript &> /dev/null; then
        osascript -e 'display notification "message" with title "{{title}}"'
    elif command -v notify-send &> /dev/null; then
        notify-send '{{message}}'
    fi

_ask_opencode prompt:
    #!/usr/bin/env bash
    if command -v opencode &> /dev/null; then
        local MODEL
        MODEL="${MODEL:-minimax/MiniMax-M2.5-highspeed}"
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}using the {{BOLD}}${MODEL}{{DIM}} model with {{BOLD}}OpenCode CLI{{DIM}}.{{RESET}}"
        echo -e "{{DIM}}{{ITALIC}}- you can choose a different model by setting the {{BOLD}}MODEL{{DIM}} env variable"
        echo
        opencode run "{{prompt}}" --model "$MODEL"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}OpenCode{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}OpenCode{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_claude prompt:
    #!/usr/bin/env bash
    if command -v claude &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Claude Code{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        unset ANTHROPIC_API_KEY && claude -p "{{prompt}}"
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Claude{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_codex prompt:
    #!/usr/bin/env bash
    if command -v codex &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Codex CLI{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        codex exec "{{prompt}}"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}Codex CLI{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Codex{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi


# use an AI agent to respond to a question (uses `AGENT`)
ask prompt:
    #!/usr/bin/env bash
    if [[ "${AGENT,,}" == "opencode" ]]; then
        just _ask_opencode "{{prompt}}" || ( echo -e "- OpenCode failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    elif [[ "${AGENT,,}" == "codex"  ]]; then
        just _ask_codex "{{prompt}}" || ( echo -e "- Codex failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    else
        just _ask_claude "{{prompt}}" || ( echo -e "- will try using Opencode instead ..." && just _ask_opencode "{{prompt}}" || exit 1 )
    fi

# Ask Claude Code via a prompt file in a non-interactive session
# NOTE: just hangs when large multi-line strings are passed via {{PROMPT}} parameters.
# All callers should write their prompt to a temp file and call this recipe instead.
_claude_file PROMPT_FILE:
    #!/usr/bin/env bash
    set -euo pipefail
    echo -e "\033[2m⏳ claude is working (max 30 turns)...\033[0m" >&2
    (while true; do sleep 30; printf "." >&2; done) &
    DOTS_PID=$!
    trap 'kill $DOTS_PID 2>/dev/null || true' EXIT
    unset ANTHROPIC_API_KEY
    PROMPT_CONTENT="$(cat "{{PROMPT_FILE}}")"
    cd .. && claude --dangerously-skip-permissions --max-turns 30 -p "$PROMPT_CONTENT"
    echo -e "\n\033[2m✓ claude finished\033[0m" >&2




# Build the library and CLI
build *args="":
    @echo -e "Building {{LIB_NAME}}"
    @echo
    cargo build -p {{LIBRARY}} {{args}} || ( just _speak "The {{LIB_NAME}} build failed!" && echo -e "\n❌ The {{LIB_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{LIB_NAME}}{{RESET}} built successfully"
    @echo
    @echo -e "Building {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    cargo build -p {{CLI}} {{args}} || ( just _speak "The {{CLI_NAME}} build failed!" && echo -e "\n❌ The {{CLI_NAME}} build failed!" && exit 1)
    @echo
    @echo -e "✅ {{BOLD}}{{CLI_NAME}}{{RESET}} built successfully"
    @echo

# Test both library and CLI
test:
    @echo
    @echo -e "Testing {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo test -p {{LIBRARY}} || ( just _speak "The {{LIB_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing tests!" && exit 1 )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{LIB_NAME}} has passed all tests{{RESET}}"
    @echo -e "Testing {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo test -p "{{CLI}}" || ( just _speak "The {{CLI_NAME}} has failing tests" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing tests!" )
    @echo
    @echo -e "✅ {{BOLD}}{{GREEN}}{{CLI_NAME}} has passed all tests{{RESET}}"

# Lint both the library and CLI
lint:
    @echo
    @echo -e "Linting {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo clippy -p {{LIBRARY}} -- -D warnings || ( just _speak "The {{LIB_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing lints!" && exit 1 )
    @echo
    @echo -e "Linting {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    @cargo clippy -p {{CLI}} -- -D warnings || ( just _speak "The {{CLI_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing lints!" && exit 1)

# Lint (and fix) both the library and CLI
lint-fix:
    @echo
    @echo -e "Linting ({{ITALIC}}with fixes{{RESET}}) {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @cargo clippy --fix -p {{LIBRARY}} -- -D warnings || ( just _speak "The {{LIB_NAME}} has failing lints even after attempt to autofix" && echo -e "\n❌ The {{BOLD}}{{RED}}{{LIB_NAME}}{{RESET}} has failing lints!" && exit 1 )
    @echo
    @echo -e "Linting ({{ITALIC}}with fixes{{RESET}}) {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @echo
    cargo clippy --fix -p {{CLI}} -- -D warnings || ( just _speak "The {{CLI_NAME}} has failing lints" && echo -e "\n❌ The {{BOLD}}{{RED}}{{CLI_NAME}}{{RESET}} has failing lints!" && exit 1)

_lint_fix_library ERR_FILE:
    @echo -e "❌ {{RED}}Errors{{RESET}} {{ITALIC}}were{{RESET}} found in {{BOLD}}{{LIB_NAME}}{{RESET}}; kicking off AI to fix.\n"
    @echo "/{{LIBRARY}} Fix the lint errors in {{LIB_NAME}}:" > "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @echo "" >> "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @cat {{ERR_FILE}} >> "/tmp/{{LIBRARY}}_claude_prompt.txt"
    @just _claude_file "/tmp/{{LIBRARY}}_claude_prompt.txt" || ( so-you-say "claude code was unable to fix the lint errors" | exit 1 )
    @echo -e "\n🎉 Claude Code believes all lint errors in {{BOLD}}{{LIB_NAME}}{{RESET}} are now fixed"
    @just _speak "Claude Code believes it has fixed all lint errors in {{LIB_NAME}}"
    @cargo clippy -p {{LIBRARY}} -- -D warnings 2> "/tmp/{{LIBRARY}}_clippy_errors.txt" || ( so-you-say "it appears that claude code did NOT remove all the lint errors in {{LIB_NAME}}" && exit 1)

_lint_fix_cli ERR_FILE:
    @echo -e "❌ {{RED}}Errors{{RESET}} {{ITALIC}}were{{RESET}} found in {{BOLD}}{{CLI_NAME}}{{RESET}}; kicking off AI to fix.\n"
    @echo "/{{CLI}} Fix the lint errors in {{CLI_NAME}}:" > "/tmp/{{CLI}}_claude_prompt.txt"
    @echo "" >> "/tmp/{{CLI}}_claude_prompt.txt"
    @cat {{ERR_FILE}} >> "/tmp/{{CLI}}_claude_prompt.txt"
    @just _claude_file "/tmp/{{CLI}}_claude_prompt.txt" || ( so-you-say "claude code was unable to fix the lint errors" | exit 1 )
    @echo -e "\n🎉 Claude Code believes all lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}} are now fixed"
    @just _speak "Claude Code believes it has fixed all lint errors in {{CLI_NAME}}"
    @cargo clippy -p {{CLI}} -- -D warnings 2> "/tmp/{{CLI}}_clippy_errors.txt" || ( so-you-say "it appears that claude code did NOT remove all the lint errors in {{LIB_NAME}}" && exit 1)
    @echo -e "✅ It has been confirmed that all lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}} have been fixed"

# Fix lint errors with AI
lint-fix-ai:
    @echo
    @echo -e "Checking {{BOLD}}{{LIB_NAME}}{{RESET}} for lint errors"
    @cargo clippy -p {{LIBRARY}} -- -D warnings 2> "/tmp/{{LIBRARY}}_clippy_errors.txt" || just _lint_fix_library "/tmp/{{LIBRARY}}_clippy_errors.txt"
    @echo -e "✅ No lint errors in {{BOLD}}{{LIB_NAME}}{{RESET}}"
    @echo
    @echo -e "Checking {{BOLD}}{{CLI_NAME}}{{RESET}} for lint errors"
    @cargo clippy -p {{CLI}} -- -D warnings 2> "/tmp/{{CLI}}_clippy_errors.txt" || just _lint_fix_cli "/tmp/{{CLI}}_clippy_errors.txt"
    @echo -e "✅ No lint errors in {{BOLD}}{{CLI_NAME}}{{RESET}}"
    @just _speak "No lint errors were found in {{PACKAGE}}"

# commits all the staged changes using MiniMax M2.5-highspeed model in OpenCode
commit:
    @echo ""
    @echo -e "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo -e "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.5-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @claudine opencode -n "evaluate all the staged commits in the repo and then group them by scope (e.g., $(sniff repo packages)) and operation (e.g., fix, docs, chore, feat, refactor, style, perf, test, ci) and then commit each group separately using the conventional commit naming conventions with a well thought out commit message. Note: there are two cases where it's ok to have no 'scope' (aka, package) associated to a commit message:\n1. If the change appears to have no relationship to any particular package in the monorepo.\n2. If there are bunch of small changes which are all related to the same underlying event or cause and the changes do not touch any source code then it's possible to group them all into one commit which has no scope specified. Note: the action 'refactor' should be reserved for commits which have at least some source code files.\nIf no files are staged for commit then communicate this to the user and exit. Note: make sure NOT to commit everything as one commit. You are committing files in groups. IMPORTANT: remember that you are running in a non-interactive mode so you can not ask the user questions and expect a reply! DO NOT PUSH COMMITS TO THE ORIGIN. IF YOU MADE A MISTAKE ADMIT IT, EXPLAIN IT, AND STOP. NEVER USE 'git reset'!" --op "commit"
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff git 2>/dev/null || exit 0

_feature_stage feat base_dir stage:
    #!/usr/bin/env bash
    echo -e "𝌡 switching the feature.md for {{BOLD}}{{feat}}{{RESET}}'s stage from {{BOLD}}$(md get "{{base_dir}}/feature.md" stage){{RESET}} to the {{BOLD}}{{stage}}{{RESET}} stage"
    md compose "@prompts/feature.md" --fm --set '{ base_dir: "{{base_dir}}", stage: "{{stage}}", feature: "{{feat}}" }' > "{{base_dir}}/feature.md"

_feature_commit_implement feat base_dir:
    #!/usr/bin/env bash
    git add .
    echo -e "🏃 Staged all changes in the {{BOLD}}$(sniff repo package-area){{RESET}} package area"
    just _feature_stage "{{feat}}" "{{base_dir}}" "commit-implement"
    echo -e "🏃 Running the commit-implement stage"
    echo
    if claudine opencode --yolo --compose "{{base_dir}}/feature.md" --op "commit" --quiet; then
        echo
        echo -e "🎉 The implementation files have been committed to git"
    else
        just _speak "Failed to commit the implementation file for the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed to commit the implementation file for the {{feat}} feature!"
        exit 1
    fi

_feature_review feat base_dir:
    #!/usr/bin/env bash
    echo
    echo -e "🏃 Running a review on the {{feat}} feature"
    echo
    if claudine gemini --yolo --compose "{{base_dir}}/feature.md" --op "review" --quiet; then
        just _speak "The review for the {{feat}} feature is complete"
        echo
        echo -e "🎉 The review for the {{feat}} feature is complete: $(prose "<a href='{{base_dir}}/review.md'>Review Doc</a>")"
        just _feature_stage "{{feat}}" "{{base_dir}}" "suggestions"
        just _feature_suggestions "{{feat}}" "{{base_dir}}"
    else
        just _speak "Failed while running the review of the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed while running the review of the {{feat}} feature!"
        exit 1
    fi

_feature_suggestions feat base_dir:
    #!/usr/bin/env bash
    if [[ $(md get "{{base_dir}}/feature.md" stage) != "suggestions" ]]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} the _feature_suggestions recipe was called but the stage was not set to 'suggestions'!"
        echo
        exit 1
    fi
    echo
    echo -e "🏃 Starting the implementation of the review suggestions for the {{feat}} feature"
    echo
    if claudine gemini --yolo --compose "{{base_dir}}/feature.md" --op "implement-suggestions" --quiet; then
        just _speak "The review suggestions for the {{feat}} feature have been implemented"
        echo
        echo -e "🎉 The review suggestions for the {{feat}} feature have been implemented"
        just _feature_stage "{{feat}}" "{{base_dir}}" "suggestions"
        just _feature_suggestions "{{feat}}" "{{base_dir}}"
    else
        just _speak "Failed while implementing the review suggestions for {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed while implementing the review suggestions for {{feat}} feature!"
        exit 1
    fi

_feature_commit_review feat base_dir:
    #!/usr/bin/env bash
    if [[ $(md get "{{base_dir}}/feature.md" stage) != "commit-review" ]]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} the _feature_commit_review recipe was called but the stage was not set to 'commit-review'!"
        echo
        exit 1
    fi
    echo
    git add .
    echo -e "✅ All files in the $(sniff repo package-area) package area have been {{ITALIC}}staged{{RESET}} for commit"
    echo
    sniff git
    echo
    echo -e "🏃 Starting commit process"
    if claudine opencode --yolo --compose "{{base_dir}}/feature.md" --op "commit" --quiet; then
        just _speak "The review suggestions for {{feat}} have been implemented and committed to git"
        echo
        echo -e "🎉 The review suggestions for {{feat}} have been implemented and committed to git"
        just _feature_stage "{{feat}}" "{{base_dir}}" "update-docs"
        just _feature_update_docs "{{feat}}" "{{base_dir}}"
    else
        just _speak "Failed to commit the review suggestions of the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed to commit the review suggestions of the {{feat}} feature!"
        exit 1
    fi

_feature_update_docs feat base_dir:
    #!/usr/bin/env bash
        if [[ $(md get "{{base_dir}}/feature.md" stage) != "update-docs" ]]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} the _feature_update_docs recipe was called but the stage was not set to 'update_docs'!"
        echo
        exit 1
    fi
    echo
    echo -e "🏃 Updating documents to remove drift created by implementing the {{feat}} feature"
    if claudine opencode --yolo --compose "{{base_dir}}/feature.md" --op "update-docs" --quiet; then
        just _speak "The documents in $(sniff repo package-area) have been updated to accommodate the changes introduced by the {{feat}} feature"
        echo
        echo -e "🎉 The documents in $(sniff repo package-area) have been updated to accommodate the changes introduced by the {{feat}} feature"
        echo
        echo -e "🚀 the feature {{feat}} has been implemented, reviewed, and drift from docs removed!"
        echo -e "   now get out there and use the {{feat}} functionality!"
        echo
        exit
    else
        just _speak "Failed to commit the review suggestions of the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed to commit the review suggestions of the {{feat}} feature!"
        exit 1
    fi

_feature_implement feat base_dir:
    #!/usr/bin/env bash
    if claudine claude --yolo --compose "{{base_dir}}/feature.md" --op "implement" --quiet; then
        if $(sniff repo package-area-has-source-code-changes -v); then
            just _speak "The implementation for the {{feat}} feature is complete"
            echo
            echo -e "🎉 The implementation for the {{feat}} feature is complete"
            just _feature_commit_implement "{{feat}}" "{{base_dir}}"
            exit
        else
            echo -e "🐞 The implementation agent finished but did not set the 'implement_complete' flag"
            echo -e "🏃 We will turn on the error state and retry running the implementation agent"
            md set "{{base_dir}}/feature.md" error true --save
            just _feature_implement "{{feat}}" "{{base_dir}}"
            if [[ $(sniff repo package-area-has-source-code-changes -v) ]]; then
                echo -e "🎉 On the second attempt the implementation agent was successful"
                just _feature_commit_implement "{{feat}}" "{{base_dir}}"
                exit
            else
                echo -e "🤮 The second attempt with the implementation agent also did not complete!"
                just _speak "Failed implementing the {{feat}} feature!"
                echo -e "Exiting ..."
                echo
                exit 1
            fi
        fi

    else
        just _speak "Failed while implementing the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed while implementing the {{feat}} feature!"
        exit 1
    fi

_feature_plan feat base_dir:
    #!/usr/bin/env bash
    echo -e "🏃 Starting the planning process for the {{feat}} feature"
    echo
    just _feature_stage "{{feat}}" "{{base_dir}}" "plan"
    if claudine claude --yolo --compose "{{base_dir}}/feature.md" --op "plan" --quiet; then
        echo -e "🎉 The plan for the {{feat}} feature has been created"
        echo -e "🏃 Starting the implementation for the {{feat}} feature"
        just _feature_stage "{{feat}}" "{{base_dir}}" "implement"
        just _feature_implement "{{feat}}" "{{base_dir}}"
        exit
    else
        just _speak "Failed to create the planning document for the {{feat}} feature!"
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed to create the planning document for the {{feat}} feature!"
        exit 1
    fi

_feature_recover feat base_dir:
    #!/usr/bin/env bash
    echo -e "🏥 trying to recover from error so generation of the '{{feat}}' feature may continue"
    case "$(md get "{{base_dir}}/feature.md" stage --raw)" in
        plan)
            echo "plan recovery"
            exit
            ;;
        implement)
            just _feature_stage "{{feat}}" "{{base_dir}}" "implement"
            md set "{{base_dir}}/feature.md" error true --save
            just _feature_implement "{{feat}}" "{{base_dir}}"
            exit
            ;;
        commit-implement)
            echo -e "🏥 recovering to commit the implementation files"
            just _feature_stage "{{feat}}" "{{base_dir}}" "commit-implement"
            md set "{{base_dir}}/feature.md" error true --save
            just _feature_commit_implement "{{feat}}" "{{base_dir}}"
            exit
            ;;
    esac
    echo "no match"
    exit 1



# actually start the generation process
_feature_gen feat base_dir:
    #!/usr/bin/env bash
    echo
    if $(sniff repo is-current-package-area-dirty); then
        cd "$(sniff repo package-area-root)" && git add .
        echo -e "- staged all files in the {{BOLD}}$(sniff repo package-area){{RESET}} package area for commit"
        # claudine opencode --compose "@/prompts/commit.md" --op "commit"
    else
        echo -e "- the {{BOLD}}$(sniff repo package-area){{RESET}} package area is clean; not need for preparatory commits"
    fi
    echo
    echo -e "🏃 Starting the feature generation for {{BOLD}}{{feat}}{{RESET}}"
    if [ -f "{{base_dir}}/tech-design.md"  ]; then
        echo -e "🧐 the tech design document for the {{feat}} feature has already been generated"
        just _feature_stage "{{feat}}" "{{base_dir}}" "plan"
        if [ -f "{{base_dir}}/plan.md" ]; then
            echo -e "🧐 the {{BOLD}}plan{{RESET}} for the {{feat}} feature has been generated"
            echo
            if [[ $(md get "{{base_dir}}/feature.md" error) == "true" ]]; then
                just _feature_recover "{{feat}}" "{{base_dir}}"
            else
                echo -e "Unknown state; exiting..."
                exit 1
            fi
        else
            just _feature_plan "{{feat}}" "{{base_dir}}"
        fi
    else
        if claudine codex --yolo --compose "{{base_dir}}/feature.md" --op "tech-design"; then
            just _speak "The tech design document for the {{feat}} feature has been created"
            echo
            echo -e "🎉 The design document for the {{feat}} feature has been created"
            if [[ $(md get "{{base_dir}}/feature.md" error) == "true" ]]; then
                just_recover "{{feat}}" "{{base_dir}}"
                exit
            fi
            echo -e "🏃 Starting the planning for the {{feat}} feature"
            echo
            just _feature_stage "{{feat}}" "{{base_dir}}" "plan"
            just _feature_plan "{{feat}}" "{{base_dir}}"
        else
            just _speak "Failed to create the design document for the {{feat}} feature!"
            echo -e "{{BOLD}}{{RED}}Error:{{RESET}} failed to create the design document for the {{feat}} feature!"
        fi
    fi

# ensure we have tracking file and are ready to start
_feature feat base_dir:
    #!/usr/bin/env bash
    echo -e "- the feature {{BOLD}}{{feat}}{{RESET}} has a {{ITALIC}}specification{{RESET}} file [{{DIM}}spec.md{{RESET}}]"

    if [ -f "{{base_dir}}/feature.md" ]; then
        echo -e "- the tracking feature file exists and is in the {{BOLD}}$(md get "{{base_dir}}/feature.md" stage){{RESET}} [{{DIM}}feature.md{{RESET}}]"
        just _feature_gen "{{feat}}" "{{base_dir}}"
    else
        echo -e "- the feature tracking file is missing [{{DIM}}feature.md{{RESET}}]"
        if [ -f "{{base_dir}}/tech-design.md" ]; then
            echo -e "- there IS a Tech Design document [{{DIM}}tech-design.md{{RESET}}]"
            echo -e "- {{BOLD}}{{RED}}ERROR:{{RESET}} we're in an unknown state with the feature {{BOLD}}{{feat}}{{RESET}}. Exiting."
            echo
            exit 1
        else
            if [[ $(md get "{{base_dir}}/feature.md" error) == "true" ]]; then
                just _feature_recover "{{feat}}" "{{base_dir}}"
            else
                just _feature_gen "{{feat}}" "{{base_dir}}"
            fi
        fi
    fi

# allows spec to be written in editor and then we will create a feature.md
_feature_spec feat base_dir:
    #!/usr/bin/env bash
    echo -e "- the feature {{BOLD}}{{feat}}{{RESET}} doesn't have a {{ITALIC}}spec file{{RESET}} yet"
    echo -e "- sending the spec file to an editor; use {{BOLD}}EDITOR{{RESET}} or {{BOLD}}VISUAL{{RESET}}"
    mkdir -p "{{base_dir}}" >/dev/null 2>/dev/null
    if $(md edit "{{base_dir}}/spec.md"); then
        echo -e "- the {{ITALIC}}specification{{RESET}} file was created for the feature {{BOLD}}{{feat}}{{RESET}} [{{DIM}}spec.md{{RESET}}]"
        md compose "@prompts/feature.md" --fm  --state '{ base_dir: "{{base_dir}}", feature: "{{feat}}" }'  > "{{base_dir}}/feature.md"
        echo -e "- starting feature generation in {{BOLD}}{{GREEN}}$(md get "{{base_dir}}/feature.md" stage){{RESET}}"
    fi

# add a feature to this package area
feature feat:
    #!/usr/bin/env bash
    if [[ $(md get "$(sniff repo package-area-root)/features/{{feat}}/feature.md" error) == "true" ]]; then
        echo -e "⚠️ this feature -- {{ITALIC}}which was in the {{BOLD}}$(md get "$(sniff repo package-area-root)/features/{{feat}}/feature.md" stage){{RESET}}{{ITALIC}} stage {{RESET}}-- is in an error state"
        just _feature_recover "{{feat}}" "$(sniff repo package-area-root)/features/{{feat}}"
        exit
    fi
    echo
    if [ -f "$(sniff repo package-area-root)/features/{{feat}}/spec.md" ]; then
        just _feature "{{feat}}" "$(sniff repo package-area-root)/features/{{feat}}"
    else
        just _feature_spec "{{feat}}" "$(sniff repo package-area-root)/features/{{feat}}"
    fi

# Install the CLI
install *args="":
    @echo
    @echo -e "{{BOLD}}Building {{LIB_NAME}}{{RESET}}"
    @echo
    @cargo build -p {{LIBRARY}} --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo
    @echo -e "{{BOLD}}{{YELLOW}}Installing {{CLI_NAME}}{{RESET}}"
    @echo
    @cargo install --path {{CLI_PATH}} {{args}} || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo -e "{{BOLD}}{{BLUE}}{{CLI_NAME}} installed{{RESET}}"
    @just _sound_effect drop4

# Validate the source code without doing a full build
check:
    @cargo check -p {{LIBRARY}} -p {{CLI}}

# Run the latest debug build of the Claudine CLI
cli *args="":
    @cargo run -p {{CLI}} {{args}}

# Open Opencode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{args}}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{args}}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{args}}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{args}}

# Show the dependencies for this package
deps:
    @echo "Dependencies:"
    @echo "$(just -f ../justfile repo-deps 2>/dev/null)" | rg "{{LIBRARY}}*:"

readme_files:
    @sniff docs --readme --json | jq -r '[.[] | select(.relative | startswith("{{LIBRARY}}")) | "@" + .relative ] | join(" ")'

# review this package using the Codex CLI
review *args="":
    @clear
    @echo -e "Performing a code review on the {{BOLD}}{{LIB_NAME}}{{RESET}} package"
    @echo ""
    @cd .. && codex exec "/code-review the code in the {{LIB_NAME}} package; use the rust, {{LIBRARY}}, biscuit-terminal, and clap skills during the review. Write your findings to the file '@{{LIBRARY}}/docs/{YYYY}-{MM}. {{LIBRARY}}-review.md' (where YYYY is the current year, and MM is the current month).\n\n$(just deps)\n\n{{args}}"  || ( so-you-say "There was a problem running the code review in the {{LIB_NAME}} package" >/dev/null 2>&1 && echo -e "{RED}ERROR:{RESET}: problems with the {{LIB_NAME}} review."  && exit 1 )
    @echo
    @echo -e "Code Review for the {{BLUE}}{{LIB_NAME}}{{RESET}} package has completed"
    @just _sound_effect confirmation
    @just _speak "Review for {{LIB_NAME}} package has completed."


