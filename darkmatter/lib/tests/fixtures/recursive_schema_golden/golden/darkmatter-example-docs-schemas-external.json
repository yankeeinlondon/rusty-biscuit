{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string"
    },
    "color": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "red",
            "blue",
            "green"
          ]
        }
      ]
    },
    "age": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        }
      ]
    }
  },
  "required": [
    "name"
  ]
}
