{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "count": {
          "type": "number"
        }
      },
      "required": [
        "count"
      ]
    }
  ]
}
