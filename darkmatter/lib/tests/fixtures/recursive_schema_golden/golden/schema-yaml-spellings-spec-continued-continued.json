{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "t": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "a description long enough that the editor wraps it onto a second physical line"
    },
    "next": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
