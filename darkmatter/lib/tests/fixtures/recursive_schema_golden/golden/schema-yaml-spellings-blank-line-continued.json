{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 3
        }
      ],
      "description": "first paragraph\nsecond paragraph"
    },
    "next": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
