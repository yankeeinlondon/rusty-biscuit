{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        }
      ],
      "description": "the display title"
    },
    "tags": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 2
        },
        {
          "maximum": 9,
          "type": "number"
        }
      ]
    },
    "next": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
