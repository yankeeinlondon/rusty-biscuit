{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "link": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uri",
          "x-darkmatter-url-scheme": [
            "https"
          ]
        }
      ]
    }
  }
}
