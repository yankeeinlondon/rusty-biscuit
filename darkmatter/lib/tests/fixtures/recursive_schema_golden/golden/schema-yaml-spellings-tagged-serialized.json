{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 3
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "minimum": 1,
                  "type": "number"
                }
              ]
            }
          }
        }
      ]
    },
    "next": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
