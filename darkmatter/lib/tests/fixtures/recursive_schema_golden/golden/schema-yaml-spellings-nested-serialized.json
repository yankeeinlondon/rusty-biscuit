{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "meta": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "maximum": 5,
                  "type": "number"
                }
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        }
      ]
    },
    "next": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    }
  }
}
