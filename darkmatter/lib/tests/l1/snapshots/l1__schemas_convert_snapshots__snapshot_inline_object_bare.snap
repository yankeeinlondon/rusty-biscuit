---
source: darkmatter/lib/tests/l1/schemas_convert_snapshots.rs
expression: convert_yaml(yaml)
---
{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ],
              "default": 8080
            }
          },
          "required": [
            "host"
          ]
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
