---
source: darkmatter/lib/tests/l1/schemas_convert_snapshots.rs
expression: convert_yaml(yaml)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "endpoints": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "x-darkmatter-url-scheme": [
                  "https"
                ]
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE"
                ]
              },
              "timeout": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "number"
                  }
                ],
                "default": 30
              }
            },
            "required": [
              "url",
              "method"
            ]
          }
        }
      ]
    }
  }
}
