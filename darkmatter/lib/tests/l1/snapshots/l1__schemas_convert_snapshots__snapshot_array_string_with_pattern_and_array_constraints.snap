---
source: darkmatter/lib/tests/l1/schemas_convert_snapshots.rs
expression: "convert_atom(\"string(pattern(^[a-z]+$))[](min(1); max(5); unique)\")"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "field": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 5
        }
      ]
    }
  }
}
