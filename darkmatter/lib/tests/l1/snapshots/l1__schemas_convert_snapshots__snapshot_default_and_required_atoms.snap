---
source: darkmatter/lib/tests/l1/schemas_convert_snapshots.rs
expression: convert_yaml(yaml)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "\\S"
    },
    "rating": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "minimum": 0,
          "maximum": 5,
          "type": "number"
        }
      ],
      "default": 3
    }
  },
  "required": [
    "slug"
  ]
}
