{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "rating": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maximum": 5,
          "minimum": 0,
          "type": "number"
        }
      ],
      "default": 3
    },
    "slug": {
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "slug"
  ],
  "type": "object"
}
