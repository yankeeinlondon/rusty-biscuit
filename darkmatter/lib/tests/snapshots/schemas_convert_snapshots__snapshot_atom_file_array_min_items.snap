source: darkmatter/lib/tests/schemas_convert_snapshots.rs
expression: "convert_atom(\"file(match('*.png'))[](min(1))\")"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
