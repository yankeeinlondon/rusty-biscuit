+//! The schema documentation pages compose unchanged.
+//!
+//! These pages show expression syntax as examples. An inline code span does
+//! not stop document interpolation, so an example written as a bare
+//! `{{ … }}` or `{{!data:…}}` fails `md compose`; examples use the inert
+//! `{{{ … }}}` interpolation literal instead. Each test reads its page with
+//! `include_str!` so a change to that page runs it.
+
+use std::path::Path;
+
+use darkmatter::markdown::Markdown;
+use darkmatter::markdown::compose::{ComposeContext, ComposeOptions, ComposeRequest, ComposeSource};
+
+/// Composes `relative` (from the checkout root) and returns the composed text.
+///
+/// The context is captured for the page's own text only, so no repository
+/// scan runs beyond what the page reads.
+fn compose_page(relative: &str, text: &str) -> String {
+    let root = biscuit_file::canonicalize_simplified(&biscuit_test_harness::manifest_dir!().join("../..")).expect("checkout root");
+    let page = root.join(relative);
+    let directory = page.parent().map(Path::to_path_buf).expect("page directory");
+    let document = Markdown::try_from(page.as_path()).expect("page loads").with_source(ComposeSource::File(page.clone()));
+    let request = ComposeRequest::with_context(
+        ComposeOptions::new_with_context(ComposeContext::capture_for_content(&directory, text)).with_source_file(&page),
+        crate::request_support::context_at(&root),
+    )
+    .expect("request");
+    let (composed, _report) = document
+        .compose_with(&request)
+        .unwrap_or_else(|error| panic!("{relative} must compose: {error}"));
+    composed.content().to_string()
+}
+
+#[test]
+fn the_schema_definition_page_composes_with_its_examples_as_text() {
+    let text = include_str!("../../../docs/topics/schemas/definition.md");
+    let composed = compose_page("darkmatter/docs/topics/schemas/definition.md", text);
+    assert!(composed.contains("(`{{!data:v1:…}}`)"), "the literal-token example renders as text");
+    assert!(composed.contains("(`n: \"{{ 1 + }}\"`)"), "the malformed-template example renders as text");
+    assert!(composed.contains("whole-value `{{ … }}` template"), "the deferred-constraint example renders as text");
+}
+
+#[test]
+fn the_dmls_schema_support_page_composes_with_its_examples_as_text() {
+    let text = include_str!("../../../docs/topics/schemas/dmls-schema-support.md");
+    let composed = compose_page("darkmatter/docs/topics/schemas/dmls-schema-support.md", text);
+    assert!(composed.contains("`{{ … }}`"), "the template placeholder renders as text");
+    assert!(!composed.contains("{{{"), "no interpolation literal survives composition");
+}
+
+#[test]
+fn the_schema_validation_page_composes_with_its_examples_as_text() {
+    let text = include_str!("../../../docs/inline/schema-validation.md");
+    let composed = compose_page("darkmatter/docs/inline/schema-validation.md", text);
+    assert!(composed.contains("`{{ … }}`"), "the template placeholder renders as text");
+    assert!(!composed.contains("{{{"), "no interpolation literal survives composition");
+}
+
+#[test]
+fn the_schema_authoring_page_composes() {
+    let text = include_str!("../../../docs/topics/schemas/authoring-schemas.md");
+    compose_page("darkmatter/docs/topics/schemas/authoring-schemas.md", text);
+}
+
+#[test]
+fn the_lsp_configuration_page_composes() {
+    let text = include_str!("../../../docs/lsp/configuration.md");
+    compose_page("darkmatter/docs/lsp/configuration.md", text);
+}
+
+#[test]
+fn the_repository_kind_catalog_page_composes() {
+    let text = include_str!("../../../../docs/kind-documents.md");
+    compose_page("docs/kind-documents.md", text);
+}
