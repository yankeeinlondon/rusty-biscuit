set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
DOCS := ""

default:
    @echo "{{ BOLD }}Queue CLI and Library{{ RESET }}"
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @echo "Building ..."
    @echo
    @cargo build -p queue {{ args }}
    @cargo build -p queue-cli {{ args }}
    @echo

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "queue queue-cli"

# test library and CLI
test *args="":
    @just _test_all "queue queue-cli" {{ args }}

# not applicable: queue has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for queue"

# not applicable: queue has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for queue"

# not applicable: queue emits queue data, not HTML
test-browser:
    @echo "test-browser: not applicable for queue"

# not applicable: queue has no real-resource tier
test-real:
    @echo "test-real: not applicable for queue"

# lint with clippy
lint *args="":
    @cargo clippy -p queue -p queue-cli {{ args }}

# not applicable: no criterion benches yet
bench:
    @echo "bench: not applicable for queue"

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage queue {{ args }}
    @just _coverage queue-cli {{ args }}

# Doctests.
doctest *args="":
    @just _doctest queue {{ args }}
    @just _doctest queue-cli {{ args }}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for queue"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# install latest release version of CLI
install *args="":
    @echo ""
    @echo "{{ BOLD }}Building Queue Library"
    @cargo build --release -p queue
    @echo ""
    @echo "{{ BOLD }}{{ YELLOW }}Installing Queue CLI{{ RESET }}"
    @cargo install --path cli {{ args }}
    @echo ""
    @echo "{{ BOLD }}{{ BLUE }}Queue CLI Installed!{{ RESET }}"
    @echo ""

# build and show the docs for the library code
docs:
    @echo "Building and then showing latest docs for the library code"
    @echo ""
    @cargo doc -p queue --open

# run the debug release of the Queue CLI
cli *args="":
    @cargo run -p queue-cli -- {{ args }}

# commits all the staged changes using model from MODEL or COMMIT_MODEL in OpenCode
commit:
    @echo ""
    @echo -e "Committing staged changes in the {{ BOLD }}Rusty Biscuit{{ RESET }} monorepo to git"
    @echo -e "{{ DIM }}{{ ITALIC }}- using the {{ RESET }}{{ ITALIC }}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M3}} {{ DIM }}model{{ RESET }}"
    @echo ""
    @echo -e "{{ BOLD }}{{ BLUE }}Staged Files:{{ RESET }}"
    @sniff repo staged-files || ( echo "No Staged Files! Nothing to do ..." && exit 1 )
    @claudine compose --opencode "@prompts/commit.md" --op "commit" --quiet --model "${COMMIT_MODEL:-${MODEL:-minimax/MiniMax-M3}}"
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff repo git-status 2>/dev/null || exit 0
    @echo

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{ BOLD }}queue{{ RESET }} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- queue {{ DOCS }} {{ args }}
    @_speak "the drift recipe for the queue package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ BLACK }} {{ RED }} {{ GREEN }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ WHITE }} {{ DIM }} >/dev/null || true
