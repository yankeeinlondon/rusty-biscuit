set dotenv-load
set positional-arguments

BOLD := '\033[1m'
RESET := '\033[0m'

default:
    @echo "{{BOLD}}Queue CLI and Library{{RESET}}"
    @echo
    @just --list | grep -v 'default'

# build library and CLI
build *args="":
    @echo "Building ..."
    @echo
    @cargo build -p queue {{args}}
    @cargo build -p queue-cli {{args}}
    @echo

# test library and CLI
test *args="":
    @echo "Testing {{BOLD}}Library{{RESET}} code"
    @echo ""
    @cargo test -p queue {{args}}
    @echo ""
    @echo "Testing {{BOLD}}CLI{{RESET}} code"
    @echo ""
    @cargo test -p queue-cli {{args}}

# lint with clippy
lint *args="":
    @cargo clippy -p queue -p queue-cli {{args}}

# install latest release version of CLI
install *args="":
    @echo ""
    @echo "{{BOLD}}Building Queue Library"
    @cargo build --release -p queue
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Queue CLI{{RESET}}"
    @cargo install --path cli {{args}}
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Queue CLI Installed!{{RESET}}"
    @echo ""

# build and show the docs for the library code
docs:
    @echo "Building and then showing latest docs for the library code"
    @echo ""
    @cargo doc -p queue --open

# run the debug release of the Queue CLI
cli *args="":
    @cargo run -p queue-cli -- {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# fix documentation drift and update the skill
drift *args="":
    @echo
    @echo "Refreshing {{BOLD}}queue{{RESET}} skill via Rust drift script"
    @echo
    @echo "- set PREFER_AGENT=codex to force codex (default is claude)"
    @echo "- extra document paths can still be passed as drift args"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- queue {{args}}
