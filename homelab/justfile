set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""

PACKAGE := "Homelab"


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Homelab Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo


# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

play effect:
    @playa effect {{effect}} --background > /dev/null 2>&1 || exit 0

_notify message title=PACKAGE:
    #!/usr/bin/env bash
    if command -v osascript &> /dev/null; then
        osascript -e 'display notification "message" with title "{{title}}"'
    elif command -v notify-send &> /dev/null; then
        notify-send '{{message}}'
    fi

_ask_opencode prompt:
    #!/usr/bin/env bash
    if command -v opencode &> /dev/null; then
        local MODEL
        MODEL="${MODEL:-minimax/MiniMax-M2.5-highspeed}"
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}using the {{BOLD}}${MODEL}{{DIM}} model with {{BOLD}}OpenCode CLI{{DIM}}.{{RESET}}"
        echo -e "{{DIM}}{{ITALIC}}- you can choose a different model by setting the {{BOLD}}MODEL{{DIM}} env variable"
        echo
        opencode run "{{prompt}}" --model "$MODEL"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}OpenCode{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}OpenCode{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_claude prompt:
    #!/usr/bin/env bash
    if command -v claude &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Claude Code{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        unset ANTHROPIC_API_KEY && claude -p "{{prompt}}"
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Claude{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_codex prompt:
    #!/usr/bin/env bash
    if command -v codex &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Codex CLI{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        codex exec "{{prompt}}"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}Codex CLI{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Codex{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi


# use an AI agent to respond to a question (uses `AGENT`)
ask prompt:
    #!/usr/bin/env bash
    if [[ "${AGENT,,}" == "opencode" ]]; then
        just _ask_opencode "{{prompt}}" || ( echo -e "- OpenCode failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    elif [[ "${AGENT,,}" == "codex"  ]]; then
        just _ask_codex "{{prompt}}" || ( echo -e "- Codex failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    else
        just _ask_claude "{{prompt}}" || ( echo -e "- will try using Opencode instead ..." && just _ask_opencode "{{prompt}}" || exit 1 )
    fi

# build Homelab packages (lib, cli, server)
build *args="":
    @echo ""
    @echo "Build Homelab Packages (Library, Homey CLI, Server)"
    @echo "---------------------------------------------------"
    @echo ""
    @just build-frontend
    @cargo build -p homelab -p homelab-cli -p homelab-server {{args}}

# run tests for Homelab packages
test *args="":
    @echo ""
    @echo "Testing {{BOLD}}Homelab{{RESET}} ({{ITALIC}}Library, Homey CLI, Server{{RESET}})"
    @echo "-----------------------------------------------"
    @echo ""
    @cargo test -p homelab -p homelab-cli -p homelab-server {{args}}
    @just test-frontend

# run clippy on Homelab packages
lint:
    @echo ""
    @echo "Linting Homelab Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p homelab -- -D warnings
    @cargo clippy -p homelab-cli -- -D warnings
    @cargo clippy -p homelab-server -- -D warnings
    @just lint-frontend

install *args="":
    @echo ""
    @echo "{{BOLD}}Building Homelab Library{{RESET}}"
    @cargo build -p homelab --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{YELLOW}}){{RESET}}"
    @echo
    @cargo install --path ./cli {{args}}  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{BLUE}}) installed{{RESET}}"
    @echo ""
    @just play drop-4

check:
    @echo ""
    @echo "Checking Homelab Library, CLI and Server"
    @echo ""
    @cargo check -p homelab -p homelab-cli -p homelab-server

# run server in dev mode
server *args="":
    @echo ""
    @echo "{{BOLD}}Running Homelab Server{{RESET}} ({{ITALIC}}development mode{{RESET}})"
    @echo ""
    cargo run -p homelab-server {{args}}

# run tests for server only
test-server *args="":
    @echo ""
    @echo "Testing {{BOLD}}Homelab Server{{RESET}}"
    @echo ""
    @cargo test -p homelab-server {{args}}

# install server binary
install-server:
    @just build-frontend
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Homelab Server{{RESET}}"
    @cargo install --path ./server  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Homelab Server installed{{RESET}}"
    @echo ""

# build frontend SPA (installs deps if needed)
build-frontend:
    @echo ""
    @echo "{{BOLD}}Building Frontend SPA{{RESET}}"
    @cd ./server/frontend && (pnpm install --frozen-lockfile 2>/dev/null || pnpm install) && pnpm build
    @echo ""

# run frontend dev server (Vite on :5173 with proxy to :3000)
dev-frontend:
    @echo ""
    @echo "{{BOLD}}Running Frontend Dev Server{{RESET}} ({{ITALIC}}Vite on :5173{{RESET}})"
    @echo ""
    @cd server/frontend && pnpm dev

# install frontend dependencies
install-frontend:
    @cd server/frontend && pnpm install

# lint frontend code with oxlint
lint-frontend:
    @echo ""
    @echo "Linting Frontend"
    @echo ""
    @cd server/frontend && pnpm lint

# run frontend unit tests
test-frontend:
    @echo ""
    @echo "Testing Frontend"
    @echo ""
    @cd server/frontend && pnpm test

# typecheck frontend
typecheck-frontend:
    @cd server/frontend && pnpm typecheck

# Open Opencode in yolo mode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{args}}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{args}}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{args}}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{args}}

# commits all the staged changes using MiniMax M2.5-highspeed model in OpenCode
commit:
    @echo ""
    @echo "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.5-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @claudine opencode --ni "evaluate all the staged commits in the repo and then group them by scope (e.g., $(sniff repo --packages)) and operation (e.g., fix, docs, chore, feat, refactor, style, perf, test, ci) and then commit each group separately using the conventional commit naming conventions with a well thought out commit message. Note: there are two cases where it's ok to have no 'scope' (aka, package) associated to a commit message:\n1. If the change appears to have no relationship to any particular package in the monorepo.\n2. If there are bunch of small changes which are all related to the same underlying event or cause and the changes do not touch any source code then it's possible to group them all into one commit which has no scope specified. Note: the action 'refactor' should be reserved for commits which have at least some source code files.\nIf no files are staged for commit then communicate this to the user and exit. IMPORTANT: remember that you are running in a non-interactive mode so you can not ask the user questions and expect a reply!"
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff git 2>/dev/null || exit 0

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo "Staging all {{BOLD}}modified{{RESET}} or {{BOLD}}untracked{{RESET}} files for the {{PACKAGE}} package area."
    @echo ""
    @git add *
    @echo ""
    @echo "Files have been added"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just play select-4
    @echo "All committed files from {{BOLD}}{{PACKAGE}}{{RESET}} have now been pushed to remote."
    @echo

refresh-skill:
    @clear
    @echo "Refreshing {{BOLD}}Homelab{{RESET}} skill"
    @unset ANTHROPIC_API_KEY && cd .. && claude --dangerously-skip-permissions --model opus -p \'"$(cat docs/skills-homelab.md)"\'

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}homelab{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- homelab {{DOCS}} {{args}}
    @_speak "the drift recipe for the homelab package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
