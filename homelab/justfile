BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""

PACKAGE := "Homelab"


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Homelab Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build Homelab packages (lib, cli, server)
build *args="":
    @echo ""
    @echo -e "Build {{BOLD}}Homelab{{RESET}} Packages (Library, Homey CLI, Server)"
    @echo "---------------------------------------------------"
    @echo ""
    @just build-frontend
    @cargo build -p homelab -p homelab-cli -p homelab-server -p unfolded-integration-helper -p arcam-amp-integration -p eversolo-integration -p sony-receiver-integration {{args}}


# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "homelab homelab-cli homelab-server unfolded-integration-helper arcam-amp-integration eversolo-integration sony-receiver-integration"

# run tests for Homelab packages
#
# The frontend suite runs even when a Rust package failed, so one red crate
# cannot hide a red frontend; the recipe returns the combined status.
test *args="":
    #!/usr/bin/env bash
    set -uo pipefail
    exit_code=0
    just _test_all "homelab homelab-cli homelab-server unfolded-integration-helper arcam-amp-integration eversolo-integration sony-receiver-integration" {{ args }} || exit_code=$?
    if (( exit_code == 130 )); then
        exit 130
    fi
    just test-frontend || exit_code=1
    exit "${exit_code}"

# not applicable: homelab has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for homelab"

# not applicable: homelab has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for homelab"

# not applicable today; planned with the homelab-server SPA
test-browser:
    @echo "test-browser: not applicable for homelab yet"

# Real-device integration tests (read-only). See test-integrations-real-base
# for the legacy single-shot form retained for backwards compatibility.
test-real *args="":
    @just _test_real arcam-amp-integration {{ args }}
    @just _test_real sony-receiver-integration {{ args }}
    @just _test_real eversolo-integration {{ args }}

# not applicable: homelab has no criterion benches (work is device-bound I/O)
bench:
    @echo "bench: not applicable for homelab"

# Per-package LCOV coverage across the homelab crates.
coverage *args="":
    @just _coverage homelab {{ args }}
    @just _coverage homelab-cli {{ args }}
    @just _coverage homelab-server {{ args }}
    @just _coverage unfolded-integration-helper {{ args }}
    @just _coverage arcam-amp-integration {{ args }}
    @just _coverage eversolo-integration {{ args }}
    @just _coverage sony-receiver-integration {{ args }}

# Doctests across the homelab crates.
doctest *args="":
    @just _doctest homelab {{ args }}
    @just _doctest homelab-cli {{ args }}
    @just _doctest homelab-server {{ args }}
    @just _doctest unfolded-integration-helper {{ args }}
    @just _doctest arcam-amp-integration {{ args }}
    @just _doctest eversolo-integration {{ args }}
    @just _doctest sony-receiver-integration {{ args }}

# not applicable: homelab has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for homelab"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

