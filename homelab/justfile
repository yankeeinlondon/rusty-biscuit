# run opt-in ignored tests against real devices
test-integrations-real-base *args="":
    @echo ""
    @echo -e "Testing {{BOLD}}Homelab{{RESET}} Real Devices ({{ITALIC}}ignored tests only{{RESET}})"
    @echo ""
    @echo "Required env vars by package:"
    @echo "  Arcam:    ARCAM_REAL_HOST [ARCAM_REAL_PORT]"
    @echo "  Sony:     SONY_REAL_HOST [SONY_REAL_PORT]"
    @echo "  Eversolo: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT]"
    @echo ""
    @cargo test -p arcam-amp-integration real_device -- --ignored --nocapture {{args}}
    @cargo test -p sony-receiver-integration real_device -- --ignored --nocapture {{args}}
    @cargo test -p eversolo-integration real_device -- --ignored --nocapture {{args}}

# run opt-in ignored write tests against real devices; tests restore prior state
test-integrations-real-destructive *args="":
    @echo ""
    @echo -e "Testing {{BOLD}}Homelab{{RESET}} Real Devices ({{ITALIC}}destructive ignored tests{{RESET}})"
    @echo ""
    @echo "Required env vars by package:"
    @echo "  Arcam:    ARCAM_REAL_HOST [ARCAM_REAL_PORT] ARCAM_REAL_ALLOW_DESTRUCTIVE=1"
    @echo "  Sony:     SONY_REAL_HOST [SONY_REAL_PORT] SONY_REAL_ALLOW_DESTRUCTIVE=1"
    @echo "  Eversolo: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT] EVERSOLO_REAL_ALLOW_DESTRUCTIVE=1"
    @echo ""
    @cargo test -p arcam-amp-integration destructive_real_device -- --ignored --nocapture {{args}}
    @cargo test -p sony-receiver-integration destructive_real_device -- --ignored --nocapture {{args}}
    @cargo test -p eversolo-integration destructive_real_device -- --ignored --nocapture {{args}}

# run clippy on Homelab packages
lint:
    @echo ""
    @echo "Linting Homelab Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p homelab -- -D warnings
    @cargo clippy -p homelab-cli -- -D warnings
    @cargo clippy -p homelab-server -- -D warnings
    @cargo clippy -p unfolded-integration-helper -- -D warnings
    @cargo clippy -p arcam-amp-integration -- -D warnings
    @cargo clippy -p eversolo-integration -- -D warnings
    @cargo clippy -p sony-receiver-integration -- -D warnings
    @just lint-frontend

# Builds library and CLI and installs the CLI's binary
install *args="":
    @echo ""
    @echo -e "{{BOLD}}Building Homelab Library{{RESET}}"
    @cargo build -p homelab --release  || ( just _play error-2 --background && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{YELLOW}}Installing Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{YELLOW}}){{RESET}}"
    @echo
    @cargo install --path ./cli {{args}}  || ( just _play error-2 --background && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{BLUE}}) installed{{RESET}}"
    @echo ""
    @just install-integrations {{args}}
    @just _play drop-4

# install server binary
install-server:
    @just build-frontend
    @echo ""
    @echo -e "{{BOLD}}{{YELLOW}}Installing Homelab Server{{RESET}}"
    @cargo install --path ./server  || ( just _play error-2 --background  && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Homelab Server installed{{RESET}}"
    @echo ""


# install frontend dependencies
install-frontend:
    @cd server/frontend && pnpm install

# Discover the Unfolded Circle integration packages.
#
# Deliberately a recipe rather than a `VAR := \`sniff …\`` assignment: just
# evaluates top-level backticks whenever it loads this justfile, so a variable
# here would make EVERY recipe -- including the `just lint` that CI runs --
# depend on the `sniff` CLI being installed. Only the two recipes that actually
# need the list pay for it.
_integrations:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v sniff &> /dev/null; then
        echo "sniff is required to discover integration packages; run 'just init' from the repo root" >&2
        exit 1
    fi
    sniff repo packages integration --plain | tr -d ',' | tr ' ' '\n' | grep -- '-integration$' | tr '\n' ' '


build-local-integrations *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v cargo-zigbuild &> /dev/null; then
        echo -e "{{RED}}{{BOLD}}Error:{{RESET}} {{BOLD}}cargo-zigbuild{{RESET}} is not installed. Install it with: {{DIM}}cargo install cargo-zigbuild{{RESET}}"
        exit 1
    fi
    echo
    echo -e "Build all {{BOLD}}Unfolded Circle Integrations{{RESET}} for the UC Remote (aarch64-linux-musl)"
    echo -e "{{DIM}}using cargo-zigbuild for cross-compilation{{RESET}}"
    echo
    for integration in $(just _integrations); do
        echo -e "- building {{BOLD}}${integration}{{RESET}}"
        echo
        cargo zigbuild -p "${integration}" --release --target aarch64-unknown-linux-musl {{args}}
        echo -e "{{DIM}}  → ../target/aarch64-unknown-linux-musl/release/${integration}{{RESET}}"
        echo
    done

# install all Unfolded Circle integrations
install-integrations args="":
    #!/usr/bin/env bash
    set -euo pipefail
    for integration in $(just _integrations); do
        echo
        echo -e "Installing the {{BOLD}}{{BLUE}}${integration}{{RESET}} integration"
        echo
        cargo install --path "./${integration}" {{args}} || (
            just _play error-2 --background &&
            echo -e "{{RED}}{{BOLD}}Error: {{RESET}}problems installing the {{BOLD}}${integration}{{RESET}}!" &&
            exit 1
        )
        echo
        "${integration}" --help
        echo
    done
    just _speak "All Unfolded Circle integrations were installed on the host computer"

docker-build-arcam:
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    echo -e "Building a docker image for the {{BOLD}}Arcam{{RESET}} integration for the Unfolded Circle Remote"
    echo
    docker build -f arcam-amp-integration/Dockerfile -t arcam-amp-integration .. || (
        echo "Failed to build a Docker image for the Arcam integration!" &&
        just _play "error-2" &&
        just _speak "f"
    )
    echo
    echo -e "The {{BOLD}}Arcam{{RESET}}"

check:
    @echo ""
    @echo "Checking Homelab Library, CLI and Server"
    @echo ""
    @cargo check -p homelab -p homelab-cli -p homelab-server -p arcam-amp-integration -p sony-receiver-integration

