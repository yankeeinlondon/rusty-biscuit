set dotenv-load
set positional-arguments
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""

PACKAGE := "Homelab"


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Homelab Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo


# Uses TTS if available but never error
_speak *args:
    @so-you-say "{{args}}" --background >/dev/null 2>&1 || exit 0

# play a sound effect if `playa` CLI is installed (never errors)
_play effect background="":
    @playa "{{effect}}" "{{background}}" >/dev/null 2>&1 --volume 1.5 || exit 0


_notify message title=PACKAGE:
    #!/usr/bin/env bash
    if command -v osascript &> /dev/null; then
        osascript -e 'display notification "message" with title "{{title}}"'
    elif command -v notify-send &> /dev/null; then
        notify-send '{{message}}'
    fi

_ask_opencode prompt:
    #!/usr/bin/env bash
    if command -v opencode &> /dev/null; then
        local MODEL
        MODEL="${MODEL:-minimax/MiniMax-M2.5-highspeed}"
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}using the {{BOLD}}${MODEL}{{DIM}} model with {{BOLD}}OpenCode CLI{{DIM}}.{{RESET}}"
        echo -e "{{DIM}}{{ITALIC}}- you can choose a different model by setting the {{BOLD}}MODEL{{DIM}} env variable"
        echo
        opencode run "{{prompt}}" --model "$MODEL"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}OpenCode{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}OpenCode{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_claude prompt:
    #!/usr/bin/env bash
    if command -v claude &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Claude Code{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        unset ANTHROPIC_API_KEY && claude -p "{{prompt}}"
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Claude{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi

_ask_codex prompt:
    #!/usr/bin/env bash
    if command -v codex &> /dev/null; then
        echo
        echo -e "{{DIM}}{{ITALIC}}- {{RESET}}Note: {{DIM}}{{ITALIC}}using {{BOLD}}Codex CLI{{DIM}} with whatever is setup as the default model.{{RESET}}"
        echo

        codex exec "{{prompt}}"  || (
            echo
            echo -e "Attempt to use {{RED}}{{BOLD}}Codex CLI{{RESET}} for query failed! Will try using Claude instead"
            echo
            just _ask_claude "{{prompt}}"
        )
    else
        echo
        echo -e "{{RED}}{{BOLD}}ERROR:{{RESET}} the attempt to ask the {{BOLD}}Codex{{RESET}} CLI is not possible as the host system does not have it installed!"
        echo
        exit 1
    fi


# use an AI agent to respond to a question (uses `AGENT`)
ask prompt:
    #!/usr/bin/env bash
    if [[ "${AGENT,,}" == "opencode" ]]; then
        just _ask_opencode "{{prompt}}" || ( echo -e "- OpenCode failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    elif [[ "${AGENT,,}" == "codex"  ]]; then
        just _ask_codex "{{prompt}}" || ( echo -e "- Codex failed so will try using Claude Code instead ..." && just _ask_claude "{{prompt}}" || exit 1 )
    else
        just _ask_claude "{{prompt}}" || ( echo -e "- will try using Opencode instead ..." && just _ask_opencode "{{prompt}}" || exit 1 )
    fi

# build Homelab packages (lib, cli, server)
build *args="":
    @echo ""
    @echo -e "Build {{BOLD}}Homelab{{RESET}} Packages (Library, Homey CLI, Server)"
    @echo "---------------------------------------------------"
    @echo ""
    @just build-frontend
    @cargo build -p homelab -p homelab-cli -p homelab-server -p unfolded-integration-helper -p arcam-amp-integration -p eversolo-integration -p sony-receiver-integration {{args}}


# run tests for Homelab packages
test *args="":
    @echo ""
    @echo -e "Testing {{BOLD}}Homelab{{RESET}} ({{ITALIC}}Library, Homey CLI, Server{{RESET}})"
    @echo "-----------------------------------------------"
    @echo ""
    @cargo test -p homelab -p homelab-cli -p homelab-server -p unfolded-integration-helper -p arcam-amp-integration -p eversolo-integration -p sony-receiver-integration {{args}}
    @just test-frontend

# run opt-in ignored tests against real devices
test-integrations-real-base *args="":
    @echo ""
    @echo -e "Testing {{BOLD}}Homelab{{RESET}} Real Devices ({{ITALIC}}ignored tests only{{RESET}})"
    @echo ""
    @echo "Required env vars by package:"
    @echo "  Arcam:    ARCAM_REAL_HOST [ARCAM_REAL_PORT]"
    @echo "  Sony:     SONY_REAL_HOST [SONY_REAL_PORT]"
    @echo "  Eversolo: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT]"
    @echo ""
    @cargo test -p arcam-amp-integration real_device -- --ignored --nocapture {{args}}
    @cargo test -p sony-receiver-integration real_device -- --ignored --nocapture {{args}}
    @cargo test -p eversolo-integration real_device -- --ignored --nocapture {{args}}

# run opt-in ignored write tests against real devices; tests restore prior state
test-integrations-real-destructive *args="":
    @echo ""
    @echo -e "Testing {{BOLD}}Homelab{{RESET}} Real Devices ({{ITALIC}}destructive ignored tests{{RESET}})"
    @echo ""
    @echo "Required env vars by package:"
    @echo "  Arcam:    ARCAM_REAL_HOST [ARCAM_REAL_PORT] ARCAM_REAL_ALLOW_DESTRUCTIVE=1"
    @echo "  Sony:     SONY_REAL_HOST [SONY_REAL_PORT] SONY_REAL_ALLOW_DESTRUCTIVE=1"
    @echo "  Eversolo: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT] EVERSOLO_REAL_ALLOW_DESTRUCTIVE=1"
    @echo ""
    @cargo test -p arcam-amp-integration destructive_real_device -- --ignored --nocapture {{args}}
    @cargo test -p sony-receiver-integration destructive_real_device -- --ignored --nocapture {{args}}
    @cargo test -p eversolo-integration destructive_real_device -- --ignored --nocapture {{args}}

# run clippy on Homelab packages
lint:
    @echo ""
    @echo "Linting Homelab Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p homelab -- -D warnings
    @cargo clippy -p homelab-cli -- -D warnings
    @cargo clippy -p homelab-server -- -D warnings
    @cargo clippy -p unfolded-integration-helper -- -D warnings
    @cargo clippy -p arcam-amp-integration -- -D warnings
    @cargo clippy -p eversolo-integration -- -D warnings
    @cargo clippy -p sony-receiver-integration -- -D warnings
    @just lint-frontend

# Builds library and CLI and installs the CLI's binary
install *args="":
    @echo ""
    @echo -e "{{BOLD}}Building Homelab Library{{RESET}}"
    @cargo build -p homelab --release  || ( just _play error-2 --background && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{YELLOW}}Installing Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{YELLOW}}){{RESET}}"
    @echo
    @cargo install --path ./cli {{args}}  || ( just _play error-2 --background && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{BLUE}}) installed{{RESET}}"
    @echo ""
    @just install-integrations {{args}}
    @just _play drop-4

# install server binary
install-server:
    @just build-frontend
    @echo ""
    @echo -e "{{BOLD}}{{YELLOW}}Installing Homelab Server{{RESET}}"
    @cargo install --path ./server  || ( just _play error-2 --background  && exit 1 )
    @echo ""
    @echo -e "{{BOLD}}{{BLUE}}Homelab Server installed{{RESET}}"
    @echo ""


# install frontend dependencies
install-frontend:
    @cd server/frontend && pnpm install

INTEGRATIONS := `sniff repo --packages integration | tr -d ',' | tr ' ' '\n' | grep -- '-integration$' | tr '\n' ' '`

build-local-integrations *args="":
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v cargo-zigbuild &> /dev/null; then
        echo -e "{{RED}}{{BOLD}}Error:{{RESET}} {{BOLD}}cargo-zigbuild{{RESET}} is not installed. Install it with: {{DIM}}cargo install cargo-zigbuild{{RESET}}"
        exit 1
    fi
    echo
    echo -e "Build all {{BOLD}}Unfolded Circle Integrations{{RESET}} for the UC Remote (aarch64-linux-musl)"
    echo -e "{{DIM}}using cargo-zigbuild for cross-compilation{{RESET}}"
    echo
    for integration in {{INTEGRATIONS}}; do
        echo -e "- building {{BOLD}}${integration}{{RESET}}"
        echo
        cargo zigbuild -p "${integration}" --release --target aarch64-unknown-linux-musl {{args}}
        echo -e "{{DIM}}  → ../target/aarch64-unknown-linux-musl/release/${integration}{{RESET}}"
        echo
    done

# install all Unfolded Circle integrations
install-integrations args="":
    #!/usr/bin/env bash
    set -euo pipefail
    for integration in {{INTEGRATIONS}}; do
        echo
        echo -e "Installing the {{BOLD}}{{BLUE}}${integration}{{RESET}} integration"
        echo
        cargo install --path "./${integration}" {{args}} || (
            just _play error-2 --background &&
            echo -e "{{RED}}{{BOLD}}Error: {{RESET}}problems installing the {{BOLD}}${integration}{{RESET}}!" &&
            exit 1
        )
        echo
        "${integration}" --help
        echo
    done
    just _speak "All Unfolded Circle integrations were installed on the host computer"

docker-build-arcam:
    #!/usr/bin/env bash
    set -euo pipefail
    echo
    echo -e "Building a docker image for the {{BOLD}}Arcam{{RESET}} integration for the Unfolded Circle Remote"
    echo
    docker build -f arcam-amp-integration/Dockerfile -t arcam-amp-integration .. || (
        echo "Failed to build a Docker image for the Arcam integration!" &&
        just _play "error-2" &&
        just _speak "f"
    )
    echo
    echo -e "The {{BOLD}}Arcam{{RESET}}"

check:
    @echo ""
