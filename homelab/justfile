set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Homelab Library & CLI"
        echo "====================="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build Homelab packages (lib, cli, server)
build *args="":
    @echo ""
    @echo "Build Homelab Packages (Library, Homey CLI, Server)"
    @echo "---------------------------------------------------"
    @echo ""
    @cargo build -p homelab -p homey -p homelab-server {{args}}

# run tests for Homelab packages
test *args="":
    @echo ""
    @echo "Testing {{BOLD}}Homelab{{RESET}} ({{ITALIC}}Library, Homey CLI, Server{{RESET}})"
    @echo "-----------------------------------------------"
    @echo ""
    @cargo test -p homelab -p homey -p homelab-server {{args}}

# run clippy on Homelab packages
lint:
    @echo ""
    @echo "Linting Homelab Packages"
    @echo "--------------------------"
    @echo ""
    @cargo clippy -p homelab -- -D warnings
    @cargo clippy -p homey -- -D warnings
    @cargo clippy -p homelab-server -- -D warnings

install:
    @echo ""
    @echo "{{BOLD}}Building Homelab Library{{RESET}}"
    @cargo build -p homelab --release  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{YELLOW}}){{RESET}}"
    @cargo install --path ./cli  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Homelab CLI ({{ITALIC}}homey{{RESET}}{{BOLD}}{{BLUE}}) installed{{RESET}}"
    @echo ""
    @playa effect drop-4 2>/dev/null || return 0

check:
    @echo ""
    @echo "Checking Homelab Library, CLI and Server"
    @echo ""
    @cargo check -p homelab -p homey -p homelab-server

# run server in dev mode
server *args="":
    @echo ""
    @echo "{{BOLD}}Running Homelab Server{{RESET}} ({{ITALIC}}development mode{{RESET}})"
    @echo ""
    cargo run -p homelab-server {{args}}

# run tests for server only
test-server *args="":
    @echo ""
    @echo "Testing {{BOLD}}Homelab Server{{RESET}}"
    @echo ""
    @cargo test -p homelab-server {{args}}

# install server binary
install-server:
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Homelab Server{{RESET}}"
    @cargo install --path ./server  || ( playa effect error-2 2>/dev/null && exit 1 )
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Homelab Server installed{{RESET}}"
    @echo ""

# Open Opencode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && opencode {{args}}

# Open Claude Code in yolo mode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && claude --dangerously-skip-permissions {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

refresh-skill:
    @clear
    @echo "Refreshing {{BOLD}}Homelab{{RESET}} skill"
    @unset ANTHROPIC_API_KEY && cd .. && claude --dangerously-skip-permissions --model opus -p \'"$(cat docs/skills-homelab.md)"\'


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
