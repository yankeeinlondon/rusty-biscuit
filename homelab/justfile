# Open Opencode in yolo mode
oc *args="":
    @claudine opencode --include GEMINI_API_KEY --include X_AI_API_KEY --include ZAI_API_KEY --include ZENMUX_API_KEY --include OPEN_ROUTER_API_KEY {{args}}

# Open Claude Code in YOLO mode
cc *args="":
    @claudine claude --yolo {{args}}

# Open codex in YOLO mode
codex *args="":
    @claudine codex --yolo {{args}}

# Open Claude Code
gem *args="":
    @claudine gemini --yolo --include GEMINI_API_KEY {{args}}

# commits all the staged changes using MiniMax M2.5-highspeed model in OpenCode
commit:
    @echo
    @echo -e "Before committing we must make sure all doctests pass"
    @echo
    @cd .. && just doctest $(sniff repo --dirty-package-areas 2>/dev/null) || ( just _speak "We have failing doc tests which must be fixed before we can commit!" && echo "We have failing doc tests which must be fixed before we can commit!" && exit 1 )
    @echo ""
    @echo -e "Committing staged changes in the {{BOLD}}Rusty Biscuit{{RESET}} monorepo to git"
    @echo -e "{{DIM}}{{ITALIC}}- using the {{RESET}}{{ITALIC}}${MODEL:-${COMMIT_MODEL:-minimax/MiniMax-M2.5-highspeed}} {{DIM}}model{{RESET}}"
    @echo ""
    @claudine opencode -n "evaluate all the staged commits in the repo and then group them by scope (e.g., $(sniff repo --packages)) and operation (e.g., fix, docs, chore, feat, refactor, style, perf, test, ci) and then commit each group separately using the conventional commit naming conventions with a well thought out commit message (DO NOT COMMIT ALL STAGED FILES as a SINGLE COMMIT unless they are all part of the same conventional commit group). Note: there are two cases where it's ok to have no 'scope' (aka, package) associated to a commit message:\n1. If the change appears to have no relationship to any particular package in the monorepo.\n2. If there are bunch of small changes which are all related to the same underlying event or cause and the changes do not touch any source code then it's possible to group them all into one commit which has no scope specified. Note: the action 'refactor' should be reserved for commits which have at least some source code files.\nIf no files are staged for commit then communicate this to the user and exit. Note: make sure NOT to commit everything as one commit. You are committing files in groups. IMPORTANT: remember that you are running in a non-interactive mode so you can not ask the user questions and expect a reply! DO NOT PUSH COMMITS TO THE ORIGIN."
    @just _speak "git commits completed in rusty-biscuit monorepo"
    @sniff git 2>/dev/null || exit 0

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo -e "Staging all {{BOLD}}modified{{RESET}} or {{BOLD}}untracked{{RESET}} files for the {{PACKAGE}} package area."
    @echo ""
    @git add *
    @echo ""
    @echo "Files have been added"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just -play select-4
    @echo -e "All committed files from {{BOLD}}{{PACKAGE}}{{RESET}} have now been pushed to remote."
    @echo

create-integration name="" prompt="":
    #!/usr/bin/env bash
    if [ -z "{{name}}" ]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} no {{BOLD}}name{{RESET}} provided for the integration!"
        echo
        echo -e "syntax: {{BOLD}}just create-integration{{RESET}} {{DIM}}{{ITALIC}} [name] [prompt]"
        echo
        exit 99
    fi

    if [ -z "{{prompt}}" ]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} no {{BOLD}}prompt{{RESET}} provided for the {{name}} integration! Exiting..."
        echo
        echo -e "syntax: {{BOLD}}just create-integration{{RESET}} {{DIM}}{{ITALIC}} [name] [prompt]"
        echo
        exit 99
    fi

    mkdir -p "./docs/integrations/"
    touch "./docs/integration/{{name}}.md"


# build the 'homelab' skill
skill-homelab:
    @echo
    @echo -e "Refreshing {{BOLD}}Homelab{{RESET}} skill"
    @claudine --yolo -p \'"$(cat docs/skills-homelab.md)"\'

# build the 'unfolded-circle' skill and deploy in this repo as well as User scope
skill-unfolded-circle:
    @echo
    @echo "Publishing skill for {{BOLD}}unfolded-circle{{RESET}} locally to {{BLUE}}repo{{RESET}}"
    @echo
    @mkdir -p "../.claude/skills/unfolded-circle"
    @cp -r ./docs/unfolded-circle ../.claude/skills
    @echo
    @echo -e "Skill published to {{BOLD}}rusty-biscuit{{RESET}} monorepo"
    @echo

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}homelab{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- homelab {{DOCS}} {{args}}
    @_speak "the drift recipe for the homelab package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
