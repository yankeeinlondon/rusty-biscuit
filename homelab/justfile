# build frontend SPA (installs deps if needed)
build-frontend:
    @echo ""
    @echo -e "{{BOLD}}Building Frontend SPA{{RESET}}"
    @cd ./server/frontend && (pnpm install --frozen-lockfile 2>/dev/null || pnpm install) && pnpm build
    @echo ""

# run frontend dev server (Vite on :5173 with proxy to :3000)
dev-frontend:
    @echo ""
    @echo -e "{{BOLD}}Running Frontend Dev Server{{RESET}} ({{ITALIC}}Vite on :5173{{RESET}})"
    @echo ""
    @cd server/frontend && pnpm dev



# lint frontend code with oxlint
lint-frontend:
    @echo ""
    @echo "Linting Frontend"
    @echo ""
    @cd server/frontend && pnpm lint

# run frontend unit tests
test-frontend:
    @echo ""
    @echo "Testing Frontend"
    @echo ""
    @cd ./server/frontend && pnpm test

# typecheck frontend
typecheck-frontend:
    @cd server/frontend && pnpm typecheck

# stages all files in package area and then commits and pushes
cp:
    @echo ""
    @echo -e "Staging all {{BOLD}}modified{{RESET}} or {{BOLD}}untracked{{RESET}} files for the {{PACKAGE}} package area."
    @echo ""
    @git add *
    @echo ""
    @echo "Files have been added"
    @echo ""
    @just commit
    @echo ""
    @git push
    @echo ""
    @just -play select-4
    @echo -e "All committed files from {{BOLD}}{{PACKAGE}}{{RESET}} have now been pushed to remote."
    @echo

create-integration name="" prompt="":
    #!/usr/bin/env bash
    if [ -z "{{name}}" ]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} no {{BOLD}}name{{RESET}} provided for the integration!"
        echo
        echo -e "syntax: {{BOLD}}just create-integration{{RESET}} {{DIM}}{{ITALIC}} [name] [prompt]"
        echo
        exit 99
    fi

    if [ -z "{{prompt}}" ]; then
        echo -e "{{BOLD}}{{RED}}Error:{{RESET}} no {{BOLD}}prompt{{RESET}} provided for the {{name}} integration! Exiting..."
        echo
        echo -e "syntax: {{BOLD}}just create-integration{{RESET}} {{DIM}}{{ITALIC}} [name] [prompt]"
        echo
        exit 99
    fi

    mkdir -p "./docs/integrations/"
    touch "./docs/integration/{{name}}.md"


# build the 'homelab' skill
skill-homelab:
    @echo
    @echo -e "Refreshing {{BOLD}}Homelab{{RESET}} skill"
    @claudine --yolo -p \'"$(cat docs/skills-homelab.md)"\'

# build the 'unfolded-circle' skill and deploy in this repo as well as User scope
skill-unfolded-circle:
    @echo
    @echo "Publishing skill for {{BOLD}}unfolded-circle{{RESET}} locally to {{BLUE}}repo{{RESET}}"
    @echo
    @mkdir -p "../.claude/skills/unfolded-circle"
    @cp -r ./docs/unfolded-circle ../.claude/skills
    @echo
    @echo -e "Skill published to {{BOLD}}rusty-biscuit{{RESET}} monorepo"
    @echo

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @printf "%b\n" "Running drift workflow for {{BOLD}}homelab{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- export PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- homelab {{DOCS}} {{args}}
    @_speak "the drift recipe for the homelab package has completed; documentation and agent skills have been updated and possibly some adjustments to the CLAUDE.md file where appropriate."


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
