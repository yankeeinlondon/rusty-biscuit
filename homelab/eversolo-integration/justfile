set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../../just/lifecycle.just"
import "../../just/plan.just"
import "../../just/review.just"
import "../../just/notify.just"
import "../../just/ai.just"
import "../../just/devops.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

NAME := "eversolo-integration"
PKG_DIR := justfile_directory()


default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    echo "{{NAME}}"
    echo "====================="

    echo ""
    just --list | grep -v 'default'
    echo

# builds the integration for the host platform
install:
    #!/usr/bin/env bash
    set -euo pipefail

    pkg_dir="{{PKG_DIR}}"
    repo_root="$(cd "$pkg_dir/../.." && pwd)"

    echo
    echo "Ensuring Build Tools are in Place"
    (cd "$repo_root" && just _ensure-build-deps)
    echo
    echo "Installing the Binary"
    echo
    cargo install --path "$pkg_dir" || exit 1
    echo
    echo -e "✅ {{BOLD}}{{NAME}}{{RESET}} was built successfully"

# build a Docker image for the integration
build-image:
    #!/usr/bin/env bash
    set -euo pipefail

    pkg_dir="{{PKG_DIR}}"
    repo_root="$(cd "$pkg_dir/../.." && pwd)"

    echo
    echo "Building Docker image for {{NAME}}"
    echo
    docker build -f "$pkg_dir/Dockerfile" -t "{{NAME}}" "$repo_root"
    echo
    echo -e "✅ {{BOLD}}{{NAME}}{{RESET}} Docker image was built successfully"

# run tests against a REAL device
sanity-test:
    #!/usr/bin/env bash
    set -euo pipefail

    pkg_dir="{{PKG_DIR}}"
    repo_root="$(cd "$pkg_dir/../.." && pwd)"

    echo
    echo "Running real-device sanity tests for {{NAME}}"
    echo "Required env vars: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT]"
    echo
    cd "$repo_root"
    cargo test -p "{{NAME}}" real_device -- --ignored --nocapture

# run tests against a REAL device and mutate state (intended outcome is to exit in same state as entered)
sanity-test-mutate:
    #!/usr/bin/env bash
    set -euo pipefail

    pkg_dir="{{PKG_DIR}}"
    repo_root="$(cd "$pkg_dir/../.." && pwd)"

    echo
    echo "Running destructive real-device sanity tests for {{NAME}}"
    echo "Required env vars: EVERSOLO_REAL_HOST [EVERSOLO_REAL_PORT] EVERSOLO_REAL_ALLOW_DESTRUCTIVE=1"
    echo
    cd "$repo_root"
    cargo test -p "{{NAME}}" destructive_real_device -- --ignored --nocapture

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{DIM}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
