set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
ITALIC := '\033[3m'
DIM := '\033[2m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Model Citizen"
        echo "============="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build model-citizen packages (lib, cli)
build *args="":
    @echo ""
    @echo "Build Model Citizen"
    @echo "--------------------"
    @echo ""
    @cargo build -p model-citizen -p model-citizen-cli {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "model-citizen model-citizen-cli"

# Test both library and CLI.
test *args="":
    @just _test_all "model-citizen model-citizen-cli" {{args}}

# not applicable: model-citizen has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for model-citizen"

# not applicable: model-citizen has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for model-citizen"

# not applicable: model-citizen does not emit HTML
test-browser:
    @echo "test-browser: not applicable for model-citizen"

# Real-resource tests (local Ollama / LM Studio / HF). Skip-clean when absent.
test-real *args="":
    @just _test_real model-citizen {{args}}
    @just _test_real model-citizen-cli {{args}}

# Lint both the library and CLI
lint:
    @just _lint model-citizen
    @just _lint model-citizen-cli

# not applicable: no criterion benches (work is I/O-bound)
bench:
    @echo "bench: not applicable for model-citizen"

# Per-package LCOV coverage.
coverage *args="":
    @just _coverage model-citizen {{args}}
    @just _coverage model-citizen-cli {{args}}

# Doctests.
doctest *args="":
    @just _doctest model-citizen {{args}}
    @just _doctest model-citizen-cli {{args}}

# not applicable: no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for model-citizen"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint model-citizen || just _fix_lint model-citizen
    @just _lint model-citizen-cli || just _fix_lint model-citizen-cli

install *args="":
    @just build --release
    @just _install "./cli" "Model Citizen" {{args}}


check:
    @echo ""
    @echo "Checking Model Citizen"
    @echo ""
    @cargo check -p model-citizen -p model-citizen-cli

# Outdated packages
outdated:
    @cargo outdated --root-deps-only

readme:
    _readme_files claudine


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
