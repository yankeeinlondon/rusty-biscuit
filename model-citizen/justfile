set dotenv-load
set positional-arguments

BOLD := '\033[1m'
ITALIC := '\033[3m'
RESET := '\033[0m'
YELLOW2 := '\033[38;5;3m'
BLACK := '\033[30m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
WHITE := '\033[37m'
DOCS := ""

default:
    #!/usr/bin/env bash
    set -euo pipefail

    echo
    if command -v md &> /dev/null; then
        md just.md
    else
        echo "Model Citizen"
        echo "============="
    fi

    echo ""
    just --list | grep -v 'default'
    echo

# build model-citizen packages (lib, cli)
build *args="":
    @echo ""
    @echo "Build Model Citizen"
    @echo "--------------------"
    @echo ""
    @cargo build -p model-citizen -p model-citizen-cli {{args}}

# run tests for model-citizen packages
test *args="":
    @echo ""
    @echo "Testing Model Citizen"
    @echo "---------------------"
    @echo ""
    @cargo test -p model-citizen -p model-citizen-cli {{args}}

# run clippy on model-citizen packages
lint:
    @echo ""
    @echo "Linting Model Citizen"
    @echo "---------------------"
    @echo ""
    @cargo clippy -p model-citizen -- -D warnings
    @cargo clippy -p model-citizen-cli -- -D warnings

install:
    @echo ""
    @echo "{{BOLD}}Building Model Citizen Library{{RESET}}"
    @cargo build -p model-citizen --release
    @echo ""
    @echo "{{BOLD}}{{YELLOW}}Installing Model Citizen CLI{{RESET}}"
    @cargo install --path ./cli
    @echo ""
    @echo "{{BOLD}}{{BLUE}}Model Citizen CLI installed{{RESET}}"
    @echo ""

check:
    @echo ""
    @echo "Checking Model Citizen"
    @echo ""
    @cargo check -p model-citizen -p model-citizen-cli

# Open Opencode
oc *args="":
    @clear
    @echo "Loading {{BOLD}}Opencode{{RESET}}"
    @cd .. && echo "Loading {{BOLD}}Opencode{{RESET}}" && opencode {{args}}

# Open Claude Code in yolo mode
cc *args="":
    @clear
    @echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})"
    @cd .. && echo "Loading {{BOLD}}Claude Code{{RESET}} ({{ITALIC}}in yolo mode{{RESET}})" && claude --dangerously-skip-permissions {{args}}

# Use GPT 5.2 to commit staged changes
commit:
    @echo "Using Opencode with {{BOLD}}gpt-5.2-codex{{RESET}} to {{BOLD}}commit{{RESET}} staged changes"
    @echo
    @cd .. && opencode run "/commit -f ; remember you must use 'conventional commits' naming conventions and that unless all staged files are strongly related to the same thing be sure to make multiple commits by package or related activity." --model "openai/gpt-5.2-codex"
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "git commits completed in rusty-biscuit monorepo"; \
    fi

# adds/updates the "skill" for this package
refresh-skill:
    @clear
    @echo "Refreshing {{BOLD}}model-citizen{{RESET}} skill"
    @unset ANTHROPIC_API_KEY && cd .. && claude --dangerously-skip-permissions --model opus -p \'"$(cat docs/skills-model-citizen.md)"\'
    @if command -v so-you-say >/dev/null 2>&1; then \
        so-you-say "the skill for the package model-citizen has been updated"; \
    fi

# fix documentation drift, refresh the skill, and review CLAUDE.md
drift *args="":
    @echo
    @echo -e "Running drift workflow for {{BOLD}}model-citizen{{RESET}} via Rust drift script"
    @echo
    @echo "- step 1: update package docs for code drift"
    @echo "- step 2: refresh package skill from updated docs"
    @echo "- step 3: review CLAUDE.md for needed updates"
    @echo "- set PREFER_AGENT=codex to force codex (default is claude)"
    @echo
    @cargo run --manifest-path ../scripts/Cargo.toml --bin drift -- model-citizen {{DOCS}} {{args}}


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{YELLOW2}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} >/dev/null || true
