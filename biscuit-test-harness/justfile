set dotenv-load
set positional-arguments

# set allow-duplicate-recipes

# `env CYG_SYS_BASHRC=1` guards against Cygwin's /etc/bash.bashrc tripping `-u`;
# see the root justfile for the full explanation.
set shell := ["env", "CYG_SYS_BASHRC=1", "bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'
GREEN := '\033[32m'
YELLOW := '\033[33m'
BLUE := '\033[34m'
MAGENTA := '\033[35m'
CYAN := '\033[36m'
PACKAGE := "Biscuit Test Harness"
LIBRARY := "biscuit-test-harness"

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null && [ -f just.md ]; then
        md just.md
    else
        echo
        echo -e "{{ BOLD }}{{ PACKAGE }}{{ RESET }} (real-terminal harness library)"
        echo "======================================================================================"
        echo
    fi

    just --list | grep -v 'default'
    echo

# build the library and the `biscuit-harness-broker` binary
build *args="":
    @just _build {{ LIBRARY }} "Biscuit Test Harness" {{ args }}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 2) -------

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity {{ LIBRARY }}

# Level-1 tests for the library.
test *args="":
    @just _test {{ LIBRARY }} {{ args }}

# not applicable: this crate *provides* the Level-2 harness; its own tests
# exercise backend selection and teardown in-process and carry no `level2_`
# prefix. The consumer areas own the real-terminal tier.
test-l2:
    @echo "test-l2: not applicable for biscuit-test-harness"

# not applicable: biscuit-test-harness has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-test-harness"

# not applicable: biscuit-test-harness emits no HTML
test-browser:
    @echo "test-browser: not applicable for biscuit-test-harness"

# not applicable: biscuit-test-harness has no real-resource tier
test-real:
    @echo "test-real: not applicable for biscuit-test-harness"

# Clippy + fmt check for the library.
lint:
    @just _lint {{ LIBRARY }}

# not applicable: biscuit-test-harness has no criterion benches
bench:
    @echo "bench: not applicable for biscuit-test-harness"

# Per-package LCOV coverage for the library.
coverage *args="":
    @just _coverage {{ LIBRARY }} {{ args }}

# Doctests for the library.
doctest *args="":
    @just _doctest {{ LIBRARY }} {{ args }}

# not applicable: biscuit-test-harness has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for biscuit-test-harness"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) the library
lint-fix:
    @just _lint {{ LIBRARY }} || just _fix_lint {{ LIBRARY }}

# Validate the source code without doing a full build
check:
    @cargo check -p {{ LIBRARY }}

# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{ BOLD }} {{ ITALIC }} {{ RESET }} {{ RED }} {{ DIM }} {{ YELLOW }} {{ BLUE }} {{ MAGENTA }} {{ CYAN }} {{ GREEN }} >/dev/null || true
