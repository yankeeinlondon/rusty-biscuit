set dotenv-load
set positional-arguments
# set allow-duplicate-recipes
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

import "../just/lifecycle.just"
import "../just/plan.just"
import "../just/review.just"
import "../just/notify.just"
import "../just/ai.just"
import "../just/devops.just"

BOLD := '\033[1m'
DIM := '\033[2m'
ITALIC := '\033[3m'
RESET := '\033[0m'
RED := '\033[31m'

default:
    #!/usr/bin/env bash
    set -euo pipefail

    if command -v md &> /dev/null; then
        md just.md
    fi
    echo "biscuit-hash Library & CLI"
    echo "=========================="
    echo
    just --list | grep -v 'default'

# build library and CLI
build *args="":
    @just _build biscuit-hash "Biscuit Hash Library" {{args}}
    @just _build biscuit-hash-cli "Biscuit Hash CLI" {{args}}

# --- Canonical lifecycle recipe set (testing-best-practices Phase 3) -------

# `--all-features` on the library throughout: `default = ["xx_hash"]`, so the
# `blake3` and `argon2id` algorithms — and the 20 tests that cover them — are
# invisible to a default-feature run (26 of 46). Nobody ships the default set:
# biscuit-hash-cli enables all three, claudine/tree-hugger/rendezvous-core
# enable `blake3`. Same reasoning as biscuit-visualized's `--all-features`.
# The CLI has no features of its own, so it takes no flag.

# Fast confidence subset (≤15s, lib + bin, !slow). Doctests live in `doctest`.
sanity:
    @just _sanity_all "biscuit-hash --all-features; biscuit-hash-cli"

# test library and CLI
test *args="":
    @just _test_all "biscuit-hash --all-features; biscuit-hash-cli" {{args}}

# not applicable: biscuit-hash has no real-terminal (Level-2) tests
test-l2:
    @echo "test-l2: not applicable for biscuit-hash"

# not applicable: biscuit-hash has no OS-keyboard-injection (Level-3) tests
test-l3:
    @echo "test-l3: not applicable for biscuit-hash"

# not applicable: biscuit-hash emits hashes, not HTML
test-browser:
    @echo "test-browser: not applicable for biscuit-hash"

# not applicable: biscuit-hash has no real-resource tier
test-real:
    @echo "test-real: not applicable for biscuit-hash"

# Lint both the library and CLI
lint:
    @just _lint biscuit-hash
    @just _lint biscuit-hash-cli

# Criterion benches for biscuit-hash hashing algorithms.
bench *args="":
    @just _bench biscuit-hash {{ args }}

# Per-package LCOV coverage for the library and CLI.
coverage *args="":
    @just _coverage biscuit-hash --all-features {{args}}
    @just _coverage biscuit-hash-cli {{args}}

# Doctests for the library and CLI.
doctest *args="":
    @just _doctest biscuit-hash --all-features {{args}}
    @just _doctest biscuit-hash-cli {{args}}

# not applicable: biscuit-hash has no cargo-fuzz targets
fuzz:
    @echo "fuzz: not applicable for biscuit-hash"

# Canonical PR-gate runner: sanity → lint → doctest → test → test-l2 → test-browser.
all:
    @just sanity
    @just lint
    @just doctest
    @just test
    @just test-l2
    @just test-browser

# ----------------------------------------------------------------------------

# Lint (and fix) both the library and CLI
lint-fix:
    @just _lint biscuit-hash || just _fix_lint biscuit-hash
    @just _lint biscuit-hash-cli || just _fix_lint biscuit-hash-cli


# install CLI binary
install *args="":
    @just build --release
    @just _install "./cli" "Biscuit Hash" {{args}}

# build and show the docs for the library code
docs:
    @echo "Build and then show latest docs for the biscuit-hash library code"
    @echo ""
    @cargo doc -p biscuit-hash --open

# run CLI in development mode
cli *args="":
    @cargo run -p biscuit-hash-cli -- {{args}}


# No-op recipe: reference color vars so linters won't report them as unused.
# Run `just _colors` if you want to exercise this (it does nothing).
_colors:
    @: {{BOLD}} {{ITALIC}} {{RESET}} {{BLACK}} {{RED}} {{GREEN}} {{YELLOW}} {{BLUE}} {{MAGENTA}} {{CYAN}} {{WHITE}} {{DIM}} >/dev/null || true
